/**app.wxss**/
page {
  --bg: #f7f5f0;
  --surface: #ffffff;
  --surface-2: #f0ede6;
  --line: #e8e4da;
  --line-strong: #d4cfc2;
  --ink: #22302c;
  --ink-2: #59645f;
  --ink-3: #7b837e;
  --on-fill: #ffffff;
  --accent: #14645a;
  --accent-soft: #e3f1ed;
  --accent-line: #b5d9d0;
  --warn: #8f5f0c;
  --warn-fill: #b5780f;
  --warn-soft: #fdf3df;
  --warn-line: #f2dfb4;
  --danger: #b0432f;
  --danger-soft: #fbece7;
  --danger-line: #f2cdc3;
  --info: #3d5a9e;
  --info-soft: #ebeffa;
  --info-line: #ccd6ef;

  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  color: var(--ink);
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
}

.card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.primary-btn,
.ghost-btn {
  box-sizing: border-box;
  display: flex;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-btn {
  color: var(--on-fill);
  background: var(--accent);
}

.ghost-btn {
  border: 1rpx solid var(--line-strong);
  color: var(--accent);
  background: var(--surface);
}

.muted {
  color: var(--ink-3);
}

.ui-pressed {
  opacity: 0.6;
}

.ui-section {
  margin: 40rpx 0 16rpx 4rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 600;
}

.ui-group {
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.ui-row {
  display: flex;
  min-height: 96rpx;
  box-sizing: border-box;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid var(--line);
}

.ui-row:first-child {
  border-top: 0;
}

.ui-row-main {
  min-width: 0;
  flex: 1;
}

.ui-row-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 500;
}

.ui-row-note {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.ui-row-value {
  flex-shrink: 0;
  color: var(--ink-2);
  font-size: 26rpx;
}

.ui-chevron {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--line-strong);
  border-right: 3rpx solid var(--line-strong);
  transform: rotate(45deg);
}

.ui-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
  font-weight: 500;
}

.ui-chip-accent {
  color: var(--accent);
  background: var(--accent-soft);
}

.ui-chip-warn {
  color: var(--warn);
  background: var(--warn-soft);
}

.ui-chip-danger {
  color: var(--danger);
  background: var(--danger-soft);
}

.ui-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  gap: 8rpx;
  margin: 0 -32rpx 24rpx;
  padding: 12rpx 32rpx;
  background: var(--bg);
}

.ui-tab {
  min-width: 0;
  flex: 1;
  padding: 14rpx 4rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.ui-tab-active {
  color: var(--on-fill);
  background: var(--accent);
}

.ui-bar {
  position: relative;
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--surface-2);
}

.ui-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
  transition: width 0.25s ease;
}
