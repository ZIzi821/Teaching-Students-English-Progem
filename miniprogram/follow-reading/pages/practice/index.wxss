.practice-page { min-height: 100vh; background: var(--accent-soft), var(--surface-2); }
.hero { margin: 12rpx 6rpx 26rpx; }
.eyebrow { color: var(--accent); font-size: 22rpx; font-weight: 600;  }
.hero-title { margin-top: 8rpx; color: var(--accent); font-size: 52rpx; font-weight: 600; }
.hero-subtitle { margin-top: 9rpx; color: var(--ink-2); font-size: 22rpx; }
.instruction-card { padding: 30rpx; }
.mode-pill { display: inline-block; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--accent); background: var(--accent-soft); font-size: 22rpx; font-weight: 600; }
.instruction-title { margin-top: 14rpx; color: var(--ink); font-size: 32rpx; font-weight: 600; }
.rule-row { display: flex; gap: 15rpx; margin-top: 19rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.6; }
.rule-row text { display: flex; width: 40rpx; height: 40rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--accent); font-size: 22rpx; font-weight: 600; }
.supplement, .preload-state { margin-top: 20rpx; padding: 15rpx 17rpx; border-radius: 12rpx; color: var(--ink-2); background: var(--warn-soft); font-size: 22rpx; line-height: 1.55; }
.preload-state { color: var(--ink-2); background: var(--line); }
.preload-ready { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
.preload-failed { color: var(--danger); background: var(--danger-soft); }
.preload-track, .progress-track { height: 11rpx; margin-top: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--line); }
.preload-fill, .progress-fill { height: 100%; background: var(--accent); transition: width .25s ease; }
.start-action { margin-top: 25rpx; }
.attempt-note { color: var(--ink-2); font-size: 22rpx; font-weight: 600; text-align: center; }
.center-card, .error-card, .success-card { margin-top: 76rpx; padding: 38rpx 30rpx; text-align: center; }
.loading-ring { width: 72rpx; height: 72rpx; margin: 8rpx auto 24rpx; border: 8rpx solid var(--accent-line); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
.small-ring { width: 52rpx; height: 52rpx; border-width: 6rpx; }
.state-title, .live-title { color: var(--accent); font-size: 32rpx; font-weight: 600; }
.state-copy { margin-top: 12rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.6; }
.error-mark, .success-mark { display: flex; width: 100rpx; height: 100rpx; margin: 8rpx auto 24rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--danger); font-size: 52rpx; font-weight: 600; }
.success-mark { background: var(--accent); }
.small-error { width: 76rpx; height: 76rpx; font-size: 40rpx; }
.error-action { margin-top: 26rpx; }
.progress-head { display: flex; align-items: flex-start; justify-content: space-between; margin: 6rpx 4rpx 12rpx; }
.position-title { margin-top: 7rpx; color: var(--accent); font-size: 32rpx; font-weight: 600; }
.position-pill { padding: 8rpx 13rpx; border-radius: 999rpx; color: var(--accent); background: var(--accent-soft); font-size: 22rpx; font-weight: 600; }
.progress-track { margin: 0 0 22rpx; }
.text-card { padding: 28rpx; border-color: var(--accent-line); background: var(--accent-soft); text-align: center; }
.text-label { color: var(--accent); font-size: 22rpx; font-weight: 600; }
.item-text { margin-top: 15rpx; color: var(--accent); font-size: 40rpx; font-weight: 600; line-height: 1.65; word-break: break-word; }
.live-card { min-height: 410rpx; padding: 36rpx 30rpx; text-align: center; }
.speaker-icon { display: flex; width: 92rpx; height: 92rpx; margin: 12rpx auto 24rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--accent); font-size: 32rpx; }
.live-action { margin-top: 28rpx; }
.speaker-rings { display: flex; width: 124rpx; height: 124rpx; margin: 14rpx auto 28rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--accent-soft); animation: pulse 1.25s ease-out infinite; }
.speaker-core { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--accent); font-size: 32rpx; }
.microphone-rings .speaker-core { background: var(--danger); }
.countdown-label { color: var(--accent); font-size: 24rpx; font-weight: 600; }
.countdown-number { margin: 18rpx 0 8rpx; color: var(--accent); font-size: 126rpx; font-weight: 600; line-height: 1; }
.recording-dot { width: 58rpx; height: 58rpx; margin: 10rpx auto 22rpx; border-radius: 50%; background: var(--danger);  animation: breathe 1s ease-in-out infinite; }
.recording-title { color: var(--danger); }
.timer { margin-top: 10rpx; color: var(--danger); font-size: 52rpx; font-weight: 600; }
.finish-action { display: flex; min-height: 82rpx; margin-top: 28rpx; align-items: center; justify-content: center; border-radius: 16rpx; color: var(--on-fill); background: var(--danger); font-size: 28rpx; font-weight: 600; }
.late-pill { display: inline-block; margin-top: 18rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--danger); background: var(--danger-soft); font-size: 22rpx; font-weight: 600; }
.success-actions { display: flex; gap: 14rpx; margin-top: 30rpx; }
.success-action { min-width: 0; flex: 1; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { 0% {  } 100% {  } }
@keyframes breathe { 0%,100% { transform: scale(.92); } 50% { transform: scale(1.08); } }
