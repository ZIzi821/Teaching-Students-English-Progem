<view class="page practice-page">
  <teacher-preview-banner wx:if="{{isTeacherPreview}}"></teacher-preview-banner>

  <view class="card center-card" wx:if="{{state === 'loading'}}">
    <view class="loading-ring"></view>
    <view class="state-title">正在读取跟读任务…</view>
  </view>

  <view class="card error-card" wx:elif="{{state === 'error'}}">
    <view class="error-mark">!</view>
    <view class="state-title">请重新加载跟读练习</view>
    <view class="state-copy">{{message}}</view>
    <view class="primary-btn error-action" bindtap="loadPractice">重新加载</view>
  </view>

  <block wx:elif="{{state === 'instructions'}}">
    <view class="hero">
      <view class="eyebrow">听 · 准备 · 跟读</view>
      <view class="hero-title">先听老师，再自己读</view>
      <view class="hero-subtitle">{{lesson.title}} · 第 {{lesson.lessonNo || '—'}} 节</view>
    </view>
    <view class="card instruction-card">
      <view class="mode-pill">{{task.mode === 'automatic' ? '自动连续跟读' : '手动逐条播放'}}</view>
      <view class="instruction-title">本轮共 {{totalCount}} 条</view>
      <view class="rule-row"><text>1</text><view>{{task.mode === 'automatic' ? '点击开始后，老师的示范音会按顺序自动播放。' : '每一条由你点击“播放老师示范”。'}}</view></view>
      <view class="rule-row"><text>2</text><view>示范音结束后有 {{task.gapSeconds}} 秒准备时间，麦克风随后自动打开并开始录音。</view></view>
      <view class="rule-row"><text>3</text><view>每条最长录制 {{task.responseSeconds}} 秒；读完可提前结束，系统会继续下一条。</view></view>
      <view class="supplement" wx:if="{{lesson.recordingPrompt}}">老师补充：{{lesson.recordingPrompt}}</view>
      <view class="preload-state preload-{{preloadState}}">{{preloadLabel}}</view>
      <view class="preload-track"><view class="preload-fill" style="width: {{preloadTotal ? preloadDone / preloadTotal * 100 : 0}}%;"></view></view>
      <view class="primary-btn start-action" bindtap="beginPractice">{{isTeacherPreview ? '开始预览跟读流程' : '开始跟读'}}</view>
    </view>
    <view class="attempt-note" wx:if="{{previousAttemptCount}}">这项任务已经完成过 {{previousAttemptCount}} 轮</view>
  </block>

  <view class="card center-card" wx:elif="{{state === 'preparing'}}">
    <view class="loading-ring"></view>
    <view class="state-title">正在准备示范音频与麦克风</view>
    <view class="state-copy">准备完成后会进入第 1 条</view>
  </view>

  <block wx:elif="{{state === 'awaiting_play' || state === 'playing' || state === 'countdown' || state === 'starting' || state === 'recording' || state === 'stopping' || state === 'between' || state === 'audio_retry' || state === 'item_retry'}}">
    <view class="progress-head">
      <view><view class="eyebrow">跟读</view><view class="position-title">第 {{currentIndex + 1}} 条</view></view>
      <view class="position-pill">{{positionLabel}}</view>
    </view>
    <view class="progress-track"><view class="progress-fill" style="width: {{progressPercent}}%;"></view></view>

    <view class="card text-card">
      <view class="text-label">请跟读</view>
      <view class="item-text">{{currentItem.text}}</view>
    </view>

    <view class="card live-card">
      <block wx:if="{{state === 'awaiting_play'}}">
        <view class="speaker-icon">▶</view>
        <view class="live-title">准备好后播放老师示范</view>
        <view class="state-copy">播放结束后会自动倒计时并录音</view>
        <view class="primary-btn live-action" bindtap="playCurrentDemo">播放老师示范</view>
      </block>
      <block wx:elif="{{state === 'playing'}}">
        <view class="speaker-rings"><view class="speaker-core">▶</view></view>
        <view class="live-title">正在播放老师示范</view>
        <view class="state-copy">仔细听发音、重音和停顿</view>
      </block>
      <block wx:elif="{{state === 'countdown'}}">
        <view class="countdown-label">准备一下</view>
        <view class="countdown-number">{{countdown}}</view>
        <view class="state-copy">倒计时结束后自动录音</view>
      </block>
      <block wx:elif="{{state === 'starting'}}">
        <view class="speaker-rings microphone-rings"><view class="speaker-core">●</view></view>
        <view class="live-title">正在打开麦克风</view>
      </block>
      <block wx:elif="{{state === 'recording'}}">
        <view class="recording-dot"></view>
        <view class="live-title recording-title">现在请跟读</view>
        <view class="timer">{{elapsedLabel}}</view>
        <view class="state-copy">最长还剩 {{remainingLabel}}</view>
        <view class="finish-action" bindtap="finishCurrentResponse">我读完了</view>
      </block>
      <block wx:elif="{{state === 'stopping' || state === 'between'}}">
        <view class="loading-ring small-ring"></view>
        <view class="live-title">{{state === 'stopping' ? '正在保存这一条' : '这一条已完成'}}</view>
        <view class="state-copy">{{completedCount}} / {{totalCount}}</view>
      </block>
      <block wx:else>
        <view class="error-mark small-error">!</view>
        <view class="live-title">这一条需要重试</view>
        <view class="state-copy">{{message}}</view>
        <view class="primary-btn live-action" bindtap="retryCurrentItem">重新播放示范</view>
      </block>
    </view>
  </block>

  <view class="card center-card" wx:elif="{{state === 'uploading'}}">
    <view class="loading-ring"></view>
    <view class="state-title">正在提交本轮跟读</view>
    <view class="state-copy">{{uploadDone}} / {{uploadTotal}} 条</view>
    <view class="state-copy">全部提交成功后，老师才能逐条回听。</view>
  </view>

  <view class="card error-card" wx:elif="{{state === 'upload_error'}}">
    <view class="error-mark">!</view>
    <view class="state-title">录音还没有全部提交成功</view>
    <view class="state-copy">{{message}}。本页仍保留录音，请检查网络后重试。</view>
    <view class="primary-btn error-action" bindtap="retryUpload">重新提交</view>
  </view>

  <view class="card success-card" wx:elif="{{state === 'success'}}">
    <view class="success-mark">✓</view>
    <view class="state-title">{{previewComplete ? '跟读流程预览完成' : '本轮跟读已提交'}}</view>
    <view class="state-copy" wx:if="{{previewComplete}}">教师预览已完成，学生的完成记录保持原状态。</view>
    <view class="state-copy" wx:else>第 {{submittedAttemptNo}} 轮 · 共 {{totalCount}} 条录音 · 等待老师逐条检查</view>
    <view class="late-pill" wx:if="{{submittedLate}}">逾期提交</view>
    <view class="success-actions">
      <view class="ghost-btn success-action" bindtap="resetPractice">再练一轮</view>
      <view class="primary-btn success-action" bindtap="goBack">返回课程</view>
    </view>
  </view>
</view>
