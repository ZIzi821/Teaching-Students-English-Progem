<view class="page">
  <view class="card no-permission" wx:if="{{message}}">
    <view>{{message}}</view>
  </view>

  <view wx:if="{{lesson}}">
  <view class="preview-tip" wx:if="{{isTeacherPreview}}">学生视角预览：已隐藏上传资料和添加错题等老师操作。</view>

  <view class="card lesson-head">
    <view class="subject">{{lesson.subject}}</view>
    <view class="title">{{lesson.title}}</view>
    <view class="date">{{lesson.lessonDate}}<text wx:if="{{lesson.lessonNo}}"> · 第 {{lesson.lessonNo}} 节</text></view>
    <view class="summary">{{lesson.summary}}</view>
  </view>

  <view class="primary-btn add-btn" wx:if="{{isTeacher}}" bindtap="goAddMistake">添加本节英语错题</view>

  <view class="card upload-card" wx:if="{{isTeacher}}">
    <view class="upload-title">上传课程资料</view>
    <picker mode="selector" range="{{materialTypes}}" range-key="label" value="{{materialTypeIndex}}" bindchange="onMaterialTypeChange">
      <view class="picker-value">{{selectedMaterialTypeLabel}}</view>
    </picker>
    <view class="ghost-btn upload-btn" bindtap="uploadMaterial">选择并上传</view>
  </view>

  <view class="section-title">本节课资料</view>
  <view class="empty" wx:if="{{!hasPaperArea}}">暂未上传试卷、图片、音频或白板截图。</view>
  <view class="card paper-card" wx:for="{{papers}}" wx:key="_id" bindtap="openMaterial" data-index="{{index}}">
    <view class="paper-title">{{item.displayTitle}}</view>
    <view class="paper-meta">{{item.displayType}} · {{item.fileName}}</view>
  </view>

  <view class="section-title">英语错题列表</view>
  <view class="empty" wx:if="{{!mistakes.length}}">本节课还没有英语错题。</view>
  <view class="card mistake-card" wx:for="{{mistakes}}" wx:key="_id" bindtap="goMistake" data-id="{{item._id}}">
    <view class="mistake-top">
      <view class="mistake-title">{{item.displayTitle}}</view>
      <view class="status">{{item.status}}</view>
    </view>
    <view class="reason">{{item.reason}}</view>
    <view class="tags">
      <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>
  </view>
</view>
