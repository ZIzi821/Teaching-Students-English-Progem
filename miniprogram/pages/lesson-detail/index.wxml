<view class="page" wx:if="{{lesson}}">
  <view class="card lesson-head">
    <view class="subject">{{lesson.subject}}</view>
    <view class="title">{{lesson.title}}</view>
    <view class="date">{{lesson.lessonDate}}</view>
    <view class="summary">{{lesson.summary}}</view>
    <view class="sample-tip" wx:if="{{isSample}}">示例课程记录</view>
  </view>

  <view class="primary-btn add-btn" bindtap="goAddMistake">添加本节错题</view>

  <view class="section-title">试卷 / 练习</view>
  <view class="empty" wx:if="{{!hasPaperArea}}">暂未上传试卷或练习文件。</view>
  <view class="card paper-card" wx:for="{{papers}}" wx:key="_id">
    <view class="paper-title">{{item.title}}</view>
    <view class="paper-meta">{{item.type}} · 文件 {{item.fileCount}} 个</view>
  </view>

  <view class="section-title">错题列表</view>
  <view class="empty" wx:if="{{!mistakes.length}}">本节课还没有错题。</view>
  <view class="card mistake-card" wx:for="{{mistakes}}" wx:key="_id" bindtap="goMistake" data-id="{{item._id}}">
    <view class="mistake-top">
      <view class="mistake-title">{{item.displayTitle}}</view>
      <view class="status">{{item.status}}</view>
    </view>
    <view class="reason">{{item.reason}}</view>
    <view class="tags">
      <text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>
</view>
