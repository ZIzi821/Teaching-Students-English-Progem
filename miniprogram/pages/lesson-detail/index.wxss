.lesson-page {
  padding-top: 24rpx;
}

.lesson-head {
  padding: 32rpx;
  border-color: #d9e8df;
  background: linear-gradient(145deg, #edf7f2 0%, #fffdfa 100%);
}

.head-row,
.section-head,
.recording-setting,
.observation-editor-head,
.observation-editor-top,
.submission-main,
.paper-card,
.mistake-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.subject,
.section-kicker {
  color: #4f8f73;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.lesson-badge,
.submission-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6e5b43;
  background: #f2e6d4;
  font-size: 21rpx;
  font-weight: 700;
}

.template-badge {
  display: inline-block;
  margin-top: 8rpx;
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #e2f0e9;
  font-size: 19rpx;
  font-weight: 700;
}

.template-editor-hint {
  color: #39765d;
}

.title {
  margin-top: 14rpx;
  color: #243f35;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
}

.date {
  margin-top: 10rpx;
  color: #817669;
  font-size: 24rpx;
}

.preview-tip {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #4f6f63;
  background: #e2f0e9;
  font-size: 23rpx;
  line-height: 1.5;
}

.institution-course-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #74644f;
  background: #f7eedf;
  font-size: 21rpx;
  line-height: 1.45;
}

.institution-course-banner text {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: #76562f;
  background: #ead3ad;
  font-weight: 800;
}

.section-head {
  align-items: flex-end;
  margin: 36rpx 0 18rpx;
}

.section-title {
  margin-top: 5rpx;
  color: #2f2a24;
  font-size: 32rpx;
  font-weight: 800;
}

.section-hint {
  max-width: 540rpx;
  margin-top: 7rpx;
  color: #817669;
  font-size: 22rpx;
  line-height: 1.5;
}

.small-action,
.advanced-toggle,
.add-observation {
  flex-shrink: 0;
  color: #3f7b63;
  font-size: 23rpx;
  font-weight: 700;
}

.record-card {
  padding: 24rpx 28rpx;
}

.record-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee5d9;
}

.record-item:last-child {
  border-bottom: 0;
}

.record-label,
.label,
.upload-step,
.recording-task-title,
.submission-title,
.material-group-title {
  color: #655b50;
  font-size: 24rpx;
  font-weight: 700;
}

.record-value,
.homework-text {
  margin-top: 9rpx;
  color: #342f29;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.homework-copy {
  padding: 22rpx;
  border: 1rpx solid #eadfcf;
  border-radius: 16rpx;
  background: #fffdfa;
}

.homework-copy-label,
.recording-prompt-label {
  color: #4c806b;
  font-size: 23rpx;
  font-weight: 800;
}

.homework-copy .homework-text {
  margin-top: 12rpx;
  color: #302b26;
  font-size: 32rpx;
  line-height: 1.75;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.empty-record,
.submission-empty,
.empty {
  padding: 26rpx 12rpx;
  color: #817669;
  text-align: center;
}

.empty-record-title {
  color: #5d544b;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-record-hint {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.observation-list {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee5d9;
}

.lesson-focus-summary {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #e9f4ee;
  font-size: 21rpx;
  font-weight: 700;
}

.lesson-focus-summary text {
  color: #6f8178;
  font-weight: 500;
}

.observation-title {
  margin-bottom: 10rpx;
}

.observation-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
}

.observation-main,
.paper-main {
  min-width: 0;
  flex: 1;
}

.observation-content {
  color: #3b352f;
  font-size: 25rpx;
  line-height: 1.5;
}

.observation-skill {
  margin-bottom: 5rpx;
  color: #39765d;
  font-size: 20rpx;
  font-weight: 700;
}

.observation-evidence-meta {
  margin-top: 5rpx;
  color: #8b8176;
  font-size: 19rpx;
}

.observation-note,
.field-hint,
.recording-task-prompt,
.recording-privacy,
.preview-recording-note,
.purpose-hint,
.upload-hint,
.mistake-action-hint,
.file-name {
  margin-top: 6rpx;
  color: #817669;
  font-size: 21rpx;
  line-height: 1.5;
}

.observation-status,
.submission-status,
.mistake-status {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-independent {
  color: #39765d;
  background: #e6f3ec;
}

.status-prompted {
  color: #8a6730;
  background: #fff0cf;
}

.status-pending {
  color: #a44e47;
  background: #fae6e4;
}

.workspace-editor,
.upload-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.lesson-title-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.lesson-title-suggestion {
  padding: 11rpx 15rpx;
  border: 1rpx solid #c9ddd3;
  border-radius: 999rpx;
  color: #36795e;
  background: #edf7f2;
  font-size: 22rpx;
  line-height: 1.35;
}

.field {
  margin-bottom: 4rpx;
}

.label {
  margin-bottom: 11rpx;
}

.input,
.textarea,
.picker-value,
.observation-input,
.observation-note-input {
  box-sizing: border-box;
  width: 100%;
  border-radius: 14rpx;
  color: #2f2a24;
  background: #f8f2e8;
  font-size: 26rpx;
}

.input,
.picker-value,
.observation-input,
.observation-note-input {
  min-height: 76rpx;
  padding: 0 20rpx;
  line-height: 76rpx;
}

.textarea {
  min-height: 124rpx;
  padding: 18rpx 20rpx;
  line-height: 1.55;
}

.recording-prompt-textarea {
  min-height: 150rpx;
}

.recording-setting {
  padding: 20rpx 0;
  border-top: 1rpx solid #eee5d9;
  border-bottom: 1rpx solid #eee5d9;
}

.institution-course-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 26rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e2d2b8;
  border-radius: 15rpx;
  background: #faf5e9;
}

.institution-course-setting > view {
  min-width: 0;
  flex: 1;
}

.institution-course-setting-label {
  margin-bottom: 2rpx;
  color: #765a35;
}

.previous-lesson-reference {
  margin-bottom: 26rpx;
  padding: 20rpx;
  border: 1rpx solid #d9d2c8;
  border-radius: 15rpx;
  background: #fbfaf7;
}

.previous-lesson-reference-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.previous-lesson-reference-kicker {
  color: #6b8377;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.previous-lesson-reference-title {
  margin-top: 6rpx;
  color: #3d3731;
  font-size: 25rpx;
  font-weight: 800;
}

.previous-lesson-reference-meta,
.previous-lesson-reference-note,
.previous-lesson-reference-empty {
  margin-top: 6rpx;
  color: #817669;
  font-size: 20rpx;
  line-height: 1.5;
}

.previous-lesson-reference-note {
  margin-top: 12rpx;
  color: #6f7f76;
}

.previous-lesson-reference-toggle {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #506d60;
  background: #edf2ee;
  font-size: 19rpx;
  font-weight: 700;
}

.previous-lesson-reference-body {
  margin-top: 15rpx;
  border-top: 1rpx solid #ece6dd;
}

.previous-lesson-reference-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee9e1;
  color: #554e46;
  font-size: 22rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.previous-lesson-reference-row:last-child {
  border-bottom: 0;
}

.previous-lesson-reference-row text {
  display: block;
  margin-bottom: 3rpx;
  color: #7d705f;
  font-size: 19rpx;
  font-weight: 700;
}

.recording-due-field {
  margin-top: 20rpx;
}

.recording-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.recording-option-field {
  min-width: 0;
}

.follow-reading-box {
  margin: 2rpx 0 24rpx;
  padding: 20rpx;
  border: 1rpx solid #cfe2d7;
  border-radius: 16rpx;
  background: #f1f8f4;
}

.follow-reading-content {
  min-height: 260rpx;
  background: #fffdf8;
}

.follow-reading-options {
  margin-top: 12rpx;
}

.follow-reading-wide-option {
  grid-column: 1 / -1;
}

.recording-label {
  margin-bottom: 0;
}

.observation-editor-head {
  margin-top: 6rpx;
  align-items: flex-end;
}

.learning-plan-lesson-box {
  padding: 20rpx;
  border: 1rpx solid #d6e5dc;
  border-radius: 18rpx;
  background: #f0f8f4;
}

.learning-plan-lesson-kicker,
.observation-mini-label {
  color: #728279;
  font-size: 20rpx;
  font-weight: 700;
}

.learning-plan-lesson-stage {
  margin-top: 7rpx;
  color: #315f4d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.learning-focus-field {
  margin-top: 18rpx;
}

.observation-editor {
  padding: 20rpx;
  border: 1rpx solid #eadfcf;
  border-radius: 16rpx;
  background: #fffdfa;
}

.observation-skill-field {
  margin-bottom: 14rpx;
}

.observation-skill-field .picker-value {
  margin-top: 8rpx;
}

.observation-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.compact-picker {
  min-height: 68rpx;
  margin-top: 8rpx !important;
  padding: 0 14rpx;
  font-size: 22rpx;
  line-height: 68rpx;
}

.observation-input {
  flex: 1;
}

.remove-observation {
  flex-shrink: 0;
  color: #a44e47;
  font-size: 22rpx;
}

.observation-editor .picker-value,
.observation-note-input {
  margin-top: 14rpx;
}

.save-record-btn {
  margin-top: 2rpx;
}

.homework-card {
  border-color: #e7dac6;
  background: linear-gradient(145deg, #fffaf1 0%, #fffdfa 100%);
}

.recording-task {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eadfcf;
}

.recording-task-title {
  color: #3d6f5b;
  font-size: 28rpx;
}

.recording-prompt-label {
  margin-top: 18rpx;
}

.recording-task-prompt {
  margin-top: 10rpx;
  padding: 22rpx;
  border: 1rpx solid #dfe9e3;
  border-radius: 16rpx;
  color: #263b33;
  background: #f5faf7;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.75;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  word-break: break-word;
}

.follow-reading-task-list {
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid #dfe9e3;
  border-radius: 16rpx;
  background: #f5faf7;
}

.follow-reading-task-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #e1ebe5;
  color: #263b33;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}

.follow-reading-task-item:last-child {
  border-bottom: 0;
}

.follow-reading-task-item text {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #5f927a;
  font-size: 19rpx;
}

.follow-audio-status,
.manage-follow-audio {
  margin-top: 14rpx;
  padding: 13rpx 15rpx;
  border-radius: 12rpx;
  color: #94564d;
  background: #fae9e6;
  font-size: 22rpx;
  font-weight: 700;
}

.follow-audio-complete {
  color: #39765d;
  background: #e4f1e9;
}

.manage-follow-audio {
  color: #39765d;
  background: #e4f1e9;
  text-align: center;
}

.recording-task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 15rpx;
}

.recording-meta-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #547262;
  background: #e8f2ed;
  font-size: 21rpx;
  font-weight: 700;
}

.deadline-upcoming {
  color: #547262;
  background: #e8f2ed;
}

.deadline-today {
  color: #8a6730;
  background: #fff0cf;
}

.deadline-overdue,
.deadline-late {
  color: #985148;
  background: #fae6e4;
}

.record-btn {
  display: flex;
  min-height: 82rpx;
  margin-top: 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 28rpx;
  font-weight: 700;
}

.record-btn-active {
  background: #b6534b;
  box-shadow: 0 0 0 8rpx rgba(182, 83, 75, 0.12);
}

.ket-session-list {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e7dac6;
}

.ket-session-heading {
  margin-bottom: 12rpx;
  color: #62564a;
  font-size: 23rpx;
  font-weight: 800;
}

.ket-session-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #d8e5de;
  border-radius: 14rpx;
  background: #f4f9f6;
}

.ket-session-disabled {
  border-color: #e5ddd1;
  background: #f8f5ef;
}

.ket-session-status {
  color: #315f4c;
  font-size: 23rpx;
  font-weight: 800;
}

.ket-session-time,
.ket-session-action {
  margin-top: 4rpx;
  color: #817669;
  font-size: 20rpx;
}

.ket-session-action {
  flex-shrink: 0;
  color: #39765d;
  font-weight: 700;
}

.ket-session-score {
  flex-shrink: 0;
  color: #315f4c;
  font-size: 27rpx;
  font-weight: 800;
}

.homework-progress-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #dfd2bf;
  border-radius: 16rpx;
  background: #fffdfa;
}

.homework-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.homework-progress-title,
.homework-reminder-title {
  color: #4d453d;
  font-size: 24rpx;
  font-weight: 800;
}

.homework-progress-time,
.homework-action-hint,
.homework-completed-copy,
.homework-reminder-hint {
  margin-top: 7rpx;
  color: #817669;
  font-size: 21rpx;
  line-height: 1.5;
}

.homework-status-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.homework-status-completed {
  color: #39765d;
  background: #e2f0e9;
}

.homework-status-pending {
  color: #94692e;
  background: #fff0cf;
}

.homework-complete-btn {
  margin-top: 18rpx;
  min-height: 76rpx;
  font-size: 25rpx;
}

.student-homework-review-note {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  color: #486458;
  background: #edf6f1;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.6;
}

.teacher-incomplete-notice {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #edc89f;
  border-radius: 13rpx;
  color: #8a522a;
  background: #fff5e7;
  font-size: 22rpx;
  line-height: 1.5;
}

.teacher-homework-review {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eadfcf;
}

.teacher-homework-review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.teacher-homework-review-title {
  color: #4d453d;
  font-size: 24rpx;
  font-weight: 800;
}

.teacher-homework-review-hint {
  margin-top: 6rpx;
  color: #817669;
  font-size: 20rpx;
}

.teacher-review-state {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #756756;
  background: #f1eadf;
  font-size: 19rpx;
  font-weight: 700;
}

.teacher-homework-review-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 17rpx;
}

.teacher-review-btn {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid;
  border-radius: 13rpx;
  background: #fff;
  font-size: 23rpx;
  font-weight: 700;
}

.teacher-review-completed {
  border-color: #86b29f;
  color: #39765d;
}

.teacher-review-incomplete {
  border-color: #dfb58f;
  color: #9a5d34;
}

.teacher-review-completed.teacher-review-btn-active {
  color: #fff;
  background: #4f8f73;
}

.teacher-review-incomplete.teacher-review-btn-active {
  color: #fff;
  background: #b36b3f;
}

.homework-reminder-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f2f7f4;
}

.homework-reminder-btn {
  display: flex;
  min-height: 68rpx;
  margin-top: 15rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #75a58d;
  border-radius: 13rpx;
  color: #39765d;
  background: #fff;
  font-size: 23rpx;
  font-weight: 700;
}

.submission-list {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eadfcf;
}

.submission-row {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 15rpx;
  background: #f8f2e8;
}

.recording-maintenance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx dashed #d8c7ad;
  border-radius: 15rpx;
  background: #fff8ec;
}

.recording-maintenance-copy {
  min-width: 0;
  flex: 1;
}

.recording-maintenance-title {
  color: #6d5737;
  font-size: 23rpx;
  font-weight: 700;
}

.recording-maintenance-hint {
  margin-top: 5rpx;
  color: #8b7a66;
  font-size: 20rpx;
  line-height: 1.45;
}

.organize-recordings-btn {
  flex-shrink: 0;
  padding: 14rpx 17rpx;
  border-radius: 12rpx;
  color: #fff;
  background: #8a6730;
  font-size: 21rpx;
  font-weight: 700;
}

.submission-name {
  color: #3b352f;
  font-size: 24rpx;
  font-weight: 700;
}

.submission-prompt {
  margin-top: 7rpx;
  color: #6d6257;
  font-size: 22rpx;
  line-height: 1.5;
}

.submission-status-wrap {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
}

.submission-late-status {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #985148;
  background: #fae6e4;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.recording-feedback-card {
  margin-top: 15rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #cfe2d8;
  border-radius: 14rpx;
  background: #f1f8f4;
}

.recording-feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recording-feedback-title {
  color: #39765d;
  font-size: 22rpx;
  font-weight: 800;
}

.recording-feedback-time {
  color: #8a968f;
  font-size: 19rpx;
}

.recording-feedback-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 9rpx;
  margin-top: 12rpx;
}

.recording-feedback-tag {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #dceee4;
  font-size: 20rpx;
  font-weight: 700;
}

.recording-feedback-note {
  margin-top: 11rpx;
  color: #4f5d56;
  font-size: 23rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.submission-actions,
.upload-actions,
.mistake-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 15rpx;
}

.upload-actions {
  flex-wrap: wrap;
}

.submission-actions {
  flex-wrap: wrap;
}

.listen-btn,
.review-btn,
.delete-recording-btn {
  flex: 1;
  padding: 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.listen-btn {
  color: #fff;
  background: #4f8f73;
}

.review-btn {
  color: #6e5b43;
  background: #efe2cf;
}

.delete-recording-btn {
  color: #a43f38;
  background: #f8dfdc;
}

.recording-review-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 39, 33, 0.48);
}

.recording-review-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 28rpx 28rpx 0 0;
  background: #fffdf8;
  box-shadow: 0 -16rpx 48rpx rgba(51, 43, 35, 0.18);
}

.recording-review-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d9d0c4;
}

.recording-review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.recording-review-title {
  color: #2f3b35;
  font-size: 30rpx;
  font-weight: 800;
}

.recording-review-meta {
  margin-top: 7rpx;
  color: #8b8176;
  font-size: 21rpx;
}

.recording-review-close {
  flex-shrink: 0;
  padding: 8rpx 4rpx;
  color: #817669;
  font-size: 23rpx;
}

.recording-review-label {
  margin-top: 28rpx;
  color: #4a423a;
  font-size: 23rpx;
  font-weight: 800;
}

.recording-review-label text {
  margin-left: 9rpx;
  color: #9a8f83;
  font-size: 19rpx;
  font-weight: 500;
}

.recording-review-outcomes {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 13rpx;
}

.recording-review-outcome {
  padding: 20rpx 14rpx;
  border: 2rpx solid #dfd5c8;
  border-radius: 16rpx;
  color: #6c6258;
  background: #fbf7f0;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.outcome-correct.recording-review-outcome-active {
  border-color: #5b9a7d;
  color: #2f7255;
  background: #e8f4ed;
}

.outcome-retry.recording-review-outcome-active {
  border-color: #d18a71;
  color: #9a4f38;
  background: #fbece7;
}

.recording-review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 13rpx;
}

.recording-review-tag {
  padding: 13rpx 17rpx;
  border: 1rpx solid #dfd5c8;
  border-radius: 999rpx;
  color: #675d53;
  background: #fbf7f0;
  font-size: 22rpx;
}

.recording-review-tag-active {
  border-color: #76a88f;
  color: #327056;
  background: #e2f1e9;
  font-weight: 800;
}

.recording-review-note-label {
  margin-top: 26rpx;
}

.recording-review-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 130rpx;
  margin-top: 13rpx;
  padding: 18rpx;
  border: 1rpx solid #ddd2c4;
  border-radius: 15rpx;
  color: #443d36;
  background: #fff;
  font-size: 23rpx;
  line-height: 1.55;
}

.recording-review-link-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 13rpx;
  color: #61766b;
  background: #edf5f0;
  font-size: 20rpx;
  line-height: 1.55;
}

.recording-review-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.recording-review-cancel,
.recording-review-save {
  padding: 20rpx 16rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.recording-review-cancel {
  color: #746a5f;
  background: #eee8df;
}

.recording-review-save {
  color: #fff;
  background: #4f8f73;
}

.purpose-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.purpose-option {
  padding: 18rpx;
  border: 1rpx solid #eadfcf;
  border-radius: 15rpx;
  background: #fbf7f0;
}

.purpose-option-active {
  border-color: #75a58d;
  background: #e9f4ee;
}

.purpose-label {
  color: #4d453d;
  font-size: 24rpx;
  font-weight: 700;
}

.purpose-option-active .purpose-label {
  color: #39765d;
}

.upload-action,
.mistake-action {
  min-width: 0;
  flex: 1;
  font-size: 25rpx;
}

.computer-upload-action {
  flex-basis: 100%;
  border-color: #74a58d;
  color: #39765d;
  background: #edf7f2;
}

.advanced-toggle {
  padding-top: 4rpx;
  text-align: center;
}

.advanced-fields {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.danger-text-action {
  padding: 12rpx 0 2rpx;
  color: #a44e47;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.material-group-title {
  margin: 24rpx 0 12rpx;
}

.paper-card {
  display: block;
  padding: 22rpx 24rpx;
}

.material-image-wrap {
  position: relative;
  width: 100%;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e7dccd;
  border-radius: 16rpx;
  background: #f5f0e7;
}

.material-image-preview {
  display: block;
  width: 100%;
  height: 380rpx;
}

.material-image-hint {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(36, 63, 53, 0.78);
  font-size: 20rpx;
  font-weight: 700;
}

.paper-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.paper-title,
.mistake-title {
  color: #342f29;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.paper-meta {
  margin-top: 8rpx;
  color: #817669;
  font-size: 22rpx;
}

.paper-side {
  flex-shrink: 0;
  text-align: right;
}

.material-card-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 9rpx;
}

.material-action-btn {
  min-width: 92rpx;
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  text-align: center;
}

.open-label {
  color: #39765d;
  background: #e9f4ee;
  font-size: 22rpx;
  font-weight: 700;
}

.save-label {
  color: #80602c;
  background: #f4ead8;
  font-size: 22rpx;
  font-weight: 700;
}

.manage-label {
  color: #8a6730;
  font-size: 21rpx;
}

.mistake-actions-card {
  padding: 22rpx;
}

.mistake-actions {
  margin-top: 0;
}

.mistake-status {
  color: #4f8f73;
  background: #e9f4ee;
}

.reason {
  margin-top: 14rpx;
  color: #62584d;
  font-size: 25rpx;
  line-height: 1.6;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 15rpx;
}

.tag {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #6f593d;
  background: #f5ead8;
  font-size: 21rpx;
}

.teacher-danger-zone {
  margin-top: 56rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e3d8ca;
}

.danger-label {
  margin-bottom: 13rpx;
  color: #9b8b7d;
  font-size: 21rpx;
  text-align: center;
}

.delete-lesson-btn {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  border: 2rpx solid #d9a29d;
  border-radius: 16rpx;
  color: #a43f38;
  background: #fff5f4;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 27rpx;
  line-height: 1.6;
}

.retry-link {
  margin-top: 12rpx;
  color: #39765d;
  font-weight: 700;
}

.disabled-action {
  opacity: 0.55;
}

.ket-source-card,
.ket-task-source {
  margin-top: 14rpx;
  padding: 17rpx;
  border: 1rpx solid #c9dfd3;
  border-radius: 14rpx;
  background: #edf7f2;
}

.mock-source-card,
.mock-task-source {
  border-color: #d8cfb8;
  background: #faf5e8;
}

.ket-source-title {
  color: #315f4c;
  font-size: 23rpx;
  font-weight: 800;
}

.ket-source-line,
.ket-source-warning,
.ket-weekly-hint,
.ket-recording-meta,
.ket-timing-note,
.ket-task-source {
  color: #66766e;
  font-size: 21rpx;
  line-height: 1.5;
}

.ket-source-line,
.ket-source-warning,
.ket-task-source view + view {
  margin-top: 7rpx;
}

.ket-source-warning {
  color: #8a6730;
}

.ket-source-copy {
  margin-top: 10rpx;
  color: #39765d;
  font-size: 21rpx;
  font-weight: 800;
}

.ket-weekly-hint {
  margin-top: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  color: #7c5b28;
  background: #fff3d7;
}

.ket-recording-meta,
.ket-timing-note {
  margin-top: 10rpx;
  color: #39765d;
  font-weight: 700;
}

.official-prompt {
  color: #52635b;
  background: #eef3ef;
}
