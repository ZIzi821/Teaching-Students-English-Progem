.lesson-head {
  background: #e9f4ee;
}

.subject {
  color: #4f8f73;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #243f35;
  font-size: 40rpx;
  font-weight: 700;
}

.date {
  margin-top: 10rpx;
  color: #817669;
  font-size: 24rpx;
}

.summary,
.reason {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
  line-height: 1.6;
}

.sample-tip {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 22rpx;
}

.add-btn {
  margin-bottom: 32rpx;
}

.delete-lesson-btn {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid #d9a29d;
  border-radius: 16rpx;
  color: #a43f38;
  background: #fff5f4;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.section-title {
  margin: 14rpx 0 18rpx;
  color: #2f2a24;
  font-size: 32rpx;
  font-weight: 700;
}

.empty {
  padding: 30rpx 0;
  color: #817669;
  text-align: center;
}

.paper-title,
.mistake-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.paper-meta {
  margin-top: 10rpx;
  color: #817669;
  font-size: 24rpx;
}

.upload-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.upload-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.input,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 28rpx;
  line-height: 78rpx;
}

.upload-btn {
  min-height: 78rpx;
}

.upload-hint {
  color: #817669;
  font-size: 24rpx;
  line-height: 1.5;
}

.mistake-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #4f8f73;
  background: #e9f4ee;
  font-size: 22rpx;
  white-space: nowrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6f593d;
  background: #f5ead8;
  font-size: 22rpx;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}

.preview-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #4f6f63;
  background: #e9f4ee;
  font-size: 26rpx;
  line-height: 1.6;
}
