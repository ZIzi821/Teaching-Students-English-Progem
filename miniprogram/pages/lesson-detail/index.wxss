.lesson-page {
  padding-top: 24rpx;
  padding-bottom: 96rpx;
}

.no-permission {
  color: var(--ink-2);
  text-align: center;
}

.retry-link {
  margin-top: 16rpx;
  color: var(--accent);
  font-weight: 500;
}

.disabled-action {
  opacity: 0.5;
}

/* 页头 */
.lesson-head {
  margin: 0 4rpx 16rpx;
}

.lesson-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.title {
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-word;
}

.date {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.preview-tip {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 26rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 8rpx 4rpx 16rpx;
}

.section-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.small-action {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 26rpx;
  font-weight: 500;
}

.submission-count {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.empty {
  padding: 48rpx 24rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 24rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}

/* 记录 */
.empty-record {
  text-align: center;
}

.empty-record-title {
  color: var(--ink);
  font-weight: 500;
}

.empty-record-hint {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.record-item {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.record-item:first-child {
  padding-top: 0;
  border-top: 0;
}

.record-item:last-child {
  padding-bottom: 0;
}

.record-label {
  color: var(--ink-3);
  font-size: 26rpx;
}

.record-value {
  margin-top: 4rpx;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.lesson-focus-summary {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 26rpx;
}

.lesson-focus-summary text {
  margin-right: 12rpx;
  color: var(--ink-3);
}

.observation-list {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.observation-title {
  margin-bottom: 8rpx;
}

.observation-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
}

.observation-main {
  min-width: 0;
  flex: 1;
}

.observation-skill {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.observation-content {
  color: var(--ink);
  word-break: break-word;
}

.observation-evidence-meta,
.observation-note {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.observation-status,
.submission-status,
.submission-late-status {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-independent {
  color: var(--accent);
  background: var(--accent-soft);
}

.status-prompted {
  color: var(--warn);
  background: var(--warn-soft);
}

.status-pending,
.submission-late-status {
  color: var(--danger);
  background: var(--danger-soft);
}

.teacher-danger-zone {
  margin-top: 40rpx;
  text-align: center;
}

.delete-lesson-btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  color: var(--danger);
  font-size: 26rpx;
}

/* 表单 */
.field {
  margin-bottom: 28rpx;
}

.label {
  margin-bottom: 10rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 500;
}

.input,
.picker-value,
.textarea,
.observation-input,
.observation-note-input {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  color: var(--ink);
  background: var(--surface);
  font-size: 30rpx;
}

.picker-value {
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  line-height: 1.4;
}

/* 原生 input 不支持上下内边距，用固定高度 + 行高让文字垂直居中 */
.input,
.observation-input,
.observation-note-input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
}

.follow-reading-content {
  height: 280rpx;
}

.recording-prompt-textarea {
  height: 200rpx;
}

.field-hint {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.lesson-title-suggestions {
  margin-top: 12rpx;
}

.lesson-title-suggestion {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 26rpx;
}

.institution-course-setting,
.recording-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.institution-course-setting > view,
.recording-setting > view {
  min-width: 0;
  flex: 1;
}

.institution-course-setting switch,
.recording-setting switch {
  flex-shrink: 0;
}

.institution-course-setting-label,
.recording-label {
  margin-bottom: 0;
}

.previous-lesson-reference,
.follow-reading-box,
.learning-plan-lesson-box {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.previous-lesson-reference-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.previous-lesson-reference-kicker,
.learning-plan-lesson-kicker {
  color: var(--ink-3);
  font-size: 24rpx;
}

.previous-lesson-reference-title,
.learning-plan-lesson-stage {
  color: var(--ink);
  font-weight: 500;
}

.previous-lesson-reference-meta,
.previous-lesson-reference-note,
.previous-lesson-reference-empty {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.previous-lesson-reference-toggle {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 26rpx;
}

.previous-lesson-reference-body {
  margin-top: 12rpx;
}

.previous-lesson-reference-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line-strong);
  font-size: 26rpx;
}

.previous-lesson-reference-row text {
  flex: 0 0 112rpx;
  color: var(--ink-3);
}

.previous-lesson-reference-row view {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.recording-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.follow-reading-options {
  margin: 0 0 12rpx;
}

.ket-source-warning,
.ket-weekly-hint {
  margin-top: 12rpx;
  color: var(--warn);
  font-size: 26rpx;
}

.learning-focus-field {
  margin: 16rpx 0 0;
}

.observation-editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.observation-editor-head .label {
  margin-bottom: 0;
}

.add-observation {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}

.observation-editor {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.observation-skill-field {
  margin-bottom: 12rpx;
}

.observation-mini-label {
  margin-bottom: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.observation-editor-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.observation-input {
  min-width: 0;
  flex: 1;
}

.remove-observation {
  flex-shrink: 0;
  color: var(--danger);
  font-size: 26rpx;
}

.observation-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.compact-picker {
  font-size: 26rpx;
}

.observation-note-input {
  margin-top: 12rpx;
}

.save-record-btn {
  margin-top: 16rpx;
}

/* 任务 */
.homework-copy-label,
.recording-prompt-label {
  margin-bottom: 8rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.homework-text {
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

.recording-task {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.homework-copy + .recording-task {
  margin-top: 24rpx;
}

.recording-task:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.recording-task-title {
  margin-bottom: 16rpx;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.ket-task-source {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
  background: var(--info-soft);
  font-size: 26rpx;
  word-break: break-word;
}

.mock-task-source {
  background: var(--accent-soft);
}

.recording-task-prompt {
  color: var(--ink);
  font-size: 34rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.follow-reading-task-list {
  margin-bottom: 12rpx;
}

.follow-reading-task-item {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--line);
  word-break: break-word;
}

.follow-reading-task-item:first-child {
  border-top: 0;
}

.follow-reading-task-item text {
  flex: 0 0 40rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.follow-reading-task-item view {
  min-width: 0;
  flex: 1;
}

.follow-audio-status {
  margin-top: 12rpx;
  color: var(--warn);
  font-size: 26rpx;
}

.follow-audio-complete {
  color: var(--accent);
}

.manage-follow-audio {
  margin-top: 12rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}

.recording-task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
}

.recording-meta-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
  font-weight: 500;
}

.deadline-upcoming {
  color: var(--accent);
  background: var(--accent-soft);
}

.deadline-today {
  color: var(--warn);
  background: var(--warn-soft);
}

.deadline-overdue,
.deadline-late {
  color: var(--danger);
  background: var(--danger-soft);
}

.ket-timing-note,
.recording-privacy,
.preview-recording-note {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.record-btn {
  display: flex;
  min-height: 96rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-weight: 600;
}

.ket-session-list,
.submission-list,
.homework-progress-card,
.recording-maintenance {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.ket-session-heading,
.submission-title,
.homework-progress-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.ket-session-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.ket-session-heading + .ket-session-card {
  margin-top: 16rpx;
}

.ket-session-disabled {
  opacity: 0.6;
}

.ket-session-card > view:first-child {
  min-width: 0;
  flex: 1;
}

.ket-session-status {
  color: var(--ink);
  font-weight: 500;
}

.ket-session-time {
  color: var(--ink-3);
  font-size: 26rpx;
}

.ket-session-score {
  flex-shrink: 0;
  color: var(--accent);
  font-weight: 600;
}

.ket-session-action {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 26rpx;
}

.submission-row {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
}

.submission-title + .submission-row {
  margin-top: 16rpx;
}

.submission-row:last-child {
  padding-bottom: 0;
}

.submission-name {
  color: var(--ink);
  font-weight: 500;
}

.submission-prompt {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  word-break: break-word;
}

.submission-status-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.recording-feedback-card {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
}

.recording-feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recording-feedback-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.recording-feedback-time {
  color: var(--ink-3);
  font-size: 24rpx;
}

.recording-feedback-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.recording-feedback-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
}

.recording-feedback-note {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  word-break: break-word;
}

.submission-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.listen-btn,
.review-btn,
.delete-recording-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.listen-btn {
  color: var(--on-fill);
  background: var(--accent);
}

.review-btn {
  border: 1rpx solid var(--line-strong);
  color: var(--accent);
}

.delete-recording-btn {
  margin-left: auto;
  padding-right: 0;
  color: var(--danger);
}

.submission-empty {
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 24rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}

.recording-maintenance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.recording-maintenance-copy {
  min-width: 0;
  flex: 1;
}

.recording-maintenance-title {
  color: var(--ink);
  font-weight: 500;
}

.recording-maintenance-hint {
  color: var(--ink-3);
  font-size: 26rpx;
}

.organize-recordings-btn {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}

.homework-progress-head,
.teacher-homework-review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.homework-progress-time,
.teacher-homework-review-hint {
  color: var(--ink-3);
  font-size: 26rpx;
}

.homework-status-pill {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.homework-status-completed {
  color: var(--accent);
  background: var(--accent-soft);
}

.homework-status-pending {
  color: var(--warn);
  background: var(--warn-soft);
}

.homework-completed-copy,
.student-homework-review-note {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.teacher-incomplete-notice {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  color: var(--danger);
  background: var(--danger-soft);
  font-size: 26rpx;
}

.homework-reminder-box {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.homework-reminder-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 500;
}

.homework-reminder-hint {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.homework-reminder-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}

.teacher-homework-review {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.teacher-homework-review-title {
  color: var(--ink);
  font-weight: 500;
}

.teacher-review-state {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.teacher-homework-review-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.teacher-review-btn {
  display: flex;
  min-height: 96rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.teacher-review-completed.teacher-review-btn-active {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
}

.teacher-review-incomplete.teacher-review-btn-active {
  border-color: var(--danger);
  color: var(--on-fill);
  background: var(--danger);
}

/* 资料 */
.upload-step {
  margin-bottom: 16rpx;
  color: var(--ink);
  font-weight: 500;
}

.purpose-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.purpose-option {
  padding: 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
}

.purpose-option-active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.purpose-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.purpose-hint {
  color: var(--ink-3);
  font-size: 24rpx;
}

.upload-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.upload-action {
  padding: 8rpx;
  font-size: 26rpx;
  text-align: center;
}

.computer-upload-action {
  grid-column: 1 / -1;
}

.upload-hint {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.advanced-toggle {
  margin-top: 16rpx;
  color: var(--accent);
  font-size: 26rpx;
}

.advanced-fields .input {
  margin-top: 12rpx;
}

.danger-text-action {
  margin-top: 24rpx;
  color: var(--danger);
  font-size: 26rpx;
}

.material-group-title {
  margin: 24rpx 4rpx 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 600;
}

.paper-card {
  padding: 24rpx;
}

.material-image-wrap {
  margin-bottom: 16rpx;
}

.material-image-preview {
  display: block;
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.material-image-hint {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}

.paper-main {
  min-width: 0;
}

.paper-title {
  color: var(--ink);
  font-weight: 500;
  word-break: break-word;
}

.paper-meta,
.file-name {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  word-break: break-all;
}

.material-card-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.material-action-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}

.manage-label {
  margin-left: auto;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* 错题 */
.mistake-actions {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 12rpx;
}

.mistake-action-hint {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.mistake-card {
  padding: 24rpx 28rpx;
}

.mistake-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.mistake-title {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-weight: 500;
  word-break: break-word;
}

.mistake-status {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 24rpx;
  font-weight: 500;
}

.reason {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  word-break: break-word;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
}

/* 录音反馈面板 */
.recording-review-mask {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(34, 48, 44, 0.45);
}

.recording-review-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
}

.recording-review-handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: var(--line-strong);
}

.recording-review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.recording-review-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.recording-review-meta {
  color: var(--ink-3);
  font-size: 26rpx;
}

.recording-review-close {
  flex-shrink: 0;
  color: var(--ink-2);
  font-size: 26rpx;
}

.recording-review-label {
  margin: 28rpx 0 12rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.recording-review-label text {
  margin-left: 8rpx;
  color: var(--ink-3);
  font-weight: 400;
}

.recording-review-outcomes,
.recording-review-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.recording-review-outcome,
.recording-review-cancel,
.recording-review-save {
  display: flex;
  min-height: 84rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  color: var(--ink-2);
  font-weight: 500;
}

.outcome-correct.recording-review-outcome-active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.outcome-retry.recording-review-outcome-active {
  border-color: var(--danger);
  color: var(--danger);
  background: var(--danger-soft);
}

.recording-review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.recording-review-tag {
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.recording-review-tag-active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.recording-review-note-label {
  margin-top: 28rpx;
}

.recording-review-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  font-size: 30rpx;
}

.recording-review-link-note {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.recording-review-actions {
  margin-top: 24rpx;
}

.recording-review-save {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
  font-weight: 600;
}
