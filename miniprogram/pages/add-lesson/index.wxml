<view class="page">
  <view class="form-head">
    <view class="title">建立英语课记录</view>
    <view class="subtitle">先建立课次；课后观察、复习提醒和任务可以现在填写，也可以进入课程后补充。</view>
  </view>

  <view class="card message-card" wx:if="{{message}}">{{message}}</view>

  <view class="card form-card">
    <view class="field">
      <view class="label">学生</view>
      <picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="onStudentChange">
        <view class="picker-value">{{selectedStudentName}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">课程记录模板</view>
      <picker mode="selector" range="{{lessonTemplateOptions}}" range-key="label" value="{{lessonTemplateIndex}}" bindchange="onLessonTemplateChange">
        <view class="picker-value">{{lessonTemplate.label}}</view>
      </picker>
      <view class="template-hint">{{lessonTemplate.description}}</view>
    </view>

    <view class="field">
      <view class="label">课程标题</view>
      <input class="input" placeholder="{{lessonTemplate.titlePlaceholder}}" value="{{form.title}}" data-field="title" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">日期</view>
      <picker mode="date" value="{{form.lessonDate}}" bindchange="onDateChange">
        <view class="picker-value">{{form.lessonDate}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">第几节课</view>
      <input class="input" type="number" placeholder="例如：1" value="{{form.lessonNo}}" data-field="lessonNo" bindinput="onInput" />
      <view class="field-tip" wx:if="{{lessonNoTip}}">{{lessonNoTip}}</view>
    </view>

  </view>

  <view class="card previous-reference-card" wx:if="{{previousLessonReference}}">
    <view class="previous-reference-head" bindtap="togglePreviousLessonReference">
      <view>
        <view class="previous-reference-kicker">上一节课对照</view>
        <view class="previous-reference-title">{{previousLessonReference.title || '上一节英语课'}}</view>
        <view class="previous-reference-meta">{{previousLessonReference.lessonDate}} · 第 {{previousLessonReference.lessonNo || '—'}} 节</view>
      </view>
      <view class="previous-reference-toggle">{{showPreviousLessonReference ? '收起' : '展开'}}</view>
    </view>
    <view class="previous-reference-note">这里只显示上次填写内容，不会自动复制到本节课。</view>
    <view class="previous-reference-body" wx:if="{{showPreviousLessonReference}}">
      <view class="previous-reference-empty" wx:if="{{!previousLessonReference.hasReferenceContent}}">上一节课没有填写课后整理内容。</view>
      <block wx:if="{{previousLessonReference.lessonTemplateKey === 'feng_beginner'}}">
        <view class="previous-reference-row" wx:if="{{previousLessonReference.reviewContent}}"><text>今日复习</text><view>{{previousLessonReference.reviewContent}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.taughtContent}}"><text>今日新内容</text><view>{{previousLessonReference.taughtContent}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.masterySummary}}"><text>掌握情况</text><view>{{previousLessonReference.masterySummary}}</view></view>
      </block>
      <block wx:elif="{{previousLessonReference.lessonTemplateKey === 'molly_oral_ket'}}">
        <view class="previous-reference-row" wx:if="{{previousLessonReference.oralTopic}}"><text>口语主题</text><view>{{previousLessonReference.oralTopic}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.targetExpression}}"><text>目标表达</text><view>{{previousLessonReference.targetExpression}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.independentOutput}}"><text>独立输出</text><view>{{previousLessonReference.independentOutput}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.correctionNotes}}"><text>需要纠正</text><view>{{previousLessonReference.correctionNotes}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.ketSkill}}"><text>KET 技能</text><view>{{previousLessonReference.ketSkill}}</view></view>
      </block>
      <block wx:else>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.taughtContent}}"><text>上节内容</text><view>{{previousLessonReference.taughtContent}}</view></view>
        <view class="previous-reference-row" wx:if="{{previousLessonReference.masterySummary}}"><text>掌握情况</text><view>{{previousLessonReference.masterySummary}}</view></view>
      </block>
      <view class="previous-reference-row" wx:if="{{previousLessonReference.nextReview}}"><text>下节复习</text><view>{{previousLessonReference.nextReview}}</view></view>
      <view class="previous-reference-row" wx:if="{{previousLessonReference.homeworkTask}}"><text>课后任务</text><view>{{previousLessonReference.homeworkTask}}</view></view>
      <view class="previous-reference-row" wx:if="{{previousLessonReference.recordingPrompt}}"><text>录音要求</text><view>{{previousLessonReference.recordingPrompt}}</view></view>
    </view>
  </view>

  <view class="card optional-card">
    <view class="optional-head" bindtap="toggleLessonRecord">
      <view>
        <view class="optional-title">课后整理</view>
        <view class="optional-hint">用四项简短记录代替一大段课程总结</view>
      </view>
      <view class="optional-toggle">{{showLessonRecord ? '收起' : '现在填写'}}</view>
    </view>

    <block wx:if="{{showLessonRecord}}">
      <block wx:if="{{form.lessonTemplateKey === 'feng_beginner'}}">
        <view class="field optional-first-field">
          <view class="label">今日复习</view>
          <textarea class="textarea compact-textarea" placeholder="先写旧内容，例如：A–I 和数字 1–3" value="{{form.reviewContent}}" data-field="reviewContent" bindinput="onInput"></textarea>
        </view>
        <view class="field">
          <view class="label">今日新内容（少量）</view>
          <textarea class="textarea compact-textarea" placeholder="例如：新字母 J–L；一次只加少量" value="{{form.taughtContent}}" data-field="taughtContent" bindinput="onInput"></textarea>
        </view>
        <view class="field">
          <view class="label">掌握情况</view>
          <textarea class="textarea compact-textarea" placeholder="说明能否独立认读、需要什么提示" value="{{form.masterySummary}}" data-field="masterySummary" bindinput="onInput"></textarea>
        </view>
      </block>

      <block wx:elif="{{form.lessonTemplateKey === 'molly_oral_ket'}}">
        <view class="field optional-first-field">
          <view class="label">今日口语主题</view>
          <textarea class="textarea compact-textarea" placeholder="例如：介绍自己的学校生活" value="{{form.oralTopic}}" data-field="oralTopic" bindinput="onInput"></textarea>
        </view>
        <view class="field">
          <view class="label">目标表达</view>
          <textarea class="textarea compact-textarea" placeholder="本节真正练习的词块或句型" value="{{form.targetExpression}}" data-field="targetExpression" bindinput="onInput"></textarea>
        </view>
        <view class="field">
          <view class="label">独立输出</view>
          <textarea class="textarea compact-textarea" placeholder="学生不看答案能够说出的内容" value="{{form.independentOutput}}" data-field="independentOutput" bindinput="onInput"></textarea>
        </view>
        <view class="field">
          <view class="label">需要纠正</view>
          <textarea class="textarea compact-textarea" placeholder="只记录最值得下次继续纠正的 1–3 项" value="{{form.correctionNotes}}" data-field="correctionNotes" bindinput="onInput"></textarea>
        </view>
        <view class="field">
          <view class="label">本节 KET 技能</view>
          <input class="input" placeholder="例如：Speaking Part 1；没有可留空" value="{{form.ketSkill}}" data-field="ketSkill" bindinput="onInput" />
        </view>
      </block>

      <block wx:else>
      <view class="field optional-first-field">
        <view class="label">今天学了什么</view>
        <textarea class="textarea compact-textarea" placeholder="例如：复习 A–I，练习数字 1–3" value="{{form.taughtContent}}" data-field="taughtContent" bindinput="onInput"></textarea>
      </view>
      <view class="field">
        <view class="label">掌握情况</view>
        <textarea class="textarea compact-textarea" placeholder="只写最关键的表现" value="{{form.masterySummary}}" data-field="masterySummary" bindinput="onInput"></textarea>
      </view>
      </block>
      <view class="field">
        <view class="label">下节需要复习</view>
        <textarea class="textarea compact-textarea" placeholder="例如：A–E 大小写对应" value="{{form.nextReview}}" data-field="nextReview" bindinput="onInput"></textarea>
      </view>
      <view class="field">
        <view class="label">课后任务</view>
        <textarea class="textarea compact-textarea" placeholder="例如：跟读目标句 3 遍" value="{{form.homeworkTask}}" data-field="homeworkTask" bindinput="onInput"></textarea>
      </view>
      <view class="recording-row">
        <view>
          <view class="label recording-label">需要学生提交录音</view>
          <view class="field-tip">学生在课程页录制，教师可以直接播放检查。</view>
        </view>
        <switch checked="{{form.recordingTaskEnabled}}" color="#4f8f73" bindchange="onRecordingTaskChange" />
      </view>
      <view class="field recording-due-field" wx:if="{{form.recordingTaskEnabled}}">
        <view class="label">录音作业期限</view>
        <picker mode="selector" range="{{homeworkDueOptions}}" range-key="label" value="{{homeworkDueIndex}}" bindchange="onHomeworkDueChange">
          <view class="picker-value">{{homeworkDueOptions[homeworkDueIndex].label}}</view>
        </picker>
        <view class="field-tip">以本节课程日期为当天；学生端会显示剩余天数，逾期后首次有效提交会标记“逾期提交”。</view>
      </view>
      <view class="field recording-type-field" wx:if="{{form.recordingTaskEnabled && form.lessonTemplateKey === 'molly_oral_ket'}}">
        <view class="label">Molly 的录音任务类型</view>
        <picker mode="selector" range="{{recordingTaskTypeOptions}}" range-key="label" value="{{recordingTaskTypeIndex}}" bindchange="onRecordingTaskTypeChange">
          <view class="picker-value">{{recordingTaskTypeOptions[recordingTaskTypeIndex].label}}</view>
        </picker>
        <view class="field-tip">单题练习保留官方公开样题；全流程模拟包含 1 套公开样题结构改编和 7 套当前格式原创题。</view>
      </view>
      <view class="field" wx:if="{{form.recordingTaskEnabled && form.recordingTaskType === 'ket_official'}}">
        <view class="label">选择官方口语样题</view>
        <picker mode="selector" range="{{ketSpeakingTasks}}" range-key="label" value="{{ketSpeakingTaskIndex}}" bindchange="onKetSpeakingTaskChange">
          <view class="picker-value">{{selectedKetSpeakingTask.label}}</view>
        </picker>
        <view class="ket-source-card">
          <view class="ket-source-title">{{selectedKetSpeakingTask.sourceYear}} · {{selectedKetSpeakingTask.part}} · {{selectedKetSpeakingTask.difficulty}}</view>
          <view class="ket-source-line">{{selectedKetSpeakingTask.sourceLabel}}</view>
          <view class="ket-source-line">官方定位：{{selectedKetSpeakingTask.sourceReference}}</view>
          <view class="ket-source-line">{{selectedKetSpeakingTask.timingLabel}}</view>
          <view class="ket-source-copy" bindtap="copyKetSource">复制 Cambridge 官方来源</view>
          <view class="ket-source-warning" wx:if="{{selectedKetSpeakingTask.preparationSeconds}}">本页 {{selectedKetSpeakingTask.preparationSeconds}} 秒仅为练习读题时间，不是官方固定准备时间。</view>
          <view class="ket-source-warning" wx:else>正式练习按直接听题回答处理，不设置准备倒计时。</view>
        </view>
        <view class="ket-weekly-hint" wx:if="{{ketWeeklyHint}}">{{ketWeeklyHint}}</view>
      </view>
      <view class="field" wx:if="{{form.recordingTaskEnabled && form.recordingTaskType === 'ket_mock'}}">
        <view class="label">选择完整模拟套题</view>
        <picker mode="selector" range="{{ketMockSets}}" range-key="title" value="{{ketMockSetIndex}}" bindchange="onKetMockSetChange">
          <view class="picker-value">{{selectedKetMockSet.title}}</view>
        </picker>
        <view class="ket-source-card mock-source-card">
          <view class="ket-source-title">{{selectedKetMockSet.sourceBadge}}</view>
          <view class="ket-source-line">{{selectedKetMockSet.formatLabel}} · {{selectedKetMockSet.expectedMinutes}}</view>
          <view class="ket-source-line">主题：{{selectedKetMockSet.topic}}</view>
          <view class="ket-source-line">{{selectedKetMockSet.sourceLabel}}</view>
          <view class="ket-source-warning">学生开始前，需先在“教师管理 → KET 模拟录音库”准备本套 9 段考官音频。</view>
        </view>
        <view class="ket-weekly-hint" wx:if="{{ketWeeklyHint}}">{{ketWeeklyHint}}</view>
      </view>
      <view class="field recording-prompt-field" wx:if="{{form.recordingTaskEnabled}}">
        <view class="label">录音要求</view>
        <textarea class="textarea compact-textarea {{form.recordingTaskType !== 'manual' ? 'official-prompt' : ''}}" maxlength="2000" disabled="{{form.recordingTaskType !== 'manual'}}" placeholder="{{lessonTemplate.recordingPlaceholder}}" value="{{form.recordingPrompt}}" data-field="recordingPrompt" bindinput="onInput"></textarea>
      </view>
      <view class="recording-options" wx:if="{{form.recordingTaskEnabled && form.recordingTaskType === 'manual'}}">
        <view class="recording-option">
          <view class="label">朗读遍数</view>
          <picker mode="selector" range="{{recordingRepeatOptions}}" value="{{recordingRepeatIndex}}" bindchange="onRecordingRepeatChange">
            <view class="picker-value">{{form.recordingRepeatCount}} 遍</view>
          </picker>
        </view>
        <view class="recording-option">
          <view class="label">准备时间</view>
          <picker mode="selector" range="{{recordingPreparationOptions}}" value="{{recordingPreparationIndex}}" bindchange="onRecordingPreparationChange">
            <view class="picker-value">{{form.recordingPreparationSeconds}} 秒</view>
          </picker>
        </view>
      </view>
      <view class="ket-recording-meta" wx:if="{{form.recordingTaskEnabled && form.recordingTaskType === 'ket_official'}}">
        建议录音约 {{selectedKetSpeakingTask.suggestedRecordingSeconds}} 秒 · 录制 1 次即可
      </view>
      <view class="ket-recording-meta" wx:if="{{form.recordingTaskEnabled && form.recordingTaskType === 'ket_mock'}}">
        学生一次完成 · 考官录音自动播放 · 回答分段保存 · 不允许返回重录
      </view>
    </block>
  </view>

  <view class="primary-btn {{saving ? 'action-disabled' : ''}}" bindtap="submitLesson">{{saving ? '保存中…' : '保存并进入课程'}}</view>
</view>
