.form-head {
  margin-bottom: 22rpx;
}

.title {
  color: #2f2a24;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #817669;
  font-size: 26rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #655b50;
  font-size: 26rpx;
  font-weight: 600;
}

.field-tip {
  margin-top: 10rpx;
  color: #8a6730;
  font-size: 24rpx;
  line-height: 1.5;
}

.lesson-title-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.lesson-title-suggestion {
  padding: 11rpx 15rpx;
  border: 1rpx solid #c9ddd3;
  border-radius: 999rpx;
  color: #36795e;
  background: #edf7f2;
  font-size: 22rpx;
  line-height: 1.35;
}

.lesson-title-sequence-hint {
  margin-top: 10rpx;
  color: #817669;
  font-size: 22rpx;
  line-height: 1.5;
}

.institution-course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #e2d2b8;
  border-radius: 16rpx;
  background: #faf5e9;
}

.institution-course-copy {
  min-width: 0;
  flex: 1;
}

.institution-course-label {
  margin-bottom: 6rpx;
  color: #765a35;
}

.institution-course-hint {
  color: #84745f;
  font-size: 21rpx;
  line-height: 1.5;
}

.template-hint {
  margin-top: 10rpx;
  color: #39765d;
  font-size: 24rpx;
  line-height: 1.55;
}

.action-disabled {
  opacity: 0.55;
}

.optional-card {
  padding: 24rpx 26rpx;
}

.previous-reference-card {
  padding: 24rpx 26rpx;
  border-color: #d9d2c8;
  background: #fbfaf7;
}

.previous-reference-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.previous-reference-kicker {
  color: #6b8377;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.previous-reference-title {
  margin-top: 7rpx;
  color: #342f29;
  font-size: 28rpx;
  font-weight: 800;
}

.previous-reference-meta,
.previous-reference-note,
.previous-reference-empty {
  margin-top: 7rpx;
  color: #817669;
  font-size: 22rpx;
  line-height: 1.5;
}

.previous-reference-note {
  margin-top: 13rpx;
  color: #6f7f76;
}

.previous-reference-toggle {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #506d60;
  background: #edf2ee;
  font-size: 21rpx;
  font-weight: 700;
}

.previous-reference-body {
  margin-top: 18rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid #ece6dd;
}

.previous-reference-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eee9e1;
  color: #554e46;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.previous-reference-row:last-child {
  border-bottom: 0;
}

.previous-reference-row text {
  display: block;
  margin-bottom: 4rpx;
  color: #7d705f;
  font-size: 21rpx;
  font-weight: 700;
}

.optional-head,
.recording-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.optional-title {
  color: #342f29;
  font-size: 29rpx;
  font-weight: 700;
}

.optional-hint {
  margin-top: 7rpx;
  color: #817669;
  font-size: 22rpx;
  line-height: 1.5;
}

.optional-toggle {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #e9f4ee;
  font-size: 22rpx;
  font-weight: 700;
}

.optional-first-field {
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #eee4d6;
}

.compact-textarea {
  min-height: 126rpx;
}

.recording-row {
  padding: 22rpx 0;
  border-top: 1rpx solid #eee4d6;
}

.recording-label {
  margin-bottom: 0;
}

.recording-prompt-field {
  margin-top: 8rpx;
}

.recording-type-field {
  margin-top: 18rpx;
}

.recording-due-field {
  margin-top: 18rpx;
}

.ket-source-card {
  margin-top: 14rpx;
  padding: 18rpx;
  border: 1rpx solid #c9dfd3;
  border-radius: 14rpx;
  background: #edf7f2;
}

.mock-source-card {
  border-color: #d8cfb8;
  background: #faf5e8;
}

.ket-source-title {
  color: #315f4c;
  font-size: 24rpx;
  font-weight: 800;
}

.ket-source-line,
.ket-source-warning,
.ket-weekly-hint,
.ket-recording-meta {
  margin-top: 8rpx;
  color: #66766e;
  font-size: 21rpx;
  line-height: 1.5;
}

.ket-source-warning {
  color: #8a6730;
}

.ket-source-copy {
  margin-top: 10rpx;
  color: #39765d;
  font-size: 21rpx;
  font-weight: 800;
}

.ket-weekly-hint {
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  color: #7c5b28;
  background: #fff3d7;
}

.ket-recording-meta {
  margin-bottom: 24rpx;
  color: #39765d;
  font-weight: 700;
}

.official-prompt {
  color: #52635b;
  background: #eef3ef;
}

.recording-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.recording-option {
  min-width: 0;
}

.follow-reading-box {
  margin: 6rpx 0 24rpx;
  padding: 20rpx;
  border: 1rpx solid #cfe2d7;
  border-radius: 16rpx;
  background: #f1f8f4;
}

.follow-reading-content {
  min-height: 260rpx;
  background: #fffdf8;
}

.follow-reading-options {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 18rpx;
}

.follow-reading-options .recording-option:last-child {
  grid-column: 1 / -1;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 14rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 28rpx;
}

.message-card {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}

.input,
.picker-value {
  min-height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.textarea {
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
}
