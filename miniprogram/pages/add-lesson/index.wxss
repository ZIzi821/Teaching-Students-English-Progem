.form-head {
  margin-bottom: 22rpx;
}

.title {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 600;
}

.field-tip {
  margin-top: 10rpx;
  color: var(--warn);
  font-size: 26rpx;
  line-height: 1.5;
}

.lesson-title-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.lesson-title-suggestion {
  padding: 11rpx 15rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  line-height: 1.35;
}

.lesson-title-sequence-hint {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.institution-course-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 20rpx;
  border: 1rpx solid var(--warn-line);
  border-radius: 16rpx;
  background: var(--surface-2);
}

.institution-course-copy {
  min-width: 0;
  flex: 1;
}

.institution-course-label {
  margin-bottom: 6rpx;
  color: var(--warn);
}

.institution-course-hint {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.template-hint {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 26rpx;
  line-height: 1.55;
}

.learning-plan-card {
  border-color: var(--accent-line);
  background: var(--surface);
}

.learning-plan-kicker {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 600;
}

.learning-plan-stage {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.learning-focus-field {
  margin-top: 20rpx;
}

.learning-plan-suggestion {
  margin-top: 14rpx;
  padding: 15rpx 17rpx;
  border-radius: 16rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.learning-plan-note {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.action-disabled {
  opacity: 0.55;
}

.optional-card {
  padding: 24rpx 26rpx;
}

.previous-reference-card {
  padding: 24rpx 26rpx;
  border-color: var(--line);
  background: var(--surface);
}

.previous-reference-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.previous-reference-kicker {
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.previous-reference-title {
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.previous-reference-meta,
.previous-reference-note,
.previous-reference-empty {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.previous-reference-note {
  margin-top: 13rpx;
  color: var(--ink-2);
}

.previous-reference-toggle {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.previous-reference-body {
  margin-top: 18rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid var(--line);
}

.previous-reference-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.previous-reference-row:last-child {
  border-bottom: 0;
}

.previous-reference-row text {
  display: block;
  margin-bottom: 4rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.optional-head,
.recording-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.optional-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.optional-hint {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.optional-toggle {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.recording-row {
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.recording-label {
  margin-bottom: 0;
}

.ket-source-line,
.ket-source-warning,
.ket-weekly-hint,
.ket-recording-meta {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.ket-weekly-hint {
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  color: var(--warn);
  background: var(--warn-soft);
}

.recording-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.recording-option {
  min-width: 0;
}

.follow-reading-options .recording-option:last-child {
  grid-column: 1 / -1;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 30rpx;
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
  line-height: 1.6;
}

.input,
.picker-value {
  min-height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}
