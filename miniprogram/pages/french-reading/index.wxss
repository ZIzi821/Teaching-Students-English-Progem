.page { gap: 16rpx; }.tabs { display: flex; gap: 12rpx; }.tabs view { flex: 1; padding: 16rpx; text-align: center; background: #f5ead8; border-radius: 14rpx; }.tabs .on { background: #7b8eaa; color: #fff; }.state-card { text-align: center; color: #817669; }.error { color: #9c463b; }.retry { margin-top: 16rpx; font-size: 24rpx; }.title { font-size: 32rpx; font-weight: 700; }.small, .translation, .q { margin-top: 12rpx; color: #817669; line-height: 1.6; }.completion { margin-top: 12rpx; color: #326d56; font-size: 24rpx; }.text { margin-top: 24rpx; font-size: 30rpx; line-height: 1.8; }.q { padding: 12rpx; background: #eef7f1; }.card button { margin: 18rpx 10rpx 0 0; font-size: 24rpx; }
