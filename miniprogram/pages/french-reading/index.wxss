.page { gap: 16rpx; }.tabs { display: flex; gap: 12rpx; }.tabs view { flex: 1; padding: 16rpx; text-align: center; background: var(--line); border-radius: 16rpx; }.tabs .on { background: var(--info); color: var(--on-fill); }.state-card { text-align: center; color: var(--ink-2); }.error { color: var(--danger); }.retry { margin-top: 16rpx; font-size: 24rpx; }.title { font-size: 32rpx; font-weight: 600; }.small, .translation, .q { margin-top: 12rpx; color: var(--ink-2); line-height: 1.6; }.completion { margin-top: 12rpx; color: var(--accent); font-size: 24rpx; }.text { margin-top: 24rpx; font-size: 32rpx; line-height: 1.8; }.q { padding: 12rpx; background: var(--accent-soft); }.card button { margin: 18rpx 10rpx 0 0; font-size: 24rpx; }
