<view class="page">
  <view class="card lesson-card" wx:if="{{lesson}}">
    <view class="eyebrow">本次导入课程</view>
    <view class="title">{{lesson.title}}</view>
    <view class="meta">{{lesson.lessonDate}}</view>
  </view>

  <view class="card message-card" wx:if="{{message}}">{{message}}</view>

  <view class="card computer-import-card" wx:if="{{isDevTools}}">
    <view class="computer-import-badge">推荐方式</view>
    <view class="section-title">从电脑导入整套资料</view>
    <view class="hint">先启动电脑导入助手，选择 JSON 和图片文件夹，再点击下面按钮。文件不需要发送到微信聊天。</view>
    <view class="computer-import-btn {{localBridgeLoading ? 'disabled-btn' : ''}}" bindtap="loadFromComputer">
      {{localBridgeLoading ? '正在从电脑读取...' : '从电脑导入'}}
    </view>
    <view class="local-bridge-status" wx:if="{{localBridgeProgressText}}">
      <view>{{localBridgeProgressText}}</view>
      <view class="progress-track local-progress-track" wx:if="{{localBridgeTotalCount}}">
        <view class="progress-fill" style="width: {{localBridgeTotalCount ? localBridgeCompletedCount * 100 / localBridgeTotalCount : 0}}%;"></view>
      </view>
      <view class="progress-count" wx:if="{{localBridgeTotalCount}}">{{localBridgeCompletedCount}} / {{localBridgeTotalCount}}</view>
    </view>
    <view class="local-bridge-error" wx:if="{{localBridgeError}}">{{localBridgeError}}</view>
  </view>

  <view class="card">
    <view class="section-title">{{isDevTools ? '其他导入方式：选择或粘贴错题 JSON' : '1. 选择或粘贴错题 JSON'}}</view>
    <view class="hint">{{isDevTools ? '如果电脑导入不可用，可以粘贴 JSON，或从微信聊天选择文件。' : '可以从微信聊天选择整理好的 JSON 文件，也可以直接粘贴 JSON 数组。'}}</view>
    <view class="file-row">
      <view class="ghost-btn compact-btn" bindtap="chooseJsonFile">从微信聊天选择 JSON</view>
      <view class="file-name">{{jsonFileName || '尚未选择文件'}}</view>
    </view>
    <textarea class="import-textarea" maxlength="-1" placeholder='粘贴 JSON 内容，例如：[{&quot;questionNo&quot;:&quot;1&quot;,&quot;questionText&quot;:&quot;...&quot;}]' value="{{importText}}" bindinput="onImportTextInput"></textarea>
    <view class="preview">
      <block wx:if="{{jsonValid}}">已识别 {{previewCount}} 道错题</block>
      <block wx:else>{{importText ? '请检查 JSON 格式' : '请选择文件或粘贴内容'}}</block>
    </view>
  </view>

  <view class="card">
    <view class="section-title">{{isDevTools ? '其他导入方式：选择题目截图' : '2. 选择题目截图'}}</view>
    <view class="hint">{{isDevTools ? '仅在电脑导入没有读取完整时使用。' : '可多次从微信聊天选择，图片会自动合并；系统匹配文件名时不区分大小写。'}}</view>
    <view class="file-row image-actions">
      <view class="ghost-btn compact-btn" bindtap="chooseImages">从微信聊天选择图片</view>
      <view class="text-action" wx:if="{{selectedImageCount}}" bindtap="clearSelectedImages">清空已选</view>
    </view>

    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value">{{previewCount}}</view>
        <view class="stat-label">错题数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{expectedImageCount}}</view>
        <view class="stat-label">应有截图</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{selectedImageCount}}</view>
        <view class="stat-label">已选图片</view>
      </view>
      <view class="stat-item {{hasDeclaredImages && matchedImageCount !== expectedImageCount ? 'stat-warning' : 'stat-ready'}}">
        <view class="stat-value">{{matchedImageCount}}</view>
        <view class="stat-label">已匹配</view>
      </view>
    </view>

    <view class="legacy-note" wx:if="{{jsonValid && !hasDeclaredImages}}">这份 JSON 不包含截图信息，将只导入文字内容。</view>
    <view class="missing-box" wx:if="{{missingImageNames.length}}">
      <view class="missing-title">缺少 {{missingImageNames.length}} 张截图：</view>
      <view class="missing-name" wx:for="{{missingImageNames}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="card progress-card" wx:if="{{uploadProgressText}}">
    <view class="progress-title">{{uploadProgressText}}</view>
    <block wx:if="{{importTotalCount}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{importTotalCount ? importedItemCount * 100 / importTotalCount : 0}}%;"></view>
      </view>
      <view class="progress-count">{{importedItemCount}} / {{importTotalCount}}</view>
    </block>
    <block wx:else wx:if="{{uploadTotalCount}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{uploadTotalCount ? uploadedImageCount * 100 / uploadTotalCount : 0}}%;"></view>
      </view>
      <view class="progress-count">{{uploadedImageCount}} / {{uploadTotalCount}}</view>
    </block>
  </view>

  <view class="primary-btn {{importing || !canImport ? 'disabled-btn' : ''}}" bindtap="importMistakes">
    {{importing ? '正在导入...' : '开始导入'}}
  </view>
</view>
