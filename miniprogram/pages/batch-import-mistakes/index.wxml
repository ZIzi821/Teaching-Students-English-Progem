<view class="page">
  <view class="card lesson-card" wx:if="{{lesson}}">
    <view class="eyebrow">本次导入课程</view>
    <view class="title">{{lesson.title}}</view>
    <view class="meta">{{lesson.lessonDate}}</view>
  </view>

  <view class="card message-card" wx:if="{{message}}">{{message}}</view>

  <view class="card">
    <view class="section-title">粘贴错题导入内容</view>
    <view class="hint">把课件发给我后，我会返回可直接粘贴到这里的内容。</view>
    <textarea class="import-textarea" placeholder='粘贴 JSON 内容，例如：[{"questionNo":"1","questionText":"...","correctAnswer":"..."}]' value="{{importText}}" bindinput="onImportTextInput"></textarea>
    <view class="preview">{{previewCount ? '已识别 ' + previewCount + ' 道错题' : '等待粘贴有效内容'}}</view>
  </view>

  <view class="primary-btn" bindtap="importMistakes">确认批量导入</view>
</view>
