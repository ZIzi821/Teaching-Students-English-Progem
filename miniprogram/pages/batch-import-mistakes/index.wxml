<view class="page">
  <view class="card lesson-card" wx:if="{{lesson}}">
    <view class="eyebrow">本次导入课程</view>
    <view class="title">{{lesson.title}}</view>
    <view class="meta">{{lesson.lessonDate}}</view>
  </view>

  <view class="card message-card" wx:if="{{message}}">{{message}}</view>

  <view class="card computer-import-card" wx:if="{{isDevTools}}">
    <view class="computer-import-badge">推荐方式</view>
    <view class="section-title">从电脑读取错题 JSON</view>
    <view class="hint">先启动电脑导入助手并选择 JSON，再点击下面按钮。错题图片不再上传或保存。</view>
    <view class="computer-import-btn {{localBridgeLoading ? 'disabled-btn' : ''}}" bindtap="loadFromComputer">
      {{localBridgeLoading ? '正在从电脑读取...' : '从电脑导入'}}
    </view>
    <view class="local-bridge-status" wx:if="{{localBridgeProgressText}}">{{localBridgeProgressText}}</view>
    <view class="local-bridge-error" wx:if="{{localBridgeError}}">{{localBridgeError}}</view>
  </view>

  <view class="card">
    <view class="section-title">{{isDevTools ? '其他导入方式：选择或粘贴错题 JSON' : '选择或粘贴错题 JSON'}}</view>
    <view class="hint">每道错题必须包含完整的 questionText；长文章、整组小题和全部选项要放在同一条记录中。</view>
    <view class="file-row">
      <view class="ghost-btn compact-btn" bindtap="chooseJsonFile">从微信聊天选择 JSON</view>
      <view class="file-name">{{jsonFileName || '尚未选择文件'}}</view>
    </view>
    <textarea class="import-textarea" maxlength="-1" placeholder='粘贴 JSON 内容，例如：[{&quot;questionNo&quot;:&quot;1&quot;,&quot;questionText&quot;:&quot;完整题干和选项&quot;,&quot;correctAnswer&quot;:&quot;B&quot;}]' value="{{importText}}" bindinput="onImportTextInput"></textarea>
    <view class="preview">
      <block wx:if="{{jsonValid}}">已识别 {{previewCount}} 道错题</block>
      <block wx:else>{{importText ? '请检查 JSON 格式' : '请选择文件或粘贴内容'}}</block>
    </view>
    <view class="missing-box" wx:if="{{missingQuestionTextNumbers.length}}">
      第 {{missingQuestionTextLabel}} 条缺少完整题目文字，暂时不能导入。
    </view>
  </view>

  <view class="card progress-card" wx:if="{{progressText}}">
    <view class="progress-title">{{progressText}}</view>
    <view class="progress-track" wx:if="{{importTotalCount}}">
      <view class="progress-fill" style="width: {{importTotalCount ? importedItemCount * 100 / importTotalCount : 0}}%;"></view>
    </view>
    <view class="progress-count" wx:if="{{importTotalCount}}">{{importedItemCount}} / {{importTotalCount}}</view>
  </view>

  <view class="primary-btn {{importing || !canImport ? 'disabled-btn' : ''}}" bindtap="importMistakes">
    {{importing ? '正在导入...' : '开始导入'}}
  </view>
</view>
