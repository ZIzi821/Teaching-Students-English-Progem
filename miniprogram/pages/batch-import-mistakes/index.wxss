.lesson-card {
  background: var(--accent-soft);
}

.computer-import-card {
  border: 2rpx solid var(--accent-line);
  background: var(--accent-soft);
}

.computer-import-badge {
  display: inline-flex;
  margin-bottom: 12rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.computer-import-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.local-bridge-status,
.local-bridge-error {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.local-bridge-status {
  color: var(--accent);
  background: rgba(255, 255, 255, 0.72);
}

.local-bridge-error {
  color: var(--danger);
  background: var(--danger-soft);
}

.eyebrow,
.meta,
.hint,
.preview,
.file-name,
.progress-count {
  color: var(--ink-2);
  font-size: 26rpx;
}

.title {
  margin: 10rpx 0;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
}

.section-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.hint {
  margin: 12rpx 0 20rpx;
  line-height: 1.6;
}

.file-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 18rpx;
}

.compact-btn {
  flex: 0 0 auto;
  min-height: 68rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.file-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.import-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 360rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.preview {
  margin-top: 16rpx;
}

.missing-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.missing-box {
  color: var(--warn);
  background: var(--warn-soft);
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
}

.progress-card {
  color: var(--accent);
  background: var(--accent-soft);
}

.progress-title {
  overflow-wrap: anywhere;
  font-size: 30rpx;
  font-weight: 600;
}

.progress-track {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
  transition: width 0.2s ease;
}

.progress-count {
  margin-top: 8rpx;
  text-align: right;
}

.disabled-btn {
  opacity: 0.5;
}
