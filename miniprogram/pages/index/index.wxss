.home-page {
  gap: 24rpx;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: #dff0e8;
}

.error-tip {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 24rpx;
  line-height: 1.5;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #587468;
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  color: #243f35;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 16rpx;
  color: #52635b;
  font-size: 28rpx;
  line-height: 1.7;
}

.stats-row {
  display: flex;
  gap: 18rpx;
  margin: 26rpx 0;
}

.stat-card {
  flex: 1;
  padding: 24rpx 10rpx;
  border-radius: 18rpx;
  background: #fffdfa;
  text-align: center;
}

.stat-number {
  color: #4f8f73;
  font-size: 42rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: #817669;
  font-size: 24rpx;
}

.home-progress {
  height: 18rpx;
  margin: -8rpx 0 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.home-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 34rpx;
}

.actions .ghost-btn {
  flex: 1;
  min-width: 240rpx;
}

.actions .primary-btn {
  width: 100%;
}

.teacher-progress-section {
  margin-bottom: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #3d352e;
  font-size: 32rpx;
  font-weight: 700;
}

.student-progress-card {
  margin-bottom: 18rpx;
}

.student-progress-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.student-progress-name {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.student-progress-grade {
  margin-top: 6rpx;
  color: #817669;
  font-size: 24rpx;
}

.student-progress-percent {
  color: #4f8f73;
  font-size: 30rpx;
  font-weight: 700;
}

.student-progress-text {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
}

.student-progress-bar {
  height: 16rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.student-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.lesson-card {
  margin-bottom: 18rpx;
}

.lesson-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.lesson-meta {
  color: #817669;
  font-size: 24rpx;
  white-space: nowrap;
}

.lesson-summary {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
  line-height: 1.6;
}

.student-line {
  margin-top: 12rpx;
  color: #4f8f73;
  font-size: 24rpx;
}

.empty {
  padding: 30rpx 0;
  color: #817669;
  text-align: center;
}

.env-tip {
  margin-top: 24rpx;
  color: #9b8f81;
  font-size: 22rpx;
  text-align: center;
}
