.home-page {
  gap: 24rpx;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: #dff0e8;
}

.error-tip {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 24rpx;
  line-height: 1.5;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #587468;
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  color: #243f35;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 16rpx;
  color: #52635b;
  font-size: 28rpx;
  line-height: 1.7;
}

.stats-row {
  display: flex;
  gap: 18rpx;
  margin: 26rpx 0;
}

.stat-card {
  flex: 1;
  padding: 24rpx 10rpx;
  border-radius: 18rpx;
  background: #fffdfa;
  text-align: center;
}

.stat-number {
  color: #4f8f73;
  font-size: 42rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: #817669;
  font-size: 24rpx;
}

.home-progress {
  height: 18rpx;
  margin: -8rpx 0 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.home-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.home-vocabulary-card {
  margin-top: -4rpx;
  background: linear-gradient(135deg, #fffdfa 0%, #e8f4ee 100%);
}

.home-vocabulary-top,
.student-vocabulary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.home-vocabulary-title {
  color: #2d4f42;
  font-size: 30rpx;
  font-weight: 700;
}

.home-vocabulary-hint,
.student-vocabulary-note {
  margin-top: 7rpx;
  color: #71675c;
  font-size: 23rpx;
}

.home-vocabulary-count,
.student-vocabulary-count {
  flex-shrink: 0;
  color: #326d56;
  font-size: 30rpx;
  font-weight: 700;
}

.home-vocabulary-progress,
.student-vocabulary-bar {
  height: 15rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dfe9e2;
}

.home-vocabulary-progress-fill,
.student-vocabulary-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.home-vocabulary-challenge {
  margin-top: 18rpx;
  color: #326d56;
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.next-booking-card {
  border-color: #dfd3c3;
  background: #fffaf0;
}

.next-booking-eyebrow {
  color: #8a6730;
  font-size: 22rpx;
  font-weight: 700;
}

.next-booking-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 10rpx;
}

.next-booking-time {
  color: #3d352e;
  font-size: 30rpx;
  font-weight: 700;
}

.next-booking-student,
.next-booking-meeting {
  margin-top: 7rpx;
  color: #71675c;
  font-size: 23rpx;
}

.next-booking-link {
  flex-shrink: 0;
  color: #326d56;
  font-size: 24rpx;
  font-weight: 700;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 34rpx;
}

.actions .ghost-btn {
  flex: 1;
  min-width: 240rpx;
}

.management-title {
  width: 100%;
  margin-top: 4rpx;
  color: #817669;
  font-size: 23rpx;
  font-weight: 600;
}

.management-grid,
.student-action-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.management-grid .ghost-btn,
.student-action-grid .ghost-btn {
  min-width: 0;
  min-height: 76rpx;
  font-size: 27rpx;
}

.actions .primary-btn {
  width: 100%;
}

.teacher-progress-section {
  margin-bottom: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #3d352e;
  font-size: 32rpx;
  font-weight: 700;
}

.student-progress-card {
  margin-bottom: 18rpx;
}

.student-progress-card-hover {
  background: #f7f0e5;
}

.student-progress-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.student-progress-name {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.student-progress-grade {
  margin-top: 6rpx;
  color: #817669;
  font-size: 24rpx;
}

.student-progress-percent {
  color: #4f8f73;
  font-size: 30rpx;
  font-weight: 700;
}

.student-progress-text {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
}

.student-progress-link {
  margin-top: 16rpx;
  color: #326d56;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.student-progress-bar {
  height: 16rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.student-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.student-vocabulary-row {
  align-items: center;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee4d6;
}

.student-vocabulary-label {
  color: #3f584d;
  font-size: 25rpx;
  font-weight: 700;
}

.student-vocabulary-count {
  font-size: 26rpx;
}

.student-vocabulary-bar {
  height: 12rpx;
  margin-top: 12rpx;
}

.lesson-card {
  margin-bottom: 18rpx;
}

.lesson-card-hover {
  background: #f7f0e5;
}

.lesson-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.lesson-meta {
  color: #817669;
  font-size: 24rpx;
  white-space: nowrap;
}

.lesson-summary {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
  line-height: 1.6;
}

.student-line {
  margin-top: 12rpx;
  color: #4f8f73;
  font-size: 24rpx;
}

.empty {
  padding: 30rpx 0;
  color: #817669;
  text-align: center;
}

.env-tip {
  margin-top: 24rpx;
  color: #9b8f81;
  font-size: 22rpx;
  text-align: center;
}
