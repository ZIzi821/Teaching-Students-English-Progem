.has-teacher-tabbar,
.has-student-tabbar {
  padding-bottom: 200rpx;
}

.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.preview-banner-main {
  min-width: 0;
  flex: 1;
}

.preview-banner-title {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.preview-banner-hint {
  color: var(--ink-2);
  font-size: 22rpx;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.home-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 8rpx 4rpx 32rpx;
}

.home-head-main {
  min-width: 0;
  flex: 1;
}

.home-kicker {
  color: var(--ink-3);
  font-size: 24rpx;
}

.home-title {
  margin-top: 4rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.home-side-entry {
  flex-shrink: 0;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface);
  font-size: 24rpx;
}

.student-switcher {
  margin-bottom: 24rpx;
}

.home-avatar {
  display: flex;
  flex: 0 0 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.home-error {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 24rpx;
}

.home-next {
  padding: 32rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.home-next-kicker {
  font-size: 24rpx;
  opacity: 0.8;
}

.home-next-title {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.home-next-btn {
  display: flex;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.home-empty-action,
.home-empty {
  padding: 32rpx 24rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 24rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}

.home-notice {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid var(--warn-line);
  border-radius: 24rpx;
  background: var(--warn-soft);
}

.home-notice-head,
.home-notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
}

.home-notice-item {
  border-top: 1rpx solid var(--warn-line);
}

.home-notice-title {
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 600;
}

.home-reminder-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.home-inline-chip {
  margin-right: 8rpx;
}

.teacher-homework-dismiss {
  flex-shrink: 0;
  color: var(--warn);
  font-size: 24rpx;
}

.teacher-homework-link {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.notice-action-pressed {
  opacity: 0.6;
}

.home-step {
  display: flex;
  flex: 0 0 44rpx;
  height: 44rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--accent);
  border-radius: 50%;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.home-step-done {
  color: var(--on-fill);
  background: var(--accent);
}

.home-progress-row {
  padding: 24rpx 28rpx;
}

.home-progress-text {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
}

.home-progress-row + .ui-row {
  border-top: 1rpx solid var(--line);
}

.lesson-progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-tone-near-end .ui-bar-fill,
.progress-tone-complete .ui-bar-fill {
  background: var(--warn-fill);
}

.home-link {
  justify-content: space-between;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
}

.home-link::after {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  margin-right: 4rpx;
  border-top: 3rpx solid var(--line-strong);
  border-right: 3rpx solid var(--line-strong);
  content: "";
  transform: rotate(45deg);
}

.home-todo-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding: 28rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.home-todo-cell {
  text-align: center;
}

.home-todo-number {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.home-todo-label {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.home-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.home-section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-right: 4rpx;
}

.home-section-link {
  color: var(--accent);
  font-weight: 500;
}

.home-student,
.home-lesson {
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--line);
}

.home-student:first-child,
.home-lesson:first-child {
  border-top: 0;
}

.home-student-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.home-student-grade {
  margin-left: 12rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 400;
}

.home-student .ui-bar {
  margin-top: 16rpx;
}

.home-lesson-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.home-lesson-title {
  min-width: 0;
  flex: 1;
}

.home-lesson-summary {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 24rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.home-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.home-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 40rpx 4rpx 0;
  color: var(--ink-3);
  font-size: 24rpx;
}

.home-identity-exit {
  flex-shrink: 0;
  color: var(--danger);
}
