.home-page {
  gap: 24rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.has-student-tabbar {
  padding-bottom: 180rpx;
}

.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #b9d8c8;
  border-radius: 20rpx;
  background: #edf7f2;
}

.preview-banner > view:first-child {
  min-width: 0;
  flex: 1;
}

.preview-banner-title {
  color: #285b47;
  font-size: 26rpx;
  font-weight: 800;
}

.preview-banner-hint {
  margin-top: 7rpx;
  color: #668073;
  font-size: 21rpx;
  line-height: 1.45;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 13rpx 16rpx;
  border-radius: 13rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 22rpx;
  font-weight: 700;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: #dff0e8;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-topline .eyebrow {
  min-width: 0;
  margin-bottom: 0;
}

.student-side-entry {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(50, 109, 86, 0.2);
  border-radius: 999rpx;
  color: #326d56;
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 700;
}

.student-side-arrow {
  margin-left: 4rpx;
  color: #6c8177;
  font-weight: 500;
}

.hero .title {
  margin-top: 12rpx;
}

.student-switcher {
  margin-top: -8rpx;
  border-color: #d6e8de;
  background: linear-gradient(145deg, #fffdfa 0%, #f1f8f4 100%);
}

.student-switcher-head,
.student-switcher-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.student-switcher-title {
  color: #2d4f42;
  font-size: 29rpx;
  font-weight: 700;
}

.student-switcher-hint {
  margin-top: 7rpx;
  color: #71675c;
  font-size: 22rpx;
  line-height: 1.45;
}

.student-switcher-close {
  flex-shrink: 0;
  color: #65796f;
  font-size: 22rpx;
}

.student-switcher-list {
  margin-top: 20rpx;
}

.student-switcher-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #e2ebe5;
}

.student-switcher-avatar {
  display: flex;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  border-radius: 18rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 25rpx;
  font-weight: 700;
}

.student-switcher-main {
  min-width: 0;
  flex: 1;
}

.student-switcher-name {
  color: #2f2a24;
  font-size: 27rpx;
  font-weight: 700;
}

.student-switcher-grade {
  margin-top: 4rpx;
  color: #817669;
  font-size: 21rpx;
}

.student-switcher-link {
  flex-shrink: 0;
  color: #326d56;
  font-size: 22rpx;
  font-weight: 700;
}

.error-tip {
  margin: 20rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 24rpx;
  line-height: 1.5;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #587468;
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  color: #243f35;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 16rpx;
  color: #52635b;
  font-size: 28rpx;
  line-height: 1.7;
}

.stats-row {
  display: flex;
  gap: 18rpx;
  margin: 26rpx 0;
}

.stat-card {
  flex: 1;
  padding: 24rpx 10rpx;
  border-radius: 18rpx;
  background: #fffdfa;
  text-align: center;
}

.stat-number {
  color: #4f8f73;
  font-size: 42rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 6rpx;
  color: #817669;
  font-size: 24rpx;
}

.home-progress {
  position: relative;
  height: 18rpx;
  margin: -8rpx 0 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.home-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
  transition: width 0.25s ease, background 0.25s ease;
}

.today-plan-card {
  padding: 24rpx;
  border-color: #e6dccf;
  background: #fffdfa;
}

.today-plan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.today-plan-title {
  color: #302b26;
  font-size: 32rpx;
  font-weight: 800;
}

.today-plan-hint {
  margin-top: 6rpx;
  color: #817669;
  font-size: 22rpx;
}

.today-plan-time {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #edf7f2;
  font-size: 20rpx;
}

.today-plan-step {
  display: flex;
  align-items: center;
  gap: 17rpx;
  margin-top: 12rpx;
  padding: 22rpx 18rpx;
  border-radius: 17rpx;
}

.plan-step-green {
  background: #e8f4ee;
}

.plan-step-sand {
  background: #f7f0e5;
}

.plan-step-gold {
  background: #fff3d9;
}

.plan-step-completed {
  opacity: 0.72;
}

.plan-step-completed .today-plan-number {
  background: #6e9a85;
}

.today-plan-number {
  display: flex;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  border-radius: 50%;
  color: #fff;
  background: #4f8f73;
  font-size: 25rpx;
  font-weight: 800;
}

.plan-step-sand .today-plan-number {
  background: #bd873c;
}

.plan-step-gold .today-plan-number {
  background: #d09a3e;
}

.today-plan-copy {
  min-width: 0;
  flex: 1;
}

.today-plan-step-title {
  color: #2f3f38;
  font-size: 26rpx;
  font-weight: 800;
}

.today-plan-step-hint {
  margin-top: 6rpx;
  color: #746b60;
  font-size: 21rpx;
  line-height: 1.45;
}

.today-plan-action {
  flex-shrink: 0;
  color: #39765d;
  font-size: 21rpx;
  font-weight: 800;
}

.home-vocabulary-card {
  margin-top: -4rpx;
  background: linear-gradient(135deg, #fffdfa 0%, #e8f4ee 100%);
}

.home-vocabulary-top,
.student-vocabulary-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.home-vocabulary-title {
  color: #2d4f42;
  font-size: 30rpx;
  font-weight: 700;
}

.home-vocabulary-hint,
.student-vocabulary-note {
  margin-top: 7rpx;
  color: #71675c;
  font-size: 23rpx;
}

.home-vocabulary-count,
.student-vocabulary-count {
  flex-shrink: 0;
  color: #326d56;
  font-size: 30rpx;
  font-weight: 700;
}

.home-vocabulary-progress,
.student-vocabulary-bar {
  height: 15rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #dfe9e2;
}

.home-vocabulary-progress-fill,
.student-vocabulary-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.home-vocabulary-challenge {
  margin-top: 18rpx;
  color: #326d56;
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
}

.pending-homework-card {
  border-color: #e1c990;
  background: linear-gradient(145deg, #fff7df 0%, #fffdfa 100%);
}

.pending-homework-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.pending-homework-kicker {
  color: #986b27;
  font-size: 21rpx;
  font-weight: 800;
}

.pending-homework-title {
  margin-top: 7rpx;
  color: #3e3529;
  font-size: 29rpx;
  font-weight: 800;
}

.pending-homework-link {
  flex-shrink: 0;
  color: #39765d;
  font-size: 23rpx;
  font-weight: 700;
}

.pending-homework-task {
  margin-top: 14rpx;
  color: #6f6251;
  font-size: 23rpx;
  line-height: 1.5;
}

.teacher-homework-notice-card {
  border-color: #cfe4d9;
  background: linear-gradient(145deg, #f5fbf7 0%, #edf7f2 100%);
}

.teacher-homework-notice-head,
.teacher-homework-notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.teacher-homework-notice-kicker {
  color: #4c8a70;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.teacher-homework-notice-title {
  margin-top: 6rpx;
  color: #203f33;
  font-size: 30rpx;
  font-weight: 700;
}

.teacher-homework-notice-count {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #347157;
  background: #dcefe6;
  font-size: 22rpx;
}

.teacher-homework-notice-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 12rpx;
}

.teacher-homework-dismiss {
  padding: 8rpx 4rpx;
  color: #39765d;
  font-size: 22rpx;
  font-weight: 700;
}

.teacher-homework-notice-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #d8e8df;
}

.teacher-homework-notice-item > view:first-child {
  min-width: 0;
  flex: 1;
}

.teacher-homework-student {
  color: #2f493f;
  font-size: 25rpx;
  font-weight: 600;
}

.student-reminder-badge {
  display: inline-flex;
  margin-right: 9rpx;
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff0cf;
  font-size: 18rpx;
  font-weight: 700;
  vertical-align: middle;
}

.teacher-homework-time {
  margin-top: 6rpx;
  color: #75837c;
  font-size: 21rpx;
}

.student-reminder-text {
  color: #4f5f57;
  white-space: pre-wrap;
  word-break: break-word;
}

.teacher-homework-link {
  flex-shrink: 0;
  color: #3f8065;
  font-size: 22rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 34rpx;
}

.actions .ghost-btn {
  flex: 1;
  min-width: 240rpx;
}

.management-title {
  width: 100%;
  margin-top: 4rpx;
  color: #817669;
  font-size: 23rpx;
  font-weight: 600;
}

.management-grid,
.student-action-grid {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.management-grid .ghost-btn,
.student-action-grid .ghost-btn {
  min-width: 0;
  min-height: 76rpx;
  font-size: 27rpx;
}

.actions .primary-btn {
  width: 100%;
}

.french-entry-btn {
  width: 100%;
  min-height: 68rpx;
  font-size: 27rpx;
}

.teacher-progress-section {
  margin-bottom: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #3d352e;
  font-size: 32rpx;
  font-weight: 700;
}

.student-progress-card {
  margin-bottom: 18rpx;
}

.student-progress-card-hover {
  background: #f7f0e5;
}

.student-progress-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.student-progress-name {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.student-progress-grade {
  margin-top: 6rpx;
  color: #817669;
  font-size: 24rpx;
}

.student-progress-percent {
  color: #4f8f73;
  font-size: 30rpx;
  font-weight: 700;
}

.progress-number-near-end,
.progress-number-complete {
  color: #a87532;
}

.student-progress-text {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
}

.student-progress-link {
  margin-top: 16rpx;
  color: #326d56;
  font-size: 23rpx;
  font-weight: 700;
  text-align: right;
}

.student-progress-bar {
  position: relative;
  height: 16rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.student-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
  transition: width 0.25s ease, background 0.25s ease;
}

.lesson-progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-tone-near-end .home-progress-fill,
.progress-tone-near-end .student-progress-fill {
  background: #c99a52;
}

.progress-tone-complete .home-progress-fill,
.progress-tone-complete .student-progress-fill {
  background: #b98743;
}

.student-vocabulary-row {
  align-items: center;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee4d6;
}

.student-vocabulary-label {
  color: #3f584d;
  font-size: 25rpx;
  font-weight: 700;
}

.student-vocabulary-count {
  font-size: 26rpx;
}

.student-vocabulary-bar {
  height: 12rpx;
  margin-top: 12rpx;
}

.lesson-card {
  margin-bottom: 18rpx;
}

.lesson-card-hover {
  background: #f7f0e5;
}

.lesson-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.lesson-meta {
  color: #817669;
  font-size: 24rpx;
  white-space: nowrap;
}

.lesson-summary {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 26rpx;
  line-height: 1.6;
}

.institution-course-note {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  color: #7c6b55;
  background: #f7eedf;
  font-size: 20rpx;
}

.institution-course-note text {
  color: #76562f;
  font-weight: 800;
}

.lesson-task-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9rpx;
  margin-top: 12rpx;
}

.lesson-task-badge {
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  color: #6e5b43;
  background: #f2e6d4;
  font-size: 20rpx;
}

.recording-task-badge {
  color: #39765d;
  background: #e9f4ee;
}

.homework-done-badge {
  color: #39765d;
  background: #dceee5;
}

.homework-waiting-badge {
  color: #94692e;
  background: #fff0cf;
}

.deadline-upcoming {
  color: #4f7462;
  background: #e8f2ed;
}

.deadline-today {
  color: #8a6730;
  background: #ffedc2;
}

.deadline-overdue,
.deadline-late {
  color: #985148;
  background: #fae6e4;
}

.student-line {
  margin-top: 12rpx;
  color: #4f8f73;
  font-size: 24rpx;
}

.empty {
  padding: 30rpx 0;
  color: #817669;
  text-align: center;
}

.env-tip {
  margin-top: 24rpx;
  color: #9b8f81;
  font-size: 22rpx;
  text-align: center;
}
.french-primary-btn {
  background: linear-gradient(135deg, #315a83 0%, #a65360 100%);
}

.disabled-home-action {
  width: 100%;
  padding: 22rpx;
  border-radius: 16rpx;
  color: #817669;
  background: #f1ede6;
  font-size: 25rpx;
  text-align: center;
}

.identity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 24rpx;
}

.identity-card > view:first-child {
  min-width: 0;
  flex: 1;
}

.identity-title {
  color: #8a7e70;
  font-size: 22rpx;
}

.identity-value {
  margin-top: 6rpx;
  color: #3c5047;
  font-size: 28rpx;
  font-weight: 700;
}

.identity-hint {
  margin-top: 8rpx;
  color: #897e72;
  font-size: 21rpx;
  line-height: 1.45;
}

.identity-exit {
  flex-shrink: 0;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  color: #985447;
  background: #f8e9e5;
  font-size: 24rpx;
  font-weight: 700;
}
