<view class="page home-page {{isTeacher ? 'has-teacher-tabbar' : ''}} {{isStudent ? 'has-student-tabbar' : ''}}">
  <view class="preview-banner" wx:if="{{isTeacherPreview}}">
    <view>
      <view class="preview-banner-title">正在查看 {{currentStudent.name}} 的真实学生首页</view>
      <view class="preview-banner-hint">页面和学生端一致；可以体验流程，但不会写入学习、作业或录音记录。</view>
    </view>
    <view class="preview-banner-action" bindtap="goBackToTeacher">返回教师端</view>
  </view>
  <view class="hero">
    <view class="hero-topline">
      <view class="eyebrow">{{teacherName}} · English Class</view>
      <view class="student-side-entry" wx:if="{{isTeacher}}" bindtap="toggleStudentSwitcher">
        学生端 <text class="student-side-arrow">{{showStudentSwitcher ? '收起' : '进入'}}</text>
      </view>
    </view>
    <view class="title">{{homeTitle}}</view>
    <view class="subtitle" wx:if="{{isTeacher}}">先选一位学生，再查看课程、错题和学习情况。</view>
    <view class="subtitle" wx:if="{{isStudent}}">{{currentStudent.name}}，{{studentHomeSubtitle}}</view>
    <view class="subtitle" wx:if="{{isGuest}}">请输入朱老师给你的访问码。</view>
  </view>

  <view class="card student-switcher" wx:if="{{isTeacher && showStudentSwitcher}}">
    <view class="student-switcher-head">
      <view>
        <view class="student-switcher-title">选择要查看的学生</view>
        <view class="student-switcher-hint">进入只读预览，不会改变学生的绑定或学习记录。</view>
      </view>
      <view class="student-switcher-close" bindtap="toggleStudentSwitcher">关闭</view>
    </view>
    <view class="student-switcher-list">
      <view class="student-switcher-item" wx:for="{{studentsProgress}}" wx:key="_id" data-id="{{item._id}}" bindtap="openStudentPreview">
        <view class="student-switcher-avatar">{{item.initial}}</view>
        <view class="student-switcher-main">
          <view class="student-switcher-name">{{item.name}}</view>
          <view class="student-switcher-grade">{{item.grade || '学生学习主页'}}</view>
        </view>
        <view class="student-switcher-link">查看界面 →</view>
      </view>
    </view>
  </view>

  <view class="error-tip" wx:if="{{errorMessage}}">{{errorMessage}}</view>

  <view class="stats-row" wx:if="{{isTeacher}}">
    <view class="stat-card">
      <view class="stat-number">{{stats.studentCount}}</view>
      <view class="stat-label">学生</view>
    </view>
    <view class="stat-card">
      <view class="stat-number">{{stats.mistakeCount}}</view>
      <view class="stat-label">错题</view>
    </view>
  </view>

  <view class="stats-row" wx:if="{{isStudent && (englishCourseEnabled || mistakeLearningEnabled)}}">
    <view class="stat-card" wx:if="{{englishCourseEnabled}}">
      <view class="stat-number">{{stats.progress.progressText}}</view>
      <view class="stat-label">我的课程进度</view>
    </view>
    <view class="stat-card" wx:if="{{mistakeLearningEnabled}}">
      <view class="stat-number">{{stats.mistakeCount}}</view>
      <view class="stat-label">我的错题</view>
    </view>
  </view>

  <view class="home-progress progress-tone-{{stats.progress.progressTone}}" wx:if="{{isStudent && englishCourseEnabled}}">
    <view class="home-progress-fill" style="width: {{stats.progress.progressPercent}}%;"></view>
    <view class="lesson-progress-marker" wx:if="{{stats.progress.showProgressMarker}}" style="left: {{stats.progress.progressMarkerPercent}}%;"></view>
  </view>

  <view class="card teacher-homework-notice-card" wx:if="{{isStudent && studentLearningActivities.length}}">
    <view class="teacher-homework-notice-head">
      <view>
        <view class="teacher-homework-notice-kicker">我的新动态</view>
        <view class="teacher-homework-notice-title">看看最近有什么新消息</view>
      </view>
      <view class="teacher-homework-notice-actions">
        <view class="teacher-homework-notice-count">{{studentLearningActivities.length}} 条</view>
        <view class="teacher-homework-dismiss" catchtap="dismissStudentLearningActivities">我看完了</view>
      </view>
    </view>
    <view
      class="teacher-homework-notice-item"
      wx:for="{{studentLearningActivities}}"
      wx:key="_id"
      data-activity-at="{{item.activityAtMs}}"
      data-lesson-id="{{item.lessonId}}"
      data-type="{{item.activityType}}"
      bindtap="goStudentLearningActivity"
    >
      <view>
        <view class="teacher-homework-student">
          <text class="student-reminder-badge" wx:if="{{item.activityType === 'teacherReminder'}}">老师提醒</text>{{item.title}}
        </view>
        <view class="teacher-homework-time {{item.activityType === 'teacherReminder' ? 'student-reminder-text' : ''}}">{{item.activityText}} · {{item.activityLabel}}</view>
      </view>
      <view class="teacher-homework-link">{{item.activityType === 'teacherReminder' ? '知道了' : '查看 →'}}</view>
    </view>
    <view class="teacher-homework-time" wx:if="{{isTeacherPreview}}">老师预览可以查看，但不会同步学生的已读状态。</view>
  </view>

  <view class="card today-plan-card" wx:if="{{isStudent && studentPlanSteps.length}}">
    <view class="today-plan-head">
      <view>
        <view class="today-plan-title">今天怎么学？</view>
        <view class="today-plan-hint">按顺序完成，每一步都很清楚</view>
      </view>
      <view class="today-plan-time">约 10～25 分钟</view>
    </view>
    <view
      class="today-plan-step plan-step-{{item.tone}} {{item.completed ? 'plan-step-completed' : ''}}"
      wx:for="{{studentPlanSteps}}"
      wx:key="action"
      data-action="{{item.action}}"
      bindtap="handlePlanStep"
    >
      <view class="today-plan-number">{{item.completed ? '✓' : item.number}}</view>
      <view class="today-plan-copy">
        <view class="today-plan-step-title">{{item.title}}</view>
        <view class="today-plan-step-hint">{{item.hint}}</view>
      </view>
      <view class="today-plan-action">{{item.actionLabel}}</view>
    </view>
  </view>

  <view class="card teacher-homework-notice-card" wx:if="{{isTeacher && learningActivityNotices.length}}">
    <view class="teacher-homework-notice-head">
      <view>
        <view class="teacher-homework-notice-kicker">英语学习动态</view>
        <view class="teacher-homework-notice-title">待查看的新动态</view>
      </view>
      <view class="teacher-homework-notice-actions">
        <view class="teacher-homework-notice-count">{{learningActivityNotices.length}} 条</view>
        <view class="teacher-homework-dismiss" catchtap="dismissLearningActivities">全部已看</view>
      </view>
    </view>
    <view
      class="teacher-homework-notice-item"
      wx:for="{{learningActivityNotices}}"
      wx:key="_id"
      data-lesson-id="{{item.lessonId}}"
      data-student-id="{{item.studentId}}"
      data-type="{{item.activityType}}"
      data-activity-at="{{item.activityAtMs}}"
      bindtap="goLearningActivity"
    >
      <view>
        <view class="teacher-homework-student">{{item.studentName || '学生'}} · {{item.title}}</view>
        <view class="teacher-homework-time">
          {{item.activityText}}<text wx:if="{{item.activityType === 'recording' && item.recordingCount > 1}}">（{{item.recordingCount}}份）</text> · {{item.activityLabel}}
        </view>
      </view>
      <view class="teacher-homework-link">查看 →</view>
    </view>
  </view>

  <view class="actions" wx:if="{{isTeacher}}">
    <view class="primary-btn" bindtap="goStudents">选择学生</view>
    <view class="ghost-btn french-entry-btn" bindtap="goFrenchLearning">法语学习</view>
    <view class="management-title">常用功能</view>
    <view class="management-grid">
      <view class="ghost-btn" bindtap="goAddLesson">记录课程</view>
      <view class="ghost-btn" bindtap="goAddMistake">快速记错题</view>
      <view class="ghost-btn" bindtap="goVocabularyDetail">学生词库</view>
      <view class="ghost-btn" bindtap="goAddStudent">添加学生</view>
    </view>
  </view>

  <view class="actions" wx:if="{{isStudent}}">
    <view class="primary-btn" wx:if="{{studentPrimaryAction}}" bindtap="handlePrimaryLearningAction">
      {{studentPrimaryAction.label}}
    </view>
    <view class="disabled-home-action" wx:else>老师暂时还没有开启学习功能</view>
    <view class="student-action-grid">
      <view class="ghost-btn" wx:if="{{currentStudent.vocabularyEnabled}}" bindtap="goVocabulary">单词学习记录</view>
      <view class="ghost-btn" wx:if="{{englishCourseEnabled}}" bindtap="goHomeworkTasks">全部课后任务</view>
      <view class="ghost-btn" wx:if="{{mistakeLearningEnabled}}" bindtap="goMistakeReview">错题复习</view>
      <view class="ghost-btn" wx:if="{{currentStudent.frenchLearningEnabled}}" bindtap="goFrenchLearning">法语学习</view>
    </view>
  </view>

  <view class="actions" wx:if="{{isGuest}}">
    <view class="primary-btn" bindtap="goBind">绑定学习账号</view>
  </view>

  <view class="teacher-progress-section" wx:if="{{isTeacher}}">
    <view class="section-title">学生学习进度</view>
    <view class="empty" wx:if="{{!studentsProgress.length}}">还没有学生进度。</view>
    <view class="card student-progress-card" wx:for="{{studentsProgress}}" wx:key="_id" data-id="{{item._id}}" bindtap="goStudentDetail" hover-class="student-progress-card-hover">
      <view class="student-progress-top">
        <view>
          <view class="student-progress-name">{{item.name}}</view>
          <view class="student-progress-grade">{{item.grade}}</view>
        </view>
        <view class="student-progress-percent progress-number-{{item.progressTone}}" wx:if="{{item.hasPlannedLessonCount}}">{{item.progressPercent}}%</view>
      </view>
      <view class="student-progress-text">{{item.progressLabel}}</view>
      <view class="student-progress-bar progress-tone-{{item.progressTone}}">
        <view class="student-progress-fill" style="width: {{item.progressPercent}}%;"></view>
        <view class="lesson-progress-marker" wx:if="{{item.showProgressMarker}}" style="left: {{item.progressMarkerPercent}}%;"></view>
      </view>
      <view class="student-vocabulary-row" wx:if="{{item.vocabularyPulse.enabled}}">
        <view>
          <view class="student-vocabulary-label">今日单词</view>
          <view class="student-vocabulary-note">
            {{item.vocabularyPulse.completed ? '今天已完成' : '还差 ' + item.vocabularyPulse.remainingCount + ' 个'}}
          </view>
        </view>
        <view class="student-vocabulary-count">{{item.vocabularyPulse.reviewedCount}} / {{item.vocabularyPulse.goal}}</view>
      </view>
      <view class="student-vocabulary-bar" wx:if="{{item.vocabularyPulse.enabled}}">
        <view class="student-vocabulary-fill" style="width: {{item.vocabularyPulse.progressPercent}}%;"></view>
      </view>
      <view class="student-progress-link">进入学习主页 →</view>
    </view>
  </view>

  <block wx:if="{{!isStudent || englishCourseEnabled}}">
    <view class="section-title">最近英语课</view>
    <view class="empty" wx:if="{{!recentLessons.length}}">还没有可以查看的课程。</view>
    <view class="card lesson-card" wx:for="{{recentLessons}}" wx:key="_id" data-id="{{item._id}}" bindtap="goLessonDetail" hover-class="lesson-card-hover">
      <view class="lesson-main">
        <view class="lesson-title">{{item.title}}</view>
        <view class="lesson-meta">{{item.subject}} · {{item.lessonDate}}</view>
      </view>
      <view class="institution-course-note" wx:if="{{item.institutionCourse}}"><text>机构课程</text>不计入个人课程进度</view>
      <view class="student-line" wx:if="{{isTeacher && item.studentName}}">学生：{{item.studentName}}</view>
      <view class="lesson-task-row" wx:if="{{item.homeworkTask || item.recordingTaskEnabled}}">
        <text class="lesson-task-badge" wx:if="{{item.homeworkTask}}">课后任务</text>
        <text class="lesson-task-badge recording-task-badge" wx:if="{{item.recordingTaskEnabled}}">录音任务</text>
        <text class="lesson-task-badge {{item.homeworkCompleted ? 'homework-done-badge' : 'homework-waiting-badge'}}">{{item.homeworkCompleted ? '学生已完成' : '等待完成'}}</text>
        <text class="lesson-task-badge deadline-{{item.homeworkSubmittedLate ? 'late' : item.homeworkDueStatus}}" wx:if="{{item.recordingTaskEnabled && (item.homeworkSubmittedLate || (!item.homeworkCompleted && !item.homeworkHasSubmission && item.homeworkDueLabel))}}">{{item.homeworkSubmittedLate ? '逾期提交' : item.homeworkDueLabel}}</text>
      </view>
      <view class="lesson-summary">{{item.masterySummary || item.summary}}</view>
    </view>
  </block>

  <view class="card identity-card" wx:if="{{(isTeacher || isStudent) && !isTeacherPreview}}">
    <view>
      <view class="identity-title">当前身份</view>
      <view class="identity-value">{{isTeacher ? '教师端' : currentStudent.name + '的学生端'}}</view>
      <view class="identity-hint">退出只解除当前微信的身份绑定，不会删除任何学习资料。</view>
    </view>
    <view class="identity-exit" bindtap="unbindIdentity">退出绑定</view>
  </view>
  <teacher-tabbar wx:if="{{isTeacher}}" current="home"></teacher-tabbar>
  <student-tabbar
    wx:if="{{isStudent}}"
    current="learning"
    mode="{{mode}}"
    preview-student-id="{{previewStudentId}}"
  ></student-tabbar>
</view>
