<view class="page home-page {{isTeacher ? 'has-teacher-tabbar' : ''}} {{isStudent ? 'has-student-tabbar' : ''}}">
  <view class="preview-banner" wx:if="{{isTeacherPreview}}">
    <view class="preview-banner-main">
      <view class="preview-banner-title">正在查看 {{currentStudent.name}} 的真实学生首页</view>
      <view class="preview-banner-hint">体验结果在预览页单独呈现</view>
    </view>
    <view class="preview-banner-action" hover-class="ui-pressed" bindtap="goBackToTeacher">返回教师端</view>
  </view>

  <view class="home-head">
    <view class="home-head-main">
      <block wx:if="{{isTeacher}}">
        <view class="home-kicker">{{teacherName}}</view>
        <view class="home-title">{{todoSummary.totalCount ? '还有 ' + todoSummary.totalCount + ' 项待办' : '待办已清空'}}</view>
      </block>
      <block wx:if="{{isStudent}}">
        <view class="home-kicker">{{homeTitle}}</view>
        <view class="home-title">{{currentStudent.name}}，你好</view>
      </block>
      <block wx:if="{{isGuest}}">
        <view class="home-kicker">{{homeTitle}}</view>
        <view class="home-title">输入访问码开始学习</view>
      </block>
    </view>
    <view class="home-side-entry" wx:if="{{isTeacher}}" hover-class="ui-pressed" bindtap="toggleStudentSwitcher">{{showStudentSwitcher ? '收起' : '学生端'}}</view>
  </view>

  <view class="ui-group student-switcher" wx:if="{{isTeacher && showStudentSwitcher}}">
    <view class="ui-row" wx:for="{{studentsProgress}}" wx:key="_id" data-id="{{item._id}}" hover-class="ui-pressed" bindtap="openStudentPreview">
      <view class="home-avatar">{{item.initial}}</view>
      <view class="ui-row-main">
        <view class="ui-row-title">{{item.name}}</view>
        <view class="ui-row-note">{{item.grade || '学生学习主页'}}</view>
      </view>
      <view class="ui-chevron"></view>
    </view>
  </view>

  <view class="home-error" wx:if="{{errorMessage}}">{{errorMessage}}</view>

  <!-- 学生：下一步 -->
  <block wx:if="{{isStudent}}">
    <view class="home-next" wx:if="{{studentPrimaryAction}}">
      <view class="home-next-kicker">下一步</view>
      <view class="home-next-title">{{studentHomeSubtitle}}</view>
      <view class="home-next-btn" hover-class="ui-pressed" bindtap="handlePrimaryLearningAction">{{studentPrimaryAction.label}}</view>
    </view>
    <view class="home-empty-action" wx:else>老师开启学习功能后，这里会显示学习入口</view>

    <view class="home-notice" wx:if="{{studentLearningActivities.length}}">
      <view class="home-notice-head">
        <view class="home-notice-title">我的新动态 · {{studentLearningActivities.length}} 条</view>
        <view class="teacher-homework-dismiss" hover-class="notice-action-pressed" catchtap="dismissStudentLearningActivities">我看完了</view>
      </view>
      <view class="home-notice-item" wx:for="{{studentLearningActivities}}" wx:key="_id" data-activity-at="{{item.activityAtMs}}" data-lesson-id="{{item.lessonId}}" data-type="{{item.activityType}}" bindtap="goStudentLearningActivity">
        <view class="ui-row-main">
          <view class="ui-row-title"><text class="ui-chip ui-chip-warn home-inline-chip" wx:if="{{item.activityType === 'teacherReminder'}}">老师提醒</text>{{item.title}}</view>
          <view class="ui-row-note {{item.activityType === 'teacherReminder' ? 'home-reminder-text' : ''}}">{{item.activityText}} · {{item.activityLabel}}</view>
        </view>
        <view class="teacher-homework-link" hover-class="notice-action-pressed">{{item.activityType === 'teacherReminder' ? '知道了' : '查看'}}</view>
      </view>
    </view>

    <block wx:if="{{studentPlanSteps.length}}">
      <view class="ui-section">今天怎么学？约 10～25 分钟</view>
      <view class="ui-group">
        <view class="ui-row" wx:for="{{studentPlanSteps}}" wx:key="action" data-action="{{item.action}}" hover-class="ui-pressed" bindtap="handlePlanStep">
          <view class="home-step {{item.completed ? 'home-step-done' : ''}}">{{item.completed ? '✓' : item.number}}</view>
          <view class="ui-row-main">
            <view class="ui-row-title">{{item.title}}</view>
            <view class="ui-row-note">{{item.hint}}</view>
          </view>
          <view class="ui-chevron"></view>
        </view>
      </view>
    </block>

    <block wx:if="{{englishCourseEnabled || mistakeLearningEnabled || currentStudent.vocabularyEnabled || currentStudent.frenchLearningEnabled}}">
      <view class="ui-section">我的学习</view>
      <view class="ui-group">
        <view class="home-progress-row progress-tone-{{stats.progress.progressTone}}" wx:if="{{englishCourseEnabled}}">
          <view class="home-progress-text"><text>课程进度</text><text class="ui-row-value">{{stats.progress.progressText}}</text></view>
          <view class="ui-bar">
            <view class="ui-bar-fill" style="width: {{stats.progress.progressPercent}}%;"></view>
            <view class="lesson-progress-marker" wx:if="{{stats.progress.showProgressMarker}}" style="left: {{stats.progress.progressMarkerPercent}}%;"></view>
          </view>
        </view>
        <view class="ui-row home-link" wx:if="{{englishCourseEnabled}}" hover-class="ui-pressed" bindtap="goHomeworkTasks">全部课后任务</view>
        <view class="ui-row home-link" wx:if="{{mistakeLearningEnabled}}" hover-class="ui-pressed" bindtap="goMistakeReview">错题复习 · {{stats.mistakeCount}} 题</view>
        <view class="ui-row home-link" wx:if="{{currentStudent.vocabularyEnabled}}" hover-class="ui-pressed" bindtap="goVocabulary">单词学习记录</view>
        <view class="ui-row home-link" wx:if="{{currentStudent.frenchLearningEnabled}}" hover-class="ui-pressed" bindtap="goFrenchLearning">法语学习</view>
      </view>
    </block>
  </block>

  <!-- 教师：待办与常用操作 -->
  <block wx:if="{{isTeacher}}">
    <view class="home-todo-grid" hover-class="ui-pressed" bindtap="goTodos">
      <view class="home-todo-cell"><view class="home-todo-number">{{todoSummary.recordingCount}}</view><view class="home-todo-label">待查录音</view></view>
      <view class="home-todo-cell"><view class="home-todo-number">{{todoSummary.homeworkCount}}</view><view class="home-todo-label">作业处理</view></view>
      <view class="home-todo-cell"><view class="home-todo-number">{{todoSummary.vocabularyCount}}</view><view class="home-todo-label">单词关注</view></view>
      <view class="home-todo-cell"><view class="home-todo-number">{{todoSummary.inactivityCount}}</view><view class="home-todo-label">学习关注</view></view>
    </view>

    <view class="home-actions">
      <view class="primary-btn" hover-class="ui-pressed" bindtap="goAddLesson">记录课程</view>
      <view class="ghost-btn" hover-class="ui-pressed" bindtap="goAddMistake">快速记错题</view>
    </view>

    <view class="home-notice" wx:if="{{learningActivityNotices.length}}">
      <view class="home-notice-head">
        <view class="home-notice-title">待查看的新动态 · {{learningActivityNotices.length}} 条</view>
        <view class="teacher-homework-dismiss" hover-class="notice-action-pressed" catchtap="dismissLearningActivities">全部已看</view>
      </view>
      <view class="home-notice-item" wx:for="{{learningActivityNotices}}" wx:key="_id" data-lesson-id="{{item.lessonId}}" data-student-id="{{item.studentId}}" data-type="{{item.activityType}}" data-activity-at="{{item.activityAtMs}}" bindtap="goLearningActivity">
        <view class="ui-row-main">
          <view class="ui-row-title">{{item.studentName || '学生'}} · {{item.title}}</view>
          <view class="ui-row-note">{{item.activityText}}<text wx:if="{{item.activityType === 'recording' && item.recordingCount > 1}}">（{{item.recordingCount}}份）</text> · {{item.activityLabel}}</view>
        </view>
        <view class="teacher-homework-link" hover-class="notice-action-pressed">{{item.actionLabel || '查看'}}</view>
      </view>
    </view>

    <view class="ui-section home-section-row"><text>学生 · {{stats.studentCount}} 人</text><text class="home-section-link" bindtap="goStudents">选择学生</text></view>
    <view class="home-empty" wx:if="{{!studentsProgress.length}}">添加学生后，这里显示学习进度。</view>
    <view class="ui-group" wx:if="{{studentsProgress.length}}">
      <view class="home-student" wx:for="{{studentsProgress}}" wx:key="_id" data-id="{{item._id}}" hover-class="ui-pressed" bindtap="goStudentDetail">
        <view class="home-student-top">
          <view class="ui-row-main">
            <view class="ui-row-title">{{item.name}}<text class="home-student-grade" wx:if="{{item.grade}}">{{item.grade}}</text></view>
            <view class="ui-row-note">{{item.progressLabel}}<text wx:if="{{item.vocabularyPulse.enabled}}"> · 今日单词 {{item.vocabularyPulse.completed ? '已完成' : item.vocabularyPulse.reviewedCount + '/' + item.vocabularyPulse.goal}}</text></view>
          </view>
          <view class="ui-chevron"></view>
        </view>
        <view class="ui-bar progress-tone-{{item.progressTone}}" wx:if="{{item.hasPlannedLessonCount}}">
          <view class="ui-bar-fill" style="width: {{item.progressPercent}}%;"></view>
          <view class="lesson-progress-marker" wx:if="{{item.showProgressMarker}}" style="left: {{item.progressMarkerPercent}}%;"></view>
        </view>
      </view>
    </view>

    <view class="ui-section">常用</view>
    <view class="ui-group">
      <view class="ui-row home-link" hover-class="ui-pressed" bindtap="goVocabularyDetail">学生词库</view>
      <view class="ui-row home-link" hover-class="ui-pressed" bindtap="goAddStudent">添加学生</view>
      <view class="ui-row home-link" hover-class="ui-pressed" bindtap="goFrenchLearning">法语学习</view>
    </view>
  </block>

  <view class="home-actions" wx:if="{{isGuest}}">
    <view class="primary-btn" hover-class="ui-pressed" bindtap="goBind">绑定学习账号</view>
  </view>

  <block wx:if="{{isTeacher || (isStudent && englishCourseEnabled) || isGuest}}">
    <view class="ui-section">最近英语课</view>
    <view class="home-empty" wx:if="{{!recentLessons.length}}">上完课后，这里显示课程记录。</view>
    <view class="ui-group" wx:if="{{recentLessons.length}}">
      <view class="home-lesson" wx:for="{{recentLessons}}" wx:key="_id" data-id="{{item._id}}" hover-class="ui-pressed" bindtap="goLessonDetail">
        <view class="home-lesson-top">
          <view class="ui-row-title home-lesson-title">{{item.title}}</view>
          <view class="ui-row-value">{{item.lessonDate}}</view>
        </view>
        <view class="ui-row-note" wx:if="{{isTeacher && item.studentName}}">{{item.studentName}} · {{item.subject}}</view>
        <view class="home-lesson-summary" wx:if="{{item.masterySummary || item.summary}}">{{item.masterySummary || item.summary}}</view>
        <view class="home-chips" wx:if="{{item.homeworkTask || item.recordingTaskEnabled || item.institutionCourse}}">
          <text class="ui-chip" wx:if="{{item.institutionCourse}}">机构课程 · 个人课程进度维持原数值</text>
          <text class="ui-chip" wx:if="{{item.homeworkTask}}">课后任务</text>
          <text class="ui-chip ui-chip-accent" wx:if="{{item.recordingTaskEnabled}}">录音任务</text>
          <text class="ui-chip {{item.homeworkCompleted ? 'ui-chip-accent' : 'ui-chip-warn'}}" wx:if="{{item.homeworkTask || item.recordingTaskEnabled}}">{{item.homeworkCompleted ? '学生已完成' : '等待完成'}}</text>
          <text class="ui-chip {{item.homeworkSubmittedLate || item.homeworkDueStatus === 'overdue' ? 'ui-chip-danger' : 'ui-chip-warn'}}" wx:if="{{item.recordingTaskEnabled && (item.homeworkSubmittedLate || (!item.homeworkCompleted && !item.homeworkHasSubmission && item.homeworkDueLabel))}}">{{item.homeworkSubmittedLate ? '逾期提交' : item.homeworkDueLabel}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="home-identity" wx:if="{{(isTeacher || isStudent) && !isTeacherPreview}}">
    <text>当前身份：{{isTeacher ? '教师端' : currentStudent.name + '的学生端'}}</text>
    <text class="home-identity-exit" bindtap="unbindIdentity">退出绑定</text>
  </view>

  <teacher-tabbar wx:if="{{isTeacher}}" current="home"></teacher-tabbar>
  <student-tabbar
    wx:if="{{isStudent}}"
    current="learning"
    mode="{{mode}}"
    preview-student-id="{{previewStudentId}}"
  ></student-tabbar>
</view>
