<view class="page home-page">
  <view class="hero">
    <view class="eyebrow">{{teacherName}} · English Class</view>
    <view class="title">朱老师英语课堂</view>
    <view class="subtitle" wx:if="{{isTeacher}}">先选择学生查看学习主页，再处理课程、错题和预约。</view>
    <view class="subtitle" wx:if="{{isStudent}}">{{currentStudent.name}}，从今天最重要的一项开始。</view>
    <view class="subtitle" wx:if="{{isGuest}}">请输入朱老师给你的专属 accessCode。</view>
  </view>

  <view class="error-tip" wx:if="{{errorMessage}}">{{errorMessage}}</view>

  <view class="stats-row" wx:if="{{isTeacher}}">
    <view class="stat-card">
      <view class="stat-number">{{stats.studentCount}}</view>
      <view class="stat-label">学生</view>
    </view>
    <view class="stat-card">
      <view class="stat-number">{{stats.mistakeCount}}</view>
      <view class="stat-label">错题</view>
    </view>
  </view>

  <view class="stats-row" wx:if="{{isStudent}}">
    <view class="stat-card">
      <view class="stat-number">{{stats.progress.progressText}}</view>
      <view class="stat-label">我的课程进度</view>
    </view>
    <view class="stat-card">
      <view class="stat-number">{{stats.mistakeCount}}</view>
      <view class="stat-label">我的错题</view>
    </view>
  </view>

  <view class="home-progress" wx:if="{{isStudent}}">
    <view class="home-progress-fill" style="width: {{stats.progress.progressPercent}}%;"></view>
  </view>

  <view class="card home-vocabulary-card" wx:if="{{isStudent && vocabularyPulse.enabled}}">
    <view class="home-vocabulary-top">
      <view>
        <view class="home-vocabulary-title">今日单词</view>
        <view class="home-vocabulary-hint">
          {{vocabularyPulse.completed ? '今天的目标已经完成' : '还差 ' + vocabularyPulse.remainingCount + ' 个完成今日目标'}}
        </view>
      </view>
      <view class="home-vocabulary-count">{{vocabularyPulse.reviewedCount}} / {{vocabularyPulse.goal}}</view>
    </view>
    <view class="home-vocabulary-progress">
      <view class="home-vocabulary-progress-fill" style="width: {{vocabularyPulse.progressPercent}}%;"></view>
    </view>
    <view class="home-vocabulary-challenge" bindtap="goVocabularyChallenge">六题巩固挑战 · 约 2 分钟 →</view>
  </view>

  <view class="card next-booking-card" wx:if="{{nextLessonBooking}}" bindtap="goNextLessonBooking">
    <view class="next-booking-eyebrow">下一节已确认课程</view>
    <view class="next-booking-main">
      <view>
        <view class="next-booking-time">{{nextLessonBooking.confirmedDate}} · {{nextLessonBooking.confirmedTime}}</view>
        <view class="next-booking-student" wx:if="{{isTeacher && nextLessonBooking.studentName}}">{{nextLessonBooking.studentName}}</view>
        <view class="next-booking-meeting" wx:if="{{nextLessonBooking.meetingNo}}">会议号：{{nextLessonBooking.meetingNo}}</view>
      </view>
      <view class="next-booking-link">查看 →</view>
    </view>
  </view>

  <view class="actions" wx:if="{{isTeacher}}">
    <view class="primary-btn" bindtap="goStudents">选择学生 · 查看学习主页</view>
    <view class="management-title">教师快捷管理</view>
    <view class="management-grid">
      <view class="ghost-btn" bindtap="goLessonBookings">处理预约</view>
      <view class="ghost-btn" bindtap="goAddLesson">记录课程</view>
      <view class="ghost-btn" bindtap="goAddMistake">快速记错题</view>
      <view class="ghost-btn" bindtap="goAddStudent">添加学生</view>
    </view>
  </view>

  <view class="actions" wx:if="{{isStudent}}">
    <view class="primary-btn" wx:if="{{currentStudent.vocabularyEnabled}}" bindtap="goVocabulary">
      {{vocabularyPulse.completed ? '查看今日单词成果' : '继续今日单词 · 还差 ' + vocabularyPulse.remainingCount + ' 个'}}
    </view>
    <view class="primary-btn" wx:else bindtap="goMyLessons">查看学习主页</view>
    <view class="student-action-grid">
      <view class="ghost-btn" bindtap="goMyLessons">课程与错题</view>
      <view class="ghost-btn" bindtap="goLessonBookings">预约与会议号</view>
    </view>
  </view>

  <view class="actions" wx:if="{{isGuest}}">
    <view class="primary-btn" bindtap="goBind">进入英语错题本</view>
  </view>

  <view class="teacher-progress-section" wx:if="{{isTeacher}}">
    <view class="section-title">学生学习进度</view>
    <view class="empty" wx:if="{{!studentsProgress.length}}">还没有学生进度。</view>
    <view class="card student-progress-card" wx:for="{{studentsProgress}}" wx:key="_id" data-id="{{item._id}}" bindtap="goStudentDetail" hover-class="student-progress-card-hover">
      <view class="student-progress-top">
        <view>
          <view class="student-progress-name">{{item.name}}</view>
          <view class="student-progress-grade">{{item.grade}}</view>
        </view>
        <view class="student-progress-percent" wx:if="{{item.hasPlannedLessonCount}}">{{item.progressPercent}}%</view>
      </view>
      <view class="student-progress-text">{{item.progressLabel}}</view>
      <view class="student-progress-bar">
        <view class="student-progress-fill" style="width: {{item.progressPercent}}%;"></view>
      </view>
      <view class="student-vocabulary-row" wx:if="{{item.vocabularyPulse.enabled}}">
        <view>
          <view class="student-vocabulary-label">今日单词</view>
          <view class="student-vocabulary-note">
            {{item.vocabularyPulse.completed ? '已完成目标' : '还差 ' + item.vocabularyPulse.remainingCount + ' 个'}}
          </view>
        </view>
        <view class="student-vocabulary-count">{{item.vocabularyPulse.reviewedCount}} / {{item.vocabularyPulse.goal}}</view>
      </view>
      <view class="student-vocabulary-bar" wx:if="{{item.vocabularyPulse.enabled}}">
        <view class="student-vocabulary-fill" style="width: {{item.vocabularyPulse.progressPercent}}%;"></view>
      </view>
      <view class="student-progress-link">进入学习主页 →</view>
    </view>
  </view>

  <view class="section-title">最近英语课</view>
  <view class="empty" wx:if="{{!recentLessons.length}}">还没有可以查看的课程。</view>
  <view class="card lesson-card" wx:for="{{recentLessons}}" wx:key="_id" data-id="{{item._id}}" bindtap="goLessonDetail" hover-class="lesson-card-hover">
    <view class="lesson-main">
      <view class="lesson-title">{{item.title}}</view>
      <view class="lesson-meta">{{item.subject}} · {{item.lessonDate}}</view>
    </view>
    <view class="student-line" wx:if="{{isTeacher && item.studentName}}">学生：{{item.studentName}}</view>
    <view class="lesson-summary">{{item.summary}}</view>
  </view>

  <view class="env-tip">云环境：{{envId}}</view>
</view>
