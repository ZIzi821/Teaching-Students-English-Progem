.todo-page {
  padding-top: 24rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.todo-hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #315c4b 0%, #4f8f73 62%, #79a990 100%);
  box-shadow: 0 16rpx 34rpx rgba(56, 105, 82, 0.2);
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.hero-row,
.todo-topline,
.todo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-count {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.13);
  font-size: 38rpx;
  font-weight: 800;
}

.hero-note {
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
}

.status-card {
  color: #74695e;
  text-align: center;
}

.retry-action {
  margin-top: 18rpx;
  color: #39765d;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  margin-bottom: 24rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-card {
  min-width: 0;
  padding: 21rpx 8rpx;
  border: 1rpx solid #e4ddd2;
  border-radius: 18rpx;
  text-align: center;
}

.summary-recording {
  background: #f1f8f4;
}

.summary-homework {
  background: #fff7e9;
}

.summary-vocabulary {
  background: #f4f1fa;
}

.summary-inactivity {
  background: #f8f2ee;
}

.summary-number {
  color: #3f705c;
  font-size: 34rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 5rpx;
  overflow: hidden;
  color: #786e63;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding-right: 24rpx;
  gap: 12rpx;
}

.filter-chip {
  padding: 13rpx 22rpx;
  border: 1rpx solid #e0d7cb;
  border-radius: 999rpx;
  color: #766c61;
  background: #fffdfa;
  font-size: 22rpx;
  font-weight: 650;
}

.filter-chip-active {
  border-color: #4f8f73;
  color: #fff;
  background: #4f8f73;
}

.todo-card {
  position: relative;
  overflow: hidden;
  padding: 25rpx 24rpx 23rpx 28rpx;
}

.todo-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: #86a997;
  content: "";
}

.todo-urgent::before {
  background: #d27a59;
}

.todo-attention::before {
  background: #d0a04c;
}

.student-name {
  min-width: 0;
  overflow: hidden;
  color: #39765d;
  font-size: 23rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-badge {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: #5e7468;
  background: #edf5f0;
  font-size: 19rpx;
  font-weight: 700;
}

.category-homework {
  color: #8d6536;
  background: #fff0d7;
}

.category-vocabulary {
  color: #685a82;
  background: #f0ebf8;
}

.category-inactivity {
  color: #815f50;
  background: #f5e9e3;
}

.todo-title {
  margin-top: 13rpx;
  color: #39332d;
  font-size: 28rpx;
  font-weight: 780;
  line-height: 1.45;
}

.todo-detail {
  margin-top: 9rpx;
  color: #756b60;
  font-size: 22rpx;
  line-height: 1.6;
}

.todo-footer {
  align-items: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee6dc;
}

.todo-meta {
  min-width: 0;
  color: #968a7e;
  font-size: 20rpx;
}

.todo-action {
  flex: 0 0 auto;
  color: #39765d;
  font-size: 22rpx;
  font-weight: 750;
}

.empty-card {
  padding: 50rpx 28rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #4f8f73;
  background: #e7f3ed;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 16rpx;
  color: #403931;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-hint,
.evidence-note {
  margin-top: 9rpx;
  color: #8a7e72;
  font-size: 21rpx;
  line-height: 1.6;
}

.evidence-note {
  margin: 24rpx 12rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f5f0e8;
}
