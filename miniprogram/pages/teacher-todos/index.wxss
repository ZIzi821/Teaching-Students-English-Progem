.todo-page {
  padding-top: 24rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.todo-hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 600;
}

.hero-row,
.todo-topline,
.todo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-count {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 82rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.13);
  font-size: 40rpx;
  font-weight: 600;
}

.hero-note {
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
}

.status-card {
  color: var(--ink-2);
  text-align: center;
}

.retry-action {
  margin-top: 18rpx;
  color: var(--accent);
  font-weight: 600;
}

.summary-grid {
  display: grid;
  margin-bottom: 24rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-card {
  min-width: 0;
  padding: 21rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  text-align: center;
}

.summary-recording {
  background: var(--accent-soft);
}

.summary-homework {
  background: var(--warn-soft);
}

.summary-vocabulary {
  background: var(--info-soft);
}

.summary-inactivity {
  background: var(--surface-2);
}

.summary-number {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.summary-label {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding-right: 24rpx;
  gap: 12rpx;
}

.filter-chip {
  padding: 13rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface);
  font-size: 22rpx;
  font-weight: 650;
}

.filter-chip-active {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
}

.todo-card {
  position: relative;
  overflow: hidden;
  padding: 25rpx 24rpx 23rpx 28rpx;
}

.todo-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: var(--accent);
  content: "";
}

.todo-urgent::before {
  background: var(--danger);
}

.todo-attention::before {
  background: var(--warn-fill);
}

.student-name {
  min-width: 0;
  overflow: hidden;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-badge {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.category-homework {
  color: var(--warn);
  background: var(--warn-soft);
}

.category-vocabulary {
  color: var(--info);
  background: var(--info-soft);
}

.category-inactivity {
  color: var(--danger);
  background: var(--danger-soft);
}

.todo-title {
  margin-top: 13rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 780;
  line-height: 1.45;
}

.todo-detail {
  margin-top: 9rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.6;
}

.todo-footer {
  align-items: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.todo-meta {
  min-width: 0;
  color: var(--ink-3);
  font-size: 22rpx;
}

.todo-action {
  flex: 0 0 auto;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 750;
}

.empty-card {
  padding: 50rpx 28rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 32rpx;
  font-weight: 600;
}

.empty-title {
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.empty-hint,
.evidence-note {
  margin-top: 9rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.6;
}

.evidence-note {
  margin: 24rpx 12rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}
