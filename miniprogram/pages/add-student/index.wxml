<view class="page">
  <view class="form-head">
    <view class="title">添加学生</view>
    <view class="subtitle">创建学生档案，并设置用于绑定微信的访问码。</view>
  </view>

  <view class="card message-card" wx:if="{{message}}">{{message}}</view>

  <view class="card form-card">
    <view class="field">
      <view class="label">学生姓名</view>
      <input class="input" placeholder="例如：安安" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">昵称</view>
      <input class="input" placeholder="英文名或昵称，例如：Annie" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">年级</view>
      <input class="input" placeholder="例如：三年级" value="{{form.grade}}" data-field="grade" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">联系人姓名</view>
      <input class="input" placeholder="例如：李女士" value="{{form.parentName}}" data-field="parentName" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">状态</view>
      <input class="input" placeholder="在读 / 暂停" value="{{form.status}}" data-field="status" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">访问码</view>
      <input class="input" placeholder="例如：STUDENT-EN-1234" value="{{form.accessCode}}" data-field="accessCode" bindinput="onInput" />
      <view class="field-hint">普通学生访问码默认最多可绑定 5 个微信账号，方便老师和家长分别查看。</view>
    </view>

    <view class="field">
      <view class="label">微信绑定信息（一般留空）</view>
      <input class="input" placeholder="默认留空，学生绑定后自动写入" value="{{form.studentOpenId}}" data-field="studentOpenId" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">老师</view>
      <input class="input" value="{{form.teacherName}}" data-field="teacherName" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">科目</view>
      <input class="input" value="{{form.subject}}" data-field="subject" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">计划课时</view>
      <input class="input" type="number" placeholder="例如：17" value="{{form.plannedLessonCount}}" data-field="plannedLessonCount" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">已上课时</view>
      <input class="input" type="number" placeholder="例如：3" value="{{form.completedLessonCount}}" data-field="completedLessonCount" bindinput="onInput" />
    </view>
  </view>

  <view class="primary-btn {{operationPending ? 'action-disabled' : ''}}" bindtap="submitStudent">{{operationPending ? '处理中…' : '保存学生'}}</view>
  <view class="ghost-btn seed-btn {{operationPending ? 'action-disabled' : ''}}" bindtap="seedStudents">导入预设学生</view>
</view>
