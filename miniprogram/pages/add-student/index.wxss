.form-head {
  margin-bottom: 22rpx;
}

.title {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 82rpx;
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
  line-height: 1.6;
}

.seed-btn {
  margin-top: 18rpx;
}

.action-disabled {
  opacity: 0.55;
}
.field-hint {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}
