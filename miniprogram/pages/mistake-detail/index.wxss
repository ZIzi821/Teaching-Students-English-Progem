.label {
  margin-bottom: 12rpx;
  color: #817669;
  font-size: 24rpx;
  font-weight: 600;
}

.question-title {
  color: #2f2a24;
  font-size: 34rpx;
  font-weight: 700;
}

.question-image {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 14rpx;
}

.image-empty {
  margin-top: 20rpx;
  padding: 46rpx 20rpx;
  border: 2rpx dashed #eadfcf;
  border-radius: 14rpx;
  color: #9b8f81;
  background: #fffaf1;
  text-align: center;
}

.sample-tip {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 22rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.content {
  color: #3d352e;
  font-size: 28rpx;
  line-height: 1.7;
}

.correct {
  color: #326d56;
  font-weight: 600;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6f593d;
  background: #f5ead8;
  font-size: 22rpx;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}
