.label {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 600;
}

.question-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.question-meta {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.text-empty {
  margin-top: 20rpx;
  padding: 46rpx 20rpx;
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  color: var(--ink-3);
  background: var(--warn-soft);
  text-align: center;
}

.sample-tip {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 24rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.review-card {
  background: var(--surface);
}

.review-top,
.review-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.review-actions-saving {
  opacity: 0.5;
  pointer-events: none;
}

.review-actions {
  margin-top: 18rpx;
}

.review-btn {
  flex: 1;
  min-height: 72rpx;
  font-size: 30rpx;
}

.status,
.priority {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.status {
  color: var(--accent);
  background: var(--accent-soft);
}

.priority {
  color: var(--warn);
  background: var(--warn-soft);
}

.content {
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.7;
}

.correct {
  color: var(--accent);
  font-weight: 600;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 24rpx;
}

.no-permission {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
  line-height: 1.6;
}
.edit-btn {
  margin-bottom: 24rpx;
}

.pending-card {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
}

.question-text {
  margin: 18rpx 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.danger-btn {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 2rpx solid var(--danger-line);
  border-radius: 16rpx;
  color: var(--danger);
  background: var(--danger-soft);
  font-size: 30rpx;
  text-align: center;
}
