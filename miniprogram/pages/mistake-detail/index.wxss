.label {
  margin-bottom: 12rpx;
  color: #817669;
  font-size: 24rpx;
  font-weight: 600;
}

.question-title {
  color: #2f2a24;
  font-size: 34rpx;
  font-weight: 700;
}

.question-meta {
  margin-top: 10rpx;
  color: #817669;
  font-size: 24rpx;
}

.question-image {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 14rpx;
}

.image-empty {
  margin-top: 20rpx;
  padding: 46rpx 20rpx;
  border: 2rpx dashed #eadfcf;
  border-radius: 14rpx;
  color: #9b8f81;
  background: #fffaf1;
  text-align: center;
}

.sample-tip {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 22rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.review-card {
  background: #fffdfa;
}

.review-top,
.review-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.review-actions-saving {
  opacity: 0.5;
  pointer-events: none;
}

.review-actions {
  margin-top: 18rpx;
}

.review-btn {
  flex: 1;
  min-height: 72rpx;
  font-size: 26rpx;
}

.status,
.priority {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status {
  color: #4f8f73;
  background: #e9f4ee;
}

.priority {
  color: #8a6730;
  background: #fff1cf;
}

.content {
  color: #3d352e;
  font-size: 28rpx;
  line-height: 1.7;
}

.correct {
  color: #326d56;
  font-weight: 600;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6f593d;
  background: #f5ead8;
  font-size: 22rpx;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}
.edit-btn {
  margin-bottom: 24rpx;
}

.pending-card {
  color: #8a6730;
  background: #fff1cf;
  font-size: 26rpx;
}

.question-text {
  margin: 18rpx 0;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.source-note {
  margin: 12rpx 0;
  color: #817669;
  font-size: 24rpx;
}

.danger-btn {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 2rpx solid #e3b5b2;
  border-radius: 16rpx;
  color: #a33f3c;
  background: #fff7f6;
  font-size: 27rpx;
  text-align: center;
}
