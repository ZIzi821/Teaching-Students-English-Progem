.practice-page {
  padding-top: 34rpx;
  background: var(--accent-soft),
    var(--surface-2);
}

.practice-head {
  margin: 8rpx 8rpx 30rpx;
}

.eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.practice-title {
  margin-top: 9rpx;
  color: var(--accent);
  font-size: 56rpx;
  font-weight: 600;
}

.lesson-name {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.prompt-card {
  padding: 32rpx;
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.prompt-label {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.prompt-text {
  margin-top: 18rpx;
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.task-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.task-chip {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.task-chip-light {
  color: var(--ink-2);
  background: var(--line);
}

.action-card {
  min-height: 430rpx;
  padding: 34rpx 30rpx;
  text-align: center;
}

.step-title {
  margin-bottom: 22rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  text-align: left;
}

.step-row {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.5;
  text-align: left;
}

.step-no {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.main-action {
  margin-top: 34rpx;
}

.countdown-caption,
.state-title,
.recording-title,
.success-title {
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
}

.countdown-number {
  margin: 18rpx 0 8rpx;
  color: var(--accent);
  font-size: 132rpx;
  font-weight: 600;
  line-height: 1;
}

.countdown-hint,
.state-hint,
.recording-reminder,
.success-detail {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.cancel-action {
  margin-top: 30rpx;
}

.state-icon,
.success-mark {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  margin: 28rpx auto 22rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 56rpx;
  font-weight: 600;
}

.microphone-icon {
  color: var(--accent);
  background: var(--accent-soft);
  animation: soft-pulse 1.2s ease-in-out infinite;
}

.recording-indicator {
  display: flex;
  width: 110rpx;
  height: 110rpx;
  margin: 16rpx auto 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--danger-soft);
  animation: recording-pulse 1.25s ease-out infinite;
}

.recording-core {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--danger);
}

.recording-timer {
  margin-top: 10rpx;
  color: var(--danger);
  font-size: 56rpx;
  font-weight: 600;
}

.stop-action {
  display: flex;
  min-height: 84rpx;
  margin-top: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--danger);
  font-size: 30rpx;
  font-weight: 600;
}

.upload-spinner {
  width: 76rpx;
  height: 76rpx;
  margin: 46rpx auto 30rpx;
  border: 8rpx solid var(--accent-line);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.success-mark {
  background: var(--accent);
}

.success-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.success-action {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
}

.submission-note,
.privacy-note {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.submission-note {
  margin-top: 8rpx;
  color: var(--accent);
  font-weight: 600;
}

.privacy-note {
  margin: 15rpx 20rpx 0;
}

.loading-card,
.error-card {
  margin-top: 80rpx;
  text-align: center;
}

.loading-dot {
  width: 26rpx;
  height: 26rpx;
  margin: 8rpx auto 18rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: soft-pulse 1s ease-in-out infinite;
}

.error-title {
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 600;
}

.error-message {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.error-action {
  margin-top: 28rpx;
}

@keyframes recording-pulse {
  0% {  }
  100% {  }
}

@keyframes soft-pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
.ket-source {
  display: inline-block;
  margin: 10rpx 0 4rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.ket-timing {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}
