.practice-page {
  padding-top: 34rpx;
  background:
    radial-gradient(circle at 88% 7%, rgba(223, 241, 232, 0.95) 0, rgba(223, 241, 232, 0) 230rpx),
    #f7f3ea;
}

.practice-head {
  margin: 8rpx 8rpx 30rpx;
}

.eyebrow {
  color: #4f8f73;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.practice-title {
  margin-top: 9rpx;
  color: #263f36;
  font-size: 46rpx;
  font-weight: 800;
}

.lesson-name {
  margin-top: 10rpx;
  color: #817669;
  font-size: 23rpx;
}

.prompt-card {
  padding: 32rpx;
  border-color: #cfe3d8;
  background: linear-gradient(150deg, #f0f8f4 0%, #fffdfa 78%);
}

.prompt-label {
  color: #39765d;
  font-size: 22rpx;
  font-weight: 800;
}

.prompt-text {
  margin-top: 18rpx;
  color: #243f35;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.task-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.task-chip {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #dfeee6;
  font-size: 21rpx;
  font-weight: 700;
}

.task-chip-light {
  color: #756650;
  background: #f4eadb;
}

.action-card {
  min-height: 430rpx;
  padding: 34rpx 30rpx;
  text-align: center;
}

.step-title {
  margin-bottom: 22rpx;
  color: #2f2a24;
  font-size: 29rpx;
  font-weight: 800;
  text-align: left;
}

.step-row {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-top: 16rpx;
  color: #62584d;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: left;
}

.step-no {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #6e9d86;
  font-size: 21rpx;
  font-weight: 800;
}

.main-action {
  margin-top: 34rpx;
}

.countdown-caption,
.state-title,
.recording-title,
.success-title {
  color: #2d463c;
  font-size: 30rpx;
  font-weight: 800;
}

.countdown-number {
  margin: 18rpx 0 8rpx;
  color: #4f8f73;
  font-size: 132rpx;
  font-weight: 800;
  line-height: 1;
}

.countdown-hint,
.state-hint,
.recording-reminder,
.success-detail {
  margin-top: 12rpx;
  color: #817669;
  font-size: 23rpx;
  line-height: 1.5;
}

.cancel-action {
  margin-top: 30rpx;
}

.state-icon,
.success-mark {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  margin: 28rpx auto 22rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #4f8f73;
  font-size: 56rpx;
  font-weight: 800;
}

.microphone-icon {
  color: #4f8f73;
  background: #e3f0e9;
  animation: soft-pulse 1.2s ease-in-out infinite;
}

.recording-indicator {
  display: flex;
  width: 110rpx;
  height: 110rpx;
  margin: 16rpx auto 20rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(182, 83, 75, 0.13);
  animation: recording-pulse 1.25s ease-out infinite;
}

.recording-core {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #b6534b;
}

.recording-timer {
  margin-top: 10rpx;
  color: #b6534b;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.stop-action {
  display: flex;
  min-height: 84rpx;
  margin-top: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #fff;
  background: #b6534b;
  font-size: 27rpx;
  font-weight: 700;
}

.upload-spinner {
  width: 76rpx;
  height: 76rpx;
  margin: 46rpx auto 30rpx;
  border: 8rpx solid #e1eee7;
  border-top-color: #4f8f73;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.success-mark {
  background: #4f8f73;
}

.success-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 34rpx;
}

.success-action {
  min-width: 0;
  flex: 1;
  font-size: 25rpx;
}

.submission-note,
.privacy-note {
  color: #766b5e;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.submission-note {
  margin-top: 8rpx;
  color: #3f7b63;
  font-weight: 700;
}

.privacy-note {
  margin: 15rpx 20rpx 0;
}

.loading-card,
.error-card {
  margin-top: 80rpx;
  text-align: center;
}

.loading-dot {
  width: 26rpx;
  height: 26rpx;
  margin: 8rpx auto 18rpx;
  border-radius: 50%;
  background: #4f8f73;
  animation: soft-pulse 1s ease-in-out infinite;
}

.error-title {
  color: #7c433d;
  font-size: 29rpx;
  font-weight: 800;
}

.error-message {
  margin-top: 14rpx;
  color: #817669;
  font-size: 23rpx;
  line-height: 1.6;
}

.error-action {
  margin-top: 28rpx;
}

@keyframes recording-pulse {
  0% { box-shadow: 0 0 0 0 rgba(182, 83, 75, 0.22); }
  100% { box-shadow: 0 0 0 26rpx rgba(182, 83, 75, 0); }
}

@keyframes soft-pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
.ket-source {
  display: inline-block;
  margin: 10rpx 0 4rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #e7f2ec;
  font-size: 20rpx;
  font-weight: 700;
}

.ket-timing {
  margin-top: 12rpx;
  color: #7b6749;
  font-size: 21rpx;
  line-height: 1.5;
}
