.has-teacher-tabbar {
  padding-bottom: 200rpx;
}

.no-permission {
  color: var(--ink-2);
  text-align: center;
}

.detail-retry {
  margin-top: 16rpx;
  color: var(--accent);
  font-weight: 500;
}

.disabled-action {
  opacity: 0.5;
}

.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.preview-banner-title {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.preview-banner-hint {
  color: var(--ink-2);
  font-size: 22rpx;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 4rpx 24rpx;
}

.avatar {
  display: flex;
  flex: 0 0 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 32rpx;
  font-weight: 600;
}

.profile-main {
  min-width: 0;
  flex: 1;
}

.name {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.meta {
  color: var(--ink-3);
  font-size: 24rpx;
}

.progress-card {
  margin-bottom: 12rpx;
  padding: 28rpx;
}

.progress-top,
.block-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-copy,
.block-head-main,
.setting-copy {
  min-width: 0;
  flex: 1;
}

.progress-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.progress-label,
.cycle-label {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.ghost-small {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.progress-bar {
  margin-top: 20rpx;
}

.progress-tone-near-end .ui-bar-fill,
.progress-tone-complete .ui-bar-fill {
  background: var(--warn-fill);
}

.progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-editor {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: var(--ink);
  font-weight: 500;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  background: var(--surface);
  font-size: 28rpx;
}

.progress-editor-hint {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.editor-actions,
.vocabulary-setting-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.vocabulary-setting-actions {
  margin-top: 24rpx;
  font-size: 24rpx;
}

.vocabulary-setting-actions .primary-btn,
.vocabulary-setting-actions .ghost-btn {
  padding: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.entry-group {
  margin-bottom: 24rpx;
}

.learning-radar-eyebrow {
  color: var(--ink-3);
  font-size: 24rpx;
}

.learning-radar-goal {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.learning-radar-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.learning-radar-cell {
  min-width: 0;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.learning-radar-cell-label {
  color: var(--ink-3);
  font-size: 22rpx;
}

.learning-radar-cell-value {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 500;
  word-break: break-word;
}

.learning-radar-next {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.learning-radar-next-label {
  color: var(--accent);
  font-size: 22rpx;
}

.learning-radar-next-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
}

.learning-radar-readiness {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.overview-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-chart-item {
  min-width: 0;
}

.overview-chart-title {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 500;
}

.weekly-mini {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.weekly-mini-summary {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.overview-actions {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.learning-order-hint {
  margin-bottom: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.overview-challenge {
  margin-top: 12rpx;
}

.text-link {
  margin-top: 20rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
}

.mistake-chart-wrap {
  margin-top: 24rpx;
}

.rank-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.rank-name {
  flex: 0 0 180rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-bar {
  min-width: 0;
  flex: 1;
}

.rank-count {
  flex: 0 0 40rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  text-align: right;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
}

.mistake-export-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.no-learning-card,
.empty {
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}

.empty {
  padding: 48rpx 24rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 24rpx;
}

.add-btn {
  margin-bottom: 24rpx;
}

.lesson-row {
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--line);
}

.lesson-row:first-child {
  border-top: 0;
}

.lesson-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.lesson-title {
  min-width: 0;
  flex: 1;
  word-break: break-word;
}

.date {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 24rpx;
}

.lesson-meta {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.lesson-summary {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ink-2);
  font-size: 24rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.lesson-task-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.deadline-upcoming {
  color: var(--accent);
  background: var(--accent-soft);
}

.deadline-today {
  color: var(--warn);
  background: var(--warn-soft);
}

.deadline-overdue,
.deadline-late {
  color: var(--danger);
  background: var(--danger-soft);
}

.settings-card {
  padding: 8rpx 28rpx 28rpx;
}

.setting-block,
.setting-row {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
}

.setting-block:first-child,
.setting-row-first {
  border-top: 0;
}

.setting-row-first {
  padding-bottom: 0;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.setting-row switch,
.unit-toggle-row switch {
  flex-shrink: 0;
}

.setting-title {
  color: var(--ink);
  font-weight: 500;
}

.setting-hint {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.goal-picker {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--ink);
  font-size: 24rpx;
}

.lesson-template-picker {
  margin-top: 12rpx;
}

.vocabulary-detail-toggle {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
}

.level-grid {
  display: block;
  margin-top: 16rpx;
}

.level-card {
  margin-bottom: 12rpx;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
}

.level-card-checked {
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.level-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}

.unit-toggle-list {
  margin-top: 12rpx;
}

.unit-toggle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid var(--accent-line);
}

.unit-toggle-name {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 500;
}
