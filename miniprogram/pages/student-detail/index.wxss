.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--accent-soft);
}

.avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.profile-main {
  flex: 1;
}

.teacher-reminder-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: var(--accent-line);
  background: var(--surface);
}

.teacher-reminder-mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.teacher-reminder-copy {
  min-width: 0;
  flex: 1;
}

.teacher-reminder-title {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.teacher-reminder-hint {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.teacher-reminder-link {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.name {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.meta,
.summary {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.6;
}

.sample-tip {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 22rpx;
}

.add-btn {
  margin-bottom: 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.empty {
  padding: 40rpx 0;
  color: var(--ink-2);
  text-align: center;
}

.no-permission {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-retry {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 24rpx;
  font-weight: 600;
}

.preview-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 28rpx;
  line-height: 1.6;
}

.progress-card {
  background: var(--surface);
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.progress-label {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 28rpx;
}

.cycle-label {
  margin-top: 10rpx;
  color: var(--warn);
  font-size: 24rpx;
  line-height: 1.5;
}

.progress-bar {
  position: relative;
  width: 100%;
  height: 18rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
  transition: width 0.25s ease, background 0.25s ease;
}

.progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-tone-near-end .progress-fill {
  background: var(--warn-fill);
}

.progress-tone-complete .progress-fill {
  background: var(--warn-fill);
}

.learning-radar-summary {
  border-color: var(--accent-line);
  background: var(--surface);
}

.learning-radar-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.learning-radar-eyebrow,
.learning-radar-cell-label,
.learning-radar-next-label {
  color: var(--ink-3);
  font-size: 22rpx;
  font-weight: 600;
}

.learning-radar-stage {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.learning-radar-link {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.learning-radar-goal {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.learning-radar-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.learning-radar-cell {
  min-width: 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
}

.learning-radar-cell-value {
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.learning-radar-next {
  margin-top: 15rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--warn-soft);
}

.learning-radar-next-title {
  margin-top: 7rpx;
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.learning-radar-readiness {
  margin-top: 14rpx;
  color: var(--accent);
  font-size: 22rpx;
  line-height: 1.5;
}

.progress-editor-hint {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.learning-overview-card {
  background: var(--surface);
}

.overview-head,
.settings-head-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.overview-streak,
.settings-toggle {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.overview-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-chart-item {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: var(--surface);
}

.overview-chart-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.weekly-mini {
  margin-top: 20rpx;
  padding: 20rpx 14rpx 8rpx;
  border-radius: 16rpx;
  background: var(--surface);
}

.overview-action {
  min-width: 0;
}

.weekly-mini-summary {
  color: var(--ink-2);
  font-size: 22rpx;
  text-align: center;
}

.overview-actions {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.overview-challenge {
  min-width: 0;
  font-size: 28rpx;
}

.settings-head-actions {
  justify-content: flex-end;
}

.settings-toggle {
  color: var(--ink-2);
  background: var(--line);
}

.settings-first-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.mistake-chart-wrap {
  max-width: 520rpx;
  margin: 20rpx auto 6rpx;
}

.ghost-small {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
}

.institution-course-note {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
}

.institution-course-note text {
  color: var(--warn);
  font-weight: 600;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 82rpx;
}

.editor-actions {
  display: flex;
  gap: 18rpx;
}

.editor-btn {
  flex: 1;
}

.vocabulary-settings-card {
  background: var(--surface);
}

.french-settings-card {
  background: var(--surface);
}

.vocabulary-settings-head,
.setting-row,
.vocabulary-setting-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.feature-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.feature-on {
  color: var(--accent);
  background: var(--accent-soft);
}

.feature-off {
  color: var(--ink-2);
  background: var(--line);
}

.setting-row,
.setting-block {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.setting-row switch {
  flex-shrink: 0;
}

.setting-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.setting-hint {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.level-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.level-card {
  overflow: hidden;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.level-card-checked {
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.level-option {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 0;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
}

.level-option-checked {
  color: var(--accent);
  background: var(--accent-soft);
}

.level-option checkbox {
  transform: scale(0.82);
}

.unit-toggle-list {
  margin: 0 16rpx 16rpx;
  overflow: hidden;
  border-top: 1rpx solid var(--accent-line);
}

.unit-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid var(--accent-line);
}

.unit-toggle-row:last-child {
  border-bottom: 0;
}

.unit-toggle-copy {
  min-width: 0;
  flex: 1;
}

.unit-toggle-name {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.unit-toggle-count {
  margin-top: 5rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.unit-toggle-row switch {
  flex-shrink: 0;
  transform: scale(0.82);
}

.goal-picker {
  min-width: 112rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.lesson-template-block {
  margin-bottom: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.lesson-template-picker {
  width: auto;
  margin-top: 14rpx;
  padding: 0 20rpx;
  text-align: left;
}

.template-description {
  margin-top: 10rpx;
  color: var(--accent);
}

.student-goal-status {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.vocabulary-setting-actions {
  margin-top: 28rpx;
}

.setting-action-btn {
  flex: 1;
  min-height: 76rpx;
  font-size: 28rpx;
}

.disabled-action {
  opacity: 0.6;
}

.vocabulary-entry-card {
  overflow: hidden;
  background: var(--accent-soft);
}

.vocabulary-entry-eyebrow {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.vocabulary-entry-title {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.vocabulary-entry-hint {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.vocabulary-entry-btn {
  margin-top: 24rpx;
}

.analytics-card {
  background: var(--surface);
}

.analytics-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.metric-item {
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  text-align: center;
}

.metric-number {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.metric-label {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.rank-block {
  margin-top: 24rpx;
}

.rank-title {
  margin-bottom: 14rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.rank-row {
  display: grid;
  grid-template-columns: 150rpx 1fr 44rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.rank-name,
.rank-count {
  color: var(--ink-2);
  font-size: 24rpx;
}

.rank-count {
  text-align: right;
}

.rank-bar {
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.rank-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

.analysis-tags {
  margin-top: 22rpx;
}

.mistake-export-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.mistake-export-title {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.mistake-export-hint {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.mistake-export-arrow {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
}

.lesson-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.lesson-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.date,
.subject {
  color: var(--ink-2);
  font-size: 24rpx;
}

.subject {
  margin-top: 10rpx;
}

.lesson-task-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.lesson-task-chip {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
}

.recording-task-chip {
  color: var(--accent);
  background: var(--accent-soft);
}

.homework-done-chip {
  color: var(--accent);
  background: var(--accent-soft);
}

.homework-waiting-chip {
  color: var(--warn);
  background: var(--warn-soft);
}

.deadline-upcoming {
  color: var(--accent);
  background: var(--accent-soft);
}

.deadline-today {
  color: var(--warn);
  background: var(--warn-soft);
}

.deadline-overdue,
.deadline-late {
  color: var(--danger);
  background: var(--danger-soft);
}
.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
}

.preview-banner-title {
  font-size: 28rpx;
  font-weight: 600;
}

.preview-banner-hint {
  margin-top: 5rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 11rpx 14rpx;
  border-radius: 999rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}
.french-student-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: var(--info-line);
  background: var(--info-soft);
}

.french-student-mark {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--info);
  font-size: 22rpx;
  font-weight: 600;
}

.french-student-main {
  min-width: 0;
  flex: 1;
}

.french-student-title {
  color: var(--info);
  font-size: 28rpx;
  font-weight: 600;
}

.french-student-hint {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.french-student-link {
  flex-shrink: 0;
  color: var(--info);
  font-size: 22rpx;
  font-weight: 600;
}

.course-feature-row,
.mistake-feature-row,
.vocabulary-feature-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.vocabulary-detail-toggle {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.no-learning-card {
  color: var(--ink-2);
  text-align: center;
  line-height: 1.6;
}
.learning-order-hint {
  grid-column: 1 / -1;
  margin-bottom: 4rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  text-align: left;
}

.vocabulary-record-link {
  grid-column: 1 / -1;
  padding-top: 6rpx;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}
