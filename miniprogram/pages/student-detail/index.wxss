.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #e9f4ee;
}

.avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #4f8f73;
  font-size: 38rpx;
  font-weight: 700;
}

.profile-main {
  flex: 1;
}

.teacher-reminder-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: #d7e6de;
  background: linear-gradient(145deg, #fffdfa 0%, #f0f8f4 100%);
}

.teacher-reminder-mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 18rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 24rpx;
  font-weight: 800;
}

.teacher-reminder-copy {
  min-width: 0;
  flex: 1;
}

.teacher-reminder-title {
  color: #2f493f;
  font-size: 27rpx;
  font-weight: 800;
}

.teacher-reminder-hint {
  margin-top: 6rpx;
  color: #80766a;
  font-size: 21rpx;
  line-height: 1.45;
}

.teacher-reminder-link {
  flex-shrink: 0;
  color: #39765d;
  font-size: 22rpx;
  font-weight: 700;
}

.name {
  color: #243f35;
  font-size: 38rpx;
  font-weight: 700;
}

.meta,
.summary {
  margin-top: 10rpx;
  color: #6a6258;
  font-size: 26rpx;
  line-height: 1.6;
}

.sample-tip {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 22rpx;
}

.add-btn {
  margin-bottom: 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #2f2a24;
  font-size: 32rpx;
  font-weight: 700;
}

.empty {
  padding: 40rpx 0;
  color: #817669;
  text-align: center;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-retry {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #4f6f63;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.preview-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #4f6f63;
  background: #e9f4ee;
  font-size: 26rpx;
  line-height: 1.6;
}

.progress-card {
  background: #fffdfa;
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.progress-label {
  margin-top: 8rpx;
  color: #4f6f63;
  font-size: 26rpx;
}

.cycle-label {
  margin-top: 10rpx;
  color: #8a6730;
  font-size: 24rpx;
  line-height: 1.5;
}

.progress-bar {
  position: relative;
  width: 100%;
  height: 18rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
  transition: width 0.25s ease, background 0.25s ease;
}

.progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-tone-near-end .progress-fill {
  background: #c99a52;
}

.progress-tone-complete .progress-fill {
  background: #b98743;
}

.learning-radar-summary {
  border-color: #d8e7df;
  background: linear-gradient(145deg, #fffdfa 0%, #eef7f2 100%);
}

.learning-radar-summary-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.learning-radar-eyebrow,
.learning-radar-cell-label,
.learning-radar-next-label {
  color: #718379;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.learning-radar-stage {
  margin-top: 8rpx;
  color: #29473b;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.learning-radar-link {
  flex-shrink: 0;
  color: #39765d;
  font-size: 22rpx;
  font-weight: 700;
}

.learning-radar-goal {
  margin-top: 14rpx;
  color: #6f675e;
  font-size: 24rpx;
  line-height: 1.6;
}

.learning-radar-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.learning-radar-cell {
  min-width: 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
}

.learning-radar-cell-value {
  margin-top: 7rpx;
  color: #403831;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.learning-radar-next {
  margin-top: 15rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8edcf;
}

.learning-radar-next-title {
  margin-top: 7rpx;
  color: #765825;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
}

.learning-radar-readiness {
  margin-top: 14rpx;
  color: #4f6f63;
  font-size: 22rpx;
  line-height: 1.5;
}

.progress-editor-hint {
  margin-top: 10rpx;
  color: #817669;
  font-size: 22rpx;
  line-height: 1.5;
}

.learning-overview-card {
  background: linear-gradient(145deg, #fffdfa 0%, #f2f8f4 100%);
}

.overview-head,
.settings-head-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.overview-streak,
.settings-toggle {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #326d56;
  background: #e9f4ee;
  font-size: 22rpx;
  font-weight: 700;
}

.overview-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-chart-item {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.overview-chart-title {
  color: #3d352e;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.weekly-mini {
  margin-top: 20rpx;
  padding: 20rpx 14rpx 8rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.overview-action {
  min-width: 0;
}

.weekly-mini-summary {
  color: #71675c;
  font-size: 22rpx;
  text-align: center;
}

.overview-actions {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.overview-challenge {
  min-width: 0;
  font-size: 26rpx;
}

.settings-head-actions {
  justify-content: flex-end;
}

.settings-toggle {
  color: #655b50;
  background: #f3ece1;
}

.settings-first-row {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eadfcf;
}

.mistake-chart-wrap {
  max-width: 520rpx;
  margin: 20rpx auto 6rpx;
}

.ghost-small {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #4f6f63;
  background: #e9f4ee;
  font-size: 24rpx;
}

.institution-course-note {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  color: #7c6b55;
  background: #f7eedf;
  font-size: 20rpx;
}

.institution-course-note text {
  color: #76562f;
  font-weight: 800;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #655b50;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 28rpx;
  line-height: 82rpx;
}

.editor-actions {
  display: flex;
  gap: 18rpx;
}

.editor-btn {
  flex: 1;
}

.vocabulary-settings-card {
  background: #fffdfa;
}

.french-settings-card {
  background: linear-gradient(145deg, #fffdfa 0%, #f7f3ea 100%);
}

.vocabulary-settings-head,
.setting-row,
.vocabulary-setting-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.feature-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.feature-on {
  color: #326d56;
  background: #dff0e8;
}

.feature-off {
  color: #817669;
  background: #f1ece3;
}

.setting-row,
.setting-block {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee4d6;
}

.setting-row switch {
  flex-shrink: 0;
}

.setting-title {
  color: #3d352e;
  font-size: 27rpx;
  font-weight: 600;
}

.setting-hint {
  margin-top: 6rpx;
  color: #817669;
  font-size: 22rpx;
  line-height: 1.5;
}

.level-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.level-card {
  overflow: hidden;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: #f8f2e8;
}

.level-card-checked {
  border-color: #cfe3d8;
  background: #f4faf6;
}

.level-option {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 0;
  color: #62584d;
  background: #f8f2e8;
  font-size: 24rpx;
}

.level-option-checked {
  color: #326d56;
  background: #e9f4ee;
}

.level-option checkbox {
  transform: scale(0.82);
}

.unit-toggle-list {
  margin: 0 16rpx 16rpx;
  overflow: hidden;
  border-top: 1rpx solid #dce9e1;
}

.unit-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #e7eee9;
}

.unit-toggle-row:last-child {
  border-bottom: 0;
}

.unit-toggle-copy {
  min-width: 0;
  flex: 1;
}

.unit-toggle-name {
  color: #355646;
  font-size: 23rpx;
  font-weight: 700;
}

.unit-toggle-count {
  margin-top: 5rpx;
  color: #79877f;
  font-size: 20rpx;
}

.unit-toggle-row switch {
  flex-shrink: 0;
  transform: scale(0.82);
}

.goal-picker {
  min-width: 112rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  color: #326d56;
  background: #e9f4ee;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.lesson-template-block {
  margin-bottom: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f2f8f4;
}

.lesson-template-picker {
  width: auto;
  margin-top: 14rpx;
  padding: 0 20rpx;
  text-align: left;
}

.template-description {
  margin-top: 10rpx;
  color: #39765d;
}

.student-goal-status {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f8f2e8;
}

.vocabulary-setting-actions {
  margin-top: 28rpx;
}

.setting-action-btn {
  flex: 1;
  min-height: 76rpx;
  font-size: 26rpx;
}

.disabled-action {
  opacity: 0.6;
}

.vocabulary-entry-card {
  overflow: hidden;
  background: linear-gradient(135deg, #e2f3ea 0%, #fff7df 100%);
}

.vocabulary-entry-eyebrow {
  color: #4f8f73;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.vocabulary-entry-title {
  margin-top: 10rpx;
  color: #243f35;
  font-size: 34rpx;
  font-weight: 700;
}

.vocabulary-entry-hint {
  margin-top: 10rpx;
  color: #52635b;
  font-size: 24rpx;
}

.vocabulary-entry-btn {
  margin-top: 24rpx;
}

.analytics-card {
  background: #fffdfa;
}

.analytics-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.metric-item {
  padding: 18rpx 8rpx;
  border-radius: 14rpx;
  background: #f8f2e8;
  text-align: center;
}

.metric-number {
  color: #326d56;
  font-size: 34rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 6rpx;
  color: #817669;
  font-size: 22rpx;
}

.rank-block {
  margin-top: 24rpx;
}

.rank-title {
  margin-bottom: 14rpx;
  color: #2f2a24;
  font-size: 26rpx;
  font-weight: 700;
}

.rank-row {
  display: grid;
  grid-template-columns: 150rpx 1fr 44rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.rank-name,
.rank-count {
  color: #62584d;
  font-size: 24rpx;
}

.rank-count {
  text-align: right;
}

.rank-bar {
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.rank-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.analysis-tags {
  margin-top: 22rpx;
}

.mistake-export-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #c9ded2;
  border-radius: 14rpx;
  background: #edf7f1;
}

.mistake-export-title {
  color: #2f7158;
  font-size: 26rpx;
  font-weight: 800;
}

.mistake-export-hint {
  margin-top: 6rpx;
  color: #64776e;
  font-size: 21rpx;
  line-height: 1.45;
}

.mistake-export-arrow {
  color: #3f8366;
  font-size: 32rpx;
  font-weight: 800;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6f593d;
  background: #f5ead8;
  font-size: 22rpx;
}

.lesson-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.lesson-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.date,
.subject {
  color: #817669;
  font-size: 24rpx;
}

.subject {
  margin-top: 10rpx;
}

.lesson-task-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.lesson-task-chip {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #6e5b43;
  background: #f2e6d4;
  font-size: 20rpx;
}

.recording-task-chip {
  color: #39765d;
  background: #e9f4ee;
}

.homework-done-chip {
  color: #276a50;
  background: #dff1e8;
}

.homework-waiting-chip {
  color: #94651d;
  background: #fff0cf;
}

.deadline-upcoming {
  color: #4f7462;
  background: #e8f2ed;
}

.deadline-today {
  color: #8a6730;
  background: #ffedc2;
}

.deadline-overdue,
.deadline-late {
  color: #985148;
  background: #fae6e4;
}
.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d7e7df;
  border-radius: 18rpx;
  color: #2d4f42;
  background: #edf7f2;
}

.preview-banner-title {
  font-size: 26rpx;
  font-weight: 700;
}

.preview-banner-hint {
  margin-top: 5rpx;
  color: #65796f;
  font-size: 21rpx;
  line-height: 1.45;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 11rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 21rpx;
  font-weight: 700;
}
.french-student-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: #d9e2ef;
  background: linear-gradient(135deg, #eef3fa 0%, #f7eef1 100%);
}

.french-student-mark {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #315a83, #a65360);
  font-size: 22rpx;
  font-weight: 800;
}

.french-student-main {
  min-width: 0;
  flex: 1;
}

.french-student-title {
  color: #2e4057;
  font-size: 29rpx;
  font-weight: 700;
}

.french-student-hint {
  margin-top: 6rpx;
  color: #6f7480;
  font-size: 22rpx;
  line-height: 1.45;
}

.french-student-link {
  flex-shrink: 0;
  color: #315a83;
  font-size: 23rpx;
  font-weight: 700;
}

.course-feature-row,
.mistake-feature-row,
.vocabulary-feature-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee4d6;
}

.vocabulary-detail-toggle {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  color: #39765d;
  background: #e9f4ee;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.no-learning-card {
  color: #817669;
  text-align: center;
  line-height: 1.6;
}
.learning-order-hint {
  grid-column: 1 / -1;
  margin-bottom: 4rpx;
  color: #756a60;
  font-size: 23rpx;
  text-align: left;
}

.vocabulary-record-link {
  grid-column: 1 / -1;
  padding-top: 6rpx;
  color: #4f806a;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}
