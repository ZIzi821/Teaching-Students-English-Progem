.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #e9f4ee;
}

.avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #4f8f73;
  font-size: 38rpx;
  font-weight: 700;
}

.profile-main {
  flex: 1;
}

.name {
  color: #243f35;
  font-size: 38rpx;
  font-weight: 700;
}

.meta,
.summary {
  margin-top: 10rpx;
  color: #6a6258;
  font-size: 26rpx;
  line-height: 1.6;
}

.sample-tip {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 22rpx;
}

.add-btn {
  margin-bottom: 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #2f2a24;
  font-size: 32rpx;
  font-weight: 700;
}

.empty {
  padding: 40rpx 0;
  color: #817669;
  text-align: center;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}

.preview-tip {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #4f6f63;
  background: #e9f4ee;
  font-size: 26rpx;
  line-height: 1.6;
}

.progress-card {
  background: #fffdfa;
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.progress-label {
  margin-top: 8rpx;
  color: #4f6f63;
  font-size: 26rpx;
}

.cycle-label {
  margin-top: 10rpx;
  color: #8a6730;
  font-size: 24rpx;
  line-height: 1.5;
}

.progress-bar {
  width: 100%;
  height: 18rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.ghost-small {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #4f6f63;
  background: #e9f4ee;
  font-size: 24rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #655b50;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 28rpx;
  line-height: 82rpx;
}

.editor-actions {
  display: flex;
  gap: 18rpx;
}

.editor-btn {
  flex: 1;
}

.analytics-card {
  background: #fffdfa;
}

.analytics-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.metric-item {
  padding: 18rpx 8rpx;
  border-radius: 14rpx;
  background: #f8f2e8;
  text-align: center;
}

.metric-number {
  color: #326d56;
  font-size: 34rpx;
  font-weight: 700;
}

.metric-label {
  margin-top: 6rpx;
  color: #817669;
  font-size: 22rpx;
}

.rank-block {
  margin-top: 24rpx;
}

.rank-title {
  margin-bottom: 14rpx;
  color: #2f2a24;
  font-size: 26rpx;
  font-weight: 700;
}

.rank-row {
  display: grid;
  grid-template-columns: 150rpx 1fr 44rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.rank-name,
.rank-count {
  color: #62584d;
  font-size: 24rpx;
}

.rank-count {
  text-align: right;
}

.rank-bar {
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.rank-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
}

.analysis-tags {
  margin-top: 22rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #6f593d;
  background: #f5ead8;
  font-size: 22rpx;
}

.lesson-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.lesson-title {
  color: #2f2a24;
  font-size: 30rpx;
  font-weight: 700;
}

.date,
.subject {
  color: #817669;
  font-size: 24rpx;
}

.subject {
  margin-top: 10rpx;
}
