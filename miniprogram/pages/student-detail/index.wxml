<view class="page {{isTeacher ? 'has-teacher-tabbar' : ''}}">
  <view class="card no-permission" wx:if="{{message}}">
    <view>{{message}}</view>
    <view class="detail-retry" bindtap="loadStudent">重新加载</view>
  </view>

  <view wx:if="{{student}}">
    <view class="preview-banner" wx:if="{{isTeacherPreview}}">
      <view>
        <view class="preview-banner-title">正在查看 {{student.name}} 的学生端</view>
        <view class="preview-banner-hint">这是只读预览，学习记录和账号绑定都不会改变。</view>
      </view>
      <view class="preview-banner-action" bindtap="goBackToTeacher">返回教师端</view>
    </view>
    <view class="card profile-card">
      <view class="avatar">{{student.initial}}</view>
      <view class="profile-main">
        <view class="name">{{student.name}}</view>
        <view class="meta">{{student.grade}} · {{student.subject}} · {{student.teacherName}}</view>
        <view class="meta" wx:if="{{isTeacher}}">联系人：{{student.parentName}} · 访问码：{{student.accessCode}}</view>
        <view class="meta" wx:if="{{isTeacher}}">
          已绑定 {{student.boundAccountCount || 0}} / {{student.studentBindLimit || '不限'}} 个微信账号
        </view>
      </view>
    </view>

    <view class="card french-student-entry" wx:if="{{!isTeacher && frenchLearningForm.enabled}}" bindtap="goFrenchLearning">
      <view class="french-student-mark">FR</view>
      <view class="french-student-main">
        <view class="french-student-title">法语学习</view>
        <view class="french-student-hint">A1/A2 词汇、语法、听力、跟读与阅读</view>
      </view>
      <view class="french-student-link">进入 →</view>
    </view>

    <view class="card progress-card" wx:if="{{isTeacher || showEnglishLearning}}">
      <view class="progress-top">
        <view>
          <view class="progress-title">课程进度</view>
          <view class="progress-label">{{student.progressLabel}} · {{student.progressPercent}}%</view>
          <view class="cycle-label" wx:if="{{cycleStatus}}">{{cycleStatus.label}}</view>
        </view>
        <view class="ghost-small" wx:if="{{isTeacher}}" bindtap="showProgressEditor">编辑课程进度</view>
      </view>
      <view class="progress-bar progress-tone-{{student.progressTone}}">
        <view class="progress-fill" style="width: {{student.progressPercent}}%;"></view>
        <view class="progress-marker" wx:if="{{student.showProgressMarker}}" style="left: {{student.progressMarkerPercent}}%;"></view>
      </view>
    </view>

    <view class="card progress-editor" wx:if="{{showProgressEditor}}">
      <view class="field">
        <view class="label">计划课时</view>
        <input class="input" type="number" value="{{progressForm.plannedLessonCount}}" data-field="plannedLessonCount" bindinput="onProgressInput" />
      </view>
      <view class="field">
        <view class="label">已上课时</view>
        <input class="input" type="number" value="{{progressForm.completedLessonCount}}" data-field="completedLessonCount" bindinput="onProgressInput" />
      </view>
      <view class="field">
        <view class="label">常用加课数量</view>
        <input class="input" type="number" value="{{progressForm.lessonPackageSize}}" data-field="lessonPackageSize" bindinput="onProgressInput" />
        <view class="progress-editor-hint">只用于进度条的末段提示；Molly 默认 5 节，冯嘉文默认 3 节。填 0 可关闭。</view>
      </view>
      <view class="editor-actions">
        <view class="ghost-btn editor-btn" bindtap="hideProgressEditor">取消</view>
        <view class="primary-btn editor-btn" bindtap="submitProgress">保存进度</view>
      </view>
    </view>

    <view class="card learning-overview-card" wx:if="{{student.vocabularyEnabled}}">
      <view class="overview-head">
        <view>
          <view class="progress-title">单词学习概览</view>
          <view class="progress-label">这里的数据与学生端一致</view>
        </view>
        <view class="overview-streak" wx:if="{{vocabularyOverview.weeklyStats.streakDays}}">
          连续 {{vocabularyOverview.weeklyStats.streakDays}} 天<text wx:if="{{vocabularyOverview.weeklyStats.streakPendingToday}}"> · 今天还没学</text>
        </view>
        <view class="overview-streak" wx:else>还没有连续学习记录</view>
      </view>
      <view class="overview-chart-grid">
        <view class="overview-chart-item">
          <view class="overview-chart-title">今日目标</view>
          <data-chart
            segments="{{vocabularyTodaySegments}}"
            center-value="{{vocabularyOverview.summary.todayReviewedCount + '/' + vocabularyOverview.dailyPlan.dailyGoal}}"
            center-label="今日完成"
            aria-label="今日完成 {{vocabularyOverview.summary.todayReviewedCount}} 个，目标 {{vocabularyOverview.dailyPlan.dailyGoal}} 个"
          ></data-chart>
        </view>
        <view class="overview-chart-item">
          <view class="overview-chart-title">词库掌握</view>
          <data-chart
            segments="{{vocabularyMasterySegments}}"
            center-value="{{vocabularyOverview.summary.totalCount + ''}}"
            center-label="词库总数"
            aria-label="词库共 {{vocabularyOverview.summary.totalCount}} 个，已掌握 {{vocabularyOverview.summary.masteredCount}} 个"
          ></data-chart>
        </view>
      </view>
      <view class="weekly-mini" wx:if="{{weeklyChartPoints.length}}">
        <view class="overview-chart-title">近 7 天学习</view>
        <data-chart
          type="bar"
          points="{{weeklyChartPoints}}"
          aria-label="近七天共完成 {{vocabularyOverview.weeklyStats.totalReviewed}} 个单词"
        ></data-chart>
        <view class="weekly-mini-summary">
          7 天完成 {{vocabularyOverview.weeklyStats.totalReviewed}} 个
          <text wx:if="{{vocabularyOverview.weeklyStats.totalReviewActions}}"> · 记住率 {{vocabularyOverview.weeklyStats.fluentRate}}%</text>
        </view>
      </view>
      <view class="overview-actions">
        <view class="learning-order-hint">建议顺序：先背单词，再做小测</view>
        <view class="primary-btn overview-action" bindtap="goVocabularyStudy">
          ① {{isTeacher || isTeacherPreview ? '查看学生背词流程' : '开始今日背词'}}
        </view>
        <view class="ghost-btn overview-challenge" bindtap="goVocabularyChallenge">② 背完后做个性化小测</view>
        <view class="vocabulary-record-link" bindtap="goVocabulary">查词与查看学习记录 →</view>
      </view>
    </view>

    <view class="card vocabulary-settings-card" wx:if="{{isTeacher}}">
      <view class="vocabulary-settings-head">
        <view>
          <view class="progress-title">英语学习功能</view>
          <view class="progress-label">课程与作业、错题整理、背单词分别控制</view>
        </view>
      </view>

      <view class="setting-block lesson-template-block">
        <view class="setting-title">英语课程记录模板</view>
        <view class="setting-hint">为这名学生设置专属课后记录结构；每一节课仍可临时切换。</view>
        <picker mode="selector" range="{{lessonTemplateOptions}}" range-key="label" value="{{lessonTemplateIndex}}" disabled="{{lessonTemplateSaving}}" bindchange="onStudentLessonTemplateChange">
          <view class="goal-picker lesson-template-picker">{{lessonTemplateOptions[lessonTemplateIndex].label}}</view>
        </picker>
        <view class="setting-hint template-description">{{lessonTemplateOptions[lessonTemplateIndex].description}}</view>
      </view>

      <view class="setting-row course-feature-row">
        <view>
          <view class="setting-title">英语课程与作业功能</view>
          <view class="setting-hint">控制学生是否看到英语课记录、课后任务和录音提交；与错题、背单词互不影响。</view>
        </view>
        <switch checked="{{courseLearningForm.enabled}}" color="#4f8f73" disabled="{{courseSaving}}" bindchange="onCourseLearningChange" />
      </view>

      <view class="setting-row mistake-feature-row">
        <view>
          <view class="setting-title">英语错题整理功能</view>
          <view class="setting-hint">只控制英语错题和复习入口；关闭后课程、作业和历史错题仍会保留。</view>
        </view>
        <switch checked="{{mistakeLearningForm.enabled}}" color="#4f8f73" disabled="{{mistakeSaving}}" bindchange="onMistakeLearningChange" />
      </view>

      <view class="setting-row vocabulary-feature-row">
        <view>
          <view class="setting-title">英语背单词功能</view>
          <view class="setting-hint">只控制英语词汇入口；切换后立即保存，关闭后原来的单词学习记录会保留。</view>
        </view>
        <switch checked="{{vocabularyForm.enabled}}" color="#4f8f73" disabled="{{vocabularySaving}}" bindchange="onVocabularyEnabledChange" />
      </view>

      <view class="vocabulary-detail-toggle" bindtap="toggleVocabularySettings">
        {{showVocabularySettings ? '收起背词详细设置' : '设置词库、每日数量与错题单词'}}
      </view>

      <block wx:if="{{showVocabularySettings}}">
      <view class="setting-row">
        <view>
          <view class="setting-title">加入英语错题单词</view>
          <view class="setting-hint">从已经整理过的英语错题文字中收集单词。</view>
        </view>
        <switch checked="{{vocabularyForm.includeMistakeWords}}" color="#4f8f73" disabled="{{vocabularySaving}}" bindchange="onIncludeMistakeWordsChange" />
      </view>

      <view class="setting-row">
        <view>
          <view class="setting-title">每天跳过英语基础词</view>
          <view class="setting-hint">英语基础词仍可搜索，但不计入每天的学习任务。</view>
        </view>
        <switch checked="{{vocabularyForm.hideBasicWords}}" color="#4f8f73" disabled="{{vocabularySaving}}" bindchange="onHideBasicWordsChange" />
      </view>

      <view class="setting-block">
        <view class="setting-title">英语课本和基础词库</view>
        <view class="setting-hint">可选择译林七至九年级六册，并显示对应的词库版本。</view>
        <checkbox-group class="level-grid" bindchange="onVocabularyLevelsChange">
          <label class="level-option {{item.checked ? 'level-option-checked' : ''}}" wx:for="{{vocabularyLevels}}" wx:key="id">
            <checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{vocabularySaving}}" color="#4f8f73" />
            <view>
              <view>{{item.label}}</view>
              <view class="setting-hint" wx:if="{{item.edition}}">{{item.edition}}</view>
            </view>
          </label>
        </checkbox-group>
      </view>

      <view class="setting-row daily-goal-row">
        <view>
          <view class="setting-title">老师建议数量</view>
          <view class="setting-hint">这是以后每天的默认数量；学生端不能自行修改。</view>
        </view>
        <picker mode="selector" range="{{dailyGoalOptions}}" value="{{dailyGoalIndex}}" disabled="{{vocabularySaving}}" bindchange="onVocabularyDailyGoalChange">
          <view class="goal-picker">{{vocabularyForm.dailyGoal}} 个</view>
        </picker>
      </view>

      <view class="student-goal-status">
        <view class="setting-title">今日目标：{{vocabularyDailyPlan.dailyGoal}} 个</view>
        <view class="setting-hint">
          {{vocabularyDailyPlan.hasStudentChoice ? '老师今天已单独设置，可在“查看今日学习”中调整。' : '今天按老师设置的默认数量安排。'}}
        </view>
      </view>

      <view class="vocabulary-setting-actions">
        <view class="ghost-btn setting-action-btn" bindtap="goVocabulary">查看今日学习</view>
        <view class="primary-btn setting-action-btn {{vocabularySaving ? 'disabled-action' : ''}}" bindtap="saveVocabularySettings">
          {{vocabularySaving ? '保存中…' : '保存英语单词设置'}}
        </view>
      </view>
      </block>
    </view>

    <view class="card vocabulary-settings-card french-settings-card" wx:if="{{isTeacher}}">
      <view class="vocabulary-settings-head">
        <view>
          <view class="progress-title">法语功能</view>
          <view class="progress-label">A1/A2 词汇、语法、跟读与阅读，不请求录音权限。</view>
        </view>
        <view class="feature-status {{frenchLearningForm.enabled ? 'feature-on' : 'feature-off'}}">
          {{frenchLearningForm.enabled ? '已开启' : '未开启'}}
        </view>
      </view>
      <view class="setting-row settings-first-row">
        <view>
          <view class="setting-title">允许学生学习法语</view>
          <view class="setting-hint">关闭后学生端不显示法语入口，已有学习记录会保留。</view>
        </view>
        <switch checked="{{frenchLearningForm.enabled}}" color="#4f8f73" disabled="{{frenchSaving}}" bindchange="onFrenchLearningChange" />
      </view>
    </view>

    <view class="card analytics-card" wx:if="{{analytics && (isTeacher || mistakeLearningForm.enabled)}}">
      <view class="analytics-head">
        <view>
          <view class="progress-title">错题分析</view>
          <view class="progress-label">{{analytics.weakPointSummary}}</view>
        </view>
        <view class="ghost-small" bindtap="goReviewDashboard">{{cycleStatus.isReviewPhase ? '开始复习' : '查看复习'}}</view>
      </view>
      <view class="mistake-chart-wrap">
        <data-chart
          segments="{{mistakeStatusSegments}}"
          center-value="{{analytics.totalMistakeCount + ''}}"
          center-label="错题总数"
          aria-label="错题共 {{analytics.totalMistakeCount}} 道，待复习 {{analytics.pendingCount}} 道，已复习 {{analytics.reviewedCount}} 道，已掌握 {{analytics.masteredCount}} 道"
        ></data-chart>
      </view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-number">{{analytics.totalMistakeCount}}</view>
          <view class="metric-label">总错题</view>
        </view>
        <view class="metric-item">
          <view class="metric-number">{{analytics.pendingCount}}</view>
          <view class="metric-label">待复习</view>
        </view>
        <view class="metric-item">
          <view class="metric-number">{{analytics.masteredCount}}</view>
          <view class="metric-label">已掌握</view>
        </view>
      </view>
      <view class="rank-block" wx:if="{{analytics.topQuestionTypes.length}}">
        <view class="rank-title">高频题型</view>
        <view class="rank-row" wx:for="{{analytics.topQuestionTypes}}" wx:key="label">
          <view class="rank-name">{{item.label}}</view>
          <view class="rank-bar"><view class="rank-fill" style="width: {{item.percent}}%;"></view></view>
          <view class="rank-count">{{item.count}}</view>
        </view>
      </view>
      <view class="tags analysis-tags" wx:if="{{analytics.topSkillTags.length}}">
        <text class="tag" wx:for="{{analytics.topSkillTags}}" wx:key="label">{{item.label}} {{item.count}}</text>
      </view>
    </view>

    <view class="primary-btn add-btn" wx:if="{{isTeacher}}" bindtap="goAddLesson">添加英语课记录</view>
    <block wx:if="{{isTeacher || courseLearningForm.enabled}}">
      <view class="section-title">英语课记录</view>
      <view class="empty" wx:if="{{!lessons.length}}">还没有英语课记录。</view>
      <view class="card lesson-card" wx:for="{{lessons}}" wx:key="_id" bindtap="goLesson" data-id="{{item._id}}">
        <view class="lesson-top">
          <view class="lesson-title">{{item.title}}</view>
          <view class="date">{{item.lessonDate}}</view>
        </view>
        <view class="subject">{{item.subject}}<text wx:if="{{item.lessonNo}}"> · 第 {{item.lessonNo}} 节</text></view>
        <view class="lesson-task-chips" wx:if="{{item.homeworkTask || item.recordingTaskEnabled}}">
          <text class="lesson-task-chip" wx:if="{{item.homeworkTask}}">有课后任务</text>
          <text class="lesson-task-chip recording-task-chip" wx:if="{{item.recordingTaskEnabled}}">需要提交录音</text>
          <text class="lesson-task-chip {{item.homeworkCompleted ? 'homework-done-chip' : 'homework-waiting-chip'}}">{{item.homeworkCompleted ? '学生已完成' : '等待完成'}}</text>
          <text class="lesson-task-chip deadline-{{item.homeworkSubmittedLate ? 'late' : item.homeworkDueStatus}}" wx:if="{{item.recordingTaskEnabled && (item.homeworkSubmittedLate || (!item.homeworkCompleted && !item.homeworkHasSubmission && item.homeworkDueLabel))}}">{{item.homeworkSubmittedLate ? '逾期提交' : item.homeworkDueLabel}}</text>
        </view>
        <view class="summary">{{item.masterySummary || item.summary}}</view>
      </view>
    </block>

    <view class="card no-learning-card" wx:if="{{!isTeacher && !showEnglishLearning && !frenchLearningForm.enabled}}">老师暂时还没有为这个账号开启学习功能。</view>
  </view>
  <teacher-tabbar wx:if="{{isTeacher}}" current="students"></teacher-tabbar>
</view>
