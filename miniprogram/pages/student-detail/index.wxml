<view class="page">
  <view class="card no-permission" wx:if="{{message}}">
    <view>{{message}}</view>
  </view>

  <view wx:if="{{student}}">
    <view class="card profile-card">
      <view class="avatar">{{student.initial}}</view>
      <view class="profile-main">
        <view class="name">{{student.name}}</view>
        <view class="meta">{{student.grade}} · {{student.subject}} · {{student.teacherName}}</view>
        <view class="meta" wx:if="{{isTeacher}}">家长：{{student.parentName}} · accessCode：{{student.accessCode}}</view>
      </view>
    </view>

    <view class="card progress-card">
      <view class="progress-top">
        <view>
          <view class="progress-title">课程进度</view>
          <view class="progress-label">{{student.progressLabel}} · {{student.progressPercent}}%</view>
          <view class="cycle-label" wx:if="{{cycleStatus}}">{{cycleStatus.label}}</view>
        </view>
        <view class="ghost-small" wx:if="{{isTeacher}}" bindtap="showProgressEditor">编辑课程进度</view>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{student.progressPercent}}%;"></view>
      </view>
    </view>

    <view class="card progress-editor" wx:if="{{showProgressEditor}}">
      <view class="field">
        <view class="label">总课时</view>
        <input class="input" type="number" value="{{progressForm.plannedLessonCount}}" data-field="plannedLessonCount" bindinput="onProgressInput" />
      </view>
      <view class="field">
        <view class="label">已上课时</view>
        <input class="input" type="number" value="{{progressForm.completedLessonCount}}" data-field="completedLessonCount" bindinput="onProgressInput" />
      </view>
      <view class="editor-actions">
        <view class="ghost-btn editor-btn" bindtap="hideProgressEditor">取消</view>
        <view class="primary-btn editor-btn" bindtap="submitProgress">保存进度</view>
      </view>
    </view>

    <view class="card analytics-card" wx:if="{{analytics}}">
      <view class="analytics-head">
        <view>
          <view class="progress-title">错题分析</view>
          <view class="progress-label">{{analytics.weakPointSummary}}</view>
        </view>
        <view class="ghost-small" bindtap="goReviewDashboard">{{cycleStatus.isReviewPhase ? '开始复习' : '查看复习'}}</view>
      </view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-number">{{analytics.totalMistakeCount}}</view>
          <view class="metric-label">总错题</view>
        </view>
        <view class="metric-item">
          <view class="metric-number">{{analytics.pendingCount}}</view>
          <view class="metric-label">待复习</view>
        </view>
        <view class="metric-item">
          <view class="metric-number">{{analytics.masteredCount}}</view>
          <view class="metric-label">已掌握</view>
        </view>
      </view>
      <view class="rank-block" wx:if="{{analytics.topQuestionTypes.length}}">
        <view class="rank-title">高频题型</view>
        <view class="rank-row" wx:for="{{analytics.topQuestionTypes}}" wx:key="label">
          <view class="rank-name">{{item.label}}</view>
          <view class="rank-bar"><view class="rank-fill" style="width: {{item.count * 18 > 100 ? 100 : item.count * 18}}%;"></view></view>
          <view class="rank-count">{{item.count}}</view>
        </view>
      </view>
      <view class="tags analysis-tags" wx:if="{{analytics.topSkillTags.length}}">
        <text class="tag" wx:for="{{analytics.topSkillTags}}" wx:key="label">{{item.label}} {{item.count}}</text>
      </view>
    </view>

    <view class="primary-btn add-btn" wx:if="{{isTeacher}}" bindtap="goAddLesson">添加英语课记录</view>
    <view class="ghost-btn add-btn" wx:if="{{isTeacher}}" bindtap="goTeacherPreview">以学生视角查看</view>

    <view class="section-title">英语课记录</view>
    <view class="empty" wx:if="{{!lessons.length}}">还没有英语课记录。</view>
    <view class="card lesson-card" wx:for="{{lessons}}" wx:key="_id" bindtap="goLesson" data-id="{{item._id}}">
      <view class="lesson-top">
        <view class="lesson-title">{{item.title}}</view>
        <view class="date">{{item.lessonDate}}</view>
      </view>
      <view class="subject">{{item.subject}}<text wx:if="{{item.lessonNo}}"> · 第 {{item.lessonNo}} 节</text></view>
      <view class="summary">{{item.summary}}</view>
    </view>
  </view>
</view>
