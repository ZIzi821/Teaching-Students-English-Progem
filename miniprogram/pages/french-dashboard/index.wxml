<view class="page french-dashboard-page">
  <teacher-preview-banner wx:if="{{isTeacherPreview}}"></teacher-preview-banner>
  <view class="hero dashboard-hero"><view class="eyebrow">学习节奏</view><view class="title">你的法语学习节奏</view><view class="subtitle">进度依据学习记录估算，用于安排学习节奏。</view></view>
  <view class="card loading-card" wx:if="{{loading}}">正在整理学习记录…</view>
  <view class="card message-card" wx:elif="{{message}}"><view>{{message}}</view><view class="ghost-btn retry-btn" bindtap="loadDashboard">重新加载</view></view>
  <block wx:else>
    <view class="card snapshot-card"><view><view class="section-kicker">今天</view><view class="snapshot-number">{{dashboard.today.activityCount}} / {{dashboard.today.goal}}</view><view class="snapshot-label">今日学习活动</view></view><view class="snapshot-side"><view>已复习 {{dashboard.today.reviewedCount}}</view><view>连续 {{dashboard.streakDays}} 天</view><view>7 天正确率 {{dashboard.accuracy7}}%</view></view></view>
    <view class="card"><view class="section-title">A1 / A2 学习进度</view><view class="section-hint">各维度来自当前学习活动，适合用来安排下一步练习。</view><view class="level-item" wx:for="{{dashboard.levels}}" wx:key="cefrLevel"><view class="level-meta"><view><text class="level-name">{{item.cefrLevel}}</text><text class="level-status">{{item.label}} · {{item.status}}</text></view><view class="level-percent">{{item.overallPercent}}%</view></view><view class="level-track"><view class="level-fill" style="width: {{item.overallPercent}}%;"></view></view><view class="dimension-grid"><view class="dimension" wx:for="{{item.dimensions}}" wx:key="label"><text>{{item.label}}</text><text>{{item.value}}%</text></view></view></view></view>
    <view class="card"><view class="section-head"><view><view class="section-title">近 7 天学习趋势</view><view class="section-hint">每天完成的学习活动数量。</view></view><view class="metric-badge">30 天 {{dashboard.accuracy30}}%</view></view><data-chart type="bar" points="{{dashboard.trendPoints}}" aria-label="近七天法语学习趋势"></data-chart></view>
    <view class="card"><view class="section-title">记忆状态分布</view><view class="section-hint">帮助你优先看到需要巩固的项目。</view><data-chart segments="{{dashboard.memorySegments}}" center-value="{{dashboard.memoryTotal}}" center-label="总词数" aria-label="法语记忆状态分布"></data-chart></view>
    <view class="card"><view class="section-head"><view><view class="section-title">未来 7 天复习负荷</view><view class="section-hint">过期 {{dashboard.workload.overdueCount}} · 今天 {{dashboard.workload.dueToday}} · 明天 {{dashboard.workload.tomorrow}}</view></view><view class="metric-badge">7 天 {{dashboard.workload.nextSevenDays}}</view></view><data-chart type="bar" points="{{dashboard.workloadPoints}}" aria-label="未来七天法语复习负荷"></data-chart></view>
    <view class="card"><view class="section-head"><view><view class="section-title">需要多看一眼</view><view class="section-hint">值得再练一次，帮助记得更稳。</view></view><view class="quiet-link" bindtap="goReview">去复习 →</view></view><view class="difficult-empty" wx:if="{{!dashboard.difficultWords.length}}">继续积累学习记录后，这里会出现建议复习的词。</view><view class="difficult-list" wx:else><view class="difficult-item" wx:for="{{dashboard.difficultWords}}" wx:key="text"><view><view class="word-text">{{item.text}}</view><view class="word-meaning">{{item.meaning}}</view></view><view class="word-score" wx:if="{{item.lapseCount}}">Again {{item.lapseCount}} 次</view></view></view></view>
  </block>
</view>
