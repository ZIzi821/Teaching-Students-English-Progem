.french-dashboard-page { gap: 20rpx; }.dashboard-hero { background: #e9f4ee; }.eyebrow, .section-kicker { color: #587468; font-size: 23rpx; font-weight: 700; letter-spacing: 1rpx; }.title { margin-top: 12rpx; color: #243f35; font-size: 42rpx; font-weight: 700; }.subtitle, .section-hint { margin-top: 10rpx; color: #817669; font-size: 24rpx; line-height: 1.5; }.loading-card { color: #817669; }.message-card { color: #8a6730; background: #fff1cf; }.retry-btn { margin-top: 18rpx; }
.snapshot-card { display: flex; align-items: center; justify-content: space-between; background: #f8fbf8; }.snapshot-number { margin-top: 12rpx; color: #326d56; font-size: 42rpx; font-weight: 700; }.snapshot-label { margin-top: 5rpx; color: #817669; font-size: 23rpx; }.snapshot-side { color: #6d583d; font-size: 23rpx; line-height: 1.8; text-align: right; }.section-title { color: #3d352e; font-size: 29rpx; font-weight: 700; }.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }.metric-badge { padding: 8rpx 12rpx; border-radius: 12rpx; color: #6d583d; background: #fff4db; font-size: 21rpx; white-space: nowrap; }
.level-item { margin-top: 25rpx; }.level-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 10rpx; }.level-name { color: #3d352e; font-size: 27rpx; font-weight: 700; }.level-status { margin-left: 12rpx; color: #817669; font-size: 21rpx; }.level-percent { color: #326d56; font-size: 25rpx; font-weight: 700; }.level-track { overflow: hidden; height: 14rpx; border-radius: 999rpx; background: #e5ece6; }.level-fill { height: 100%; border-radius: inherit; background: #4f8f73; }.dimension-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 15rpx; }.dimension { display: flex; justify-content: space-between; padding: 9rpx; border-radius: 10rpx; color: #71675c; background: #f6f3ee; font-size: 20rpx; }
.quiet-link { padding-top: 4rpx; color: #326d56; font-size: 23rpx; white-space: nowrap; }.difficult-empty { margin-top: 20rpx; color: #817669; font-size: 24rpx; }.difficult-list { margin-top: 18rpx; }.difficult-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 0; border-top: 1rpx solid #eee7dd; }.word-text { color: #3d352e; font-size: 28rpx; font-weight: 700; }.word-meaning { margin-top: 4rpx; color: #817669; font-size: 22rpx; }.word-score { color: #8a6730; font-size: 21rpx; white-space: nowrap; }
