.french-dashboard-page { gap: 20rpx; }.dashboard-hero { background: var(--accent-soft); }.eyebrow, .section-kicker { color: var(--ink-2); font-size: 22rpx; font-weight: 600;  }.title { margin-top: 12rpx; color: var(--accent); font-size: 40rpx; font-weight: 600; }.subtitle, .section-hint { margin-top: 10rpx; color: var(--ink-2); font-size: 24rpx; line-height: 1.5; }.loading-card { color: var(--ink-2); }.message-card { color: var(--warn); background: var(--warn-soft); }.retry-btn { margin-top: 18rpx; }
.snapshot-card { display: flex; align-items: center; justify-content: space-between; background: var(--accent-soft); }.snapshot-number { margin-top: 12rpx; color: var(--accent); font-size: 40rpx; font-weight: 600; }.snapshot-label { margin-top: 5rpx; color: var(--ink-2); font-size: 22rpx; }.snapshot-side { color: var(--ink-2); font-size: 22rpx; line-height: 1.8; text-align: right; }.section-title { color: var(--ink); font-size: 28rpx; font-weight: 600; }.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }.metric-badge { padding: 8rpx 12rpx; border-radius: 12rpx; color: var(--ink-2); background: var(--warn-soft); font-size: 22rpx; white-space: nowrap; }
.level-item { margin-top: 25rpx; }.level-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 10rpx; }.level-name { color: var(--ink); font-size: 28rpx; font-weight: 600; }.level-status { margin-left: 12rpx; color: var(--ink-2); font-size: 22rpx; }.level-percent { color: var(--accent); font-size: 24rpx; font-weight: 600; }.level-track { overflow: hidden; height: 14rpx; border-radius: 999rpx; background: var(--accent-soft); }.level-fill { height: 100%; border-radius: inherit; background: var(--accent); }.dimension-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 15rpx; }.dimension { display: flex; justify-content: space-between; padding: 9rpx; border-radius: 12rpx; color: var(--ink-2); background: var(--surface-2); font-size: 22rpx; }
.quiet-link { padding-top: 4rpx; color: var(--accent); font-size: 22rpx; white-space: nowrap; }.difficult-empty { margin-top: 20rpx; color: var(--ink-2); font-size: 24rpx; }.difficult-list { margin-top: 18rpx; }.difficult-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 16rpx 0; border-top: 1rpx solid var(--line); }.word-text { color: var(--ink); font-size: 28rpx; font-weight: 600; }.word-meaning { margin-top: 4rpx; color: var(--ink-2); font-size: 22rpx; }.word-score { color: var(--warn); font-size: 22rpx; white-space: nowrap; }
