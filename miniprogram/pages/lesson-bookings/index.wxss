.booking-page {
  gap: 22rpx;
}

.booking-head {
  padding: 32rpx 30rpx;
  border-radius: 24rpx;
  background: #dff0e8;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #587468;
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  color: #243f35;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 14rpx;
  color: #52635b;
  font-size: 26rpx;
  line-height: 1.6;
}

.message-card {
  color: #8a6730;
  background: #fff1cf;
}

.preview-tip {
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  color: #6f6254;
  background: #eee9e1;
  font-size: 24rpx;
  line-height: 1.5;
}

.reminder-guide {
  color: #4e5f57;
  background: #f4faf7;
}

.reminder-guide-title {
  margin-bottom: 12rpx;
  color: #315d4b;
  font-size: 28rpx;
  font-weight: 700;
}

.reminder-guide-row,
.reminder-guide-note {
  font-size: 24rpx;
  line-height: 1.7;
}

.reminder-guide-note {
  margin-top: 8rpx;
  color: #817669;
}

.form-title,
.section-title {
  color: #3d352e;
  font-size: 31rpx;
  font-weight: 700;
}

.form-title {
  margin-bottom: 24rpx;
}

.subscribe-tip {
  margin-top: 16rpx;
  color: #817669;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: center;
}

.section-title {
  margin-top: 10rpx;
}

.booking-filters {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
}

.filter-btn {
  flex: none;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  color: #6f655a;
  background: #eee9e1;
  font-size: 24rpx;
}

.filter-btn.active {
  color: #fff;
  background: #4f7565;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #62584d;
  font-size: 25rpx;
}

.picker-value,
.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #ded4c5;
  border-radius: 14rpx;
  color: #2f2a24;
  background: #fff;
  font-size: 28rpx;
}

.picker-value,
.input {
  min-height: 76rpx;
  padding: 18rpx 20rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 18rpx 20rpx;
}

.booking-top,
.meeting-row,
.editor-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.student-name {
  color: #2f2a24;
  font-size: 31rpx;
  font-weight: 700;
}

.requested-time {
  margin-top: 6rpx;
  color: #62584d;
  font-size: 26rpx;
}

.status-tag {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.status-pending {
  color: #8a6730;
  background: #fff1cf;
}

.status-confirmed {
  color: #316a53;
  background: #dff0e8;
}

.status-cancelled {
  color: #817669;
  background: #eee9e1;
}

.parent-note {
  margin-top: 18rpx;
  color: #756a5e;
  font-size: 25rpx;
  line-height: 1.6;
}

.expired-request-tip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 23rpx;
  line-height: 1.5;
}

.notification-box {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f7f4ef;
}

.notification-title {
  margin-bottom: 10rpx;
  color: #5d5348;
  font-size: 24rpx;
  font-weight: 700;
}

.notification-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 6rpx 0;
  color: #756a5e;
  font-size: 23rpx;
}

.notify-status {
  flex: 1;
  text-align: right;
}

.notify-success {
  color: #316a53;
}

.notify-pending,
.notify-warning {
  color: #9a6d28;
}

.notify-error {
  color: #b64a3a;
}

.notify-muted {
  color: #998f84;
}

.notification-action {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  color: #315d4b;
  background: #dff0e8;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.notification-preview-note {
  margin-top: 10rpx;
  color: #8a6730;
  font-size: 22rpx;
  line-height: 1.5;
}

.confirmed-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #edf7f2;
}

.confirmed-label,
.meeting-pending {
  color: #658074;
  font-size: 24rpx;
}

.confirmed-time {
  margin-top: 6rpx;
  color: #315d4b;
  font-size: 31rpx;
  font-weight: 700;
}

.meeting-row,
.meeting-pending {
  margin-top: 16rpx;
}

.meeting-row {
  align-items: flex-start;
  color: #315d4b;
}

.meeting-content {
  flex: 1;
  min-width: 0;
  color: #315d4b;
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-all;
}

.meeting-textarea {
  min-height: 320rpx;
  font-size: 28rpx;
  line-height: 1.65;
}

.copy-btn {
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #4f6f63;
  background: #d7ebe1;
  font-size: 23rpx;
}

.teacher-editor {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eadfcf;
}

.editor-grid {
  display: flex;
  gap: 18rpx;
}

.compact-field {
  flex: 1;
}

.action-btn {
  flex: 1;
  min-height: 76rpx;
  font-size: 27rpx;
}

.cancel-btn {
  flex: none;
  padding: 18rpx 20rpx;
  color: #b64a3a;
  font-size: 25rpx;
  text-align: center;
}

.parent-cancel {
  margin-top: 14rpx;
  border-top: 1rpx solid #eee5d8;
}

.empty {
  padding: 34rpx 0;
  color: #817669;
  text-align: center;
}
