.challenge-page {
  padding-bottom: 88rpx;
}

.status-card {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
  line-height: 1.6;
  text-align: center;
}

.status-action {
  display: inline-flex;
  min-height: 66rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--surface);
  font-weight: 600;
}

.challenge-head,
.progress-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.challenge-head {
  margin-bottom: 28rpx;
}

.challenge-eyebrow {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.challenge-title {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.4;
}

.challenge-summary {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.55;
}

.preview-badge {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--warn-soft);
  font-size: 24rpx;
}

.preview-tip {
  margin: -12rpx 0 24rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--warn-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.progress-meta {
  color: var(--ink-2);
  font-size: 24rpx;
}

.challenge-progress {
  height: 16rpx;
  margin: 14rpx 0 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--line);
}

.challenge-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
  transition: width 180ms ease;
}

.question-card {
  padding: 32rpx 26rpx;
}

.question-type {
  color: var(--ink-2);
  font-size: 24rpx;
  text-align: center;
}

.question-prompt {
  white-space: pre-line;
  margin-top: 24rpx;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
  text-align: center;
  word-break: break-word;
}

.english-prompt {
  color: var(--accent);
  font-size: 56rpx;
}

.question-meta {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}

.letter-word {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 28rpx;
}

.letter-slot {
  display: flex;
  width: 48rpx;
  height: 66rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1;
  text-transform: lowercase;
}

.letter-slot-fixed {
  border-bottom: 3rpx solid var(--line-strong);
  border-radius: 0;
}

.letter-slot-gap {
  border: 3rpx solid var(--accent);
  background: var(--accent-soft);
}

.letter-slot-filled {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.letter-slot-correct {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.letter-slot-wrong {
  border-color: var(--danger);
  color: var(--danger);
  background: var(--danger-soft);
}

.letter-slot-space {
  width: 20rpx;
  border: 0;
  background: transparent;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 32rpx;
}

.choice-item {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  color: var(--ink);
  background: var(--surface-2);
}

.choice-letter {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.choice-label {
  font-size: 30rpx;
  line-height: 1.45;
}

.choice-correct {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}

.choice-wrong {
  border-color: var(--danger);
  color: var(--danger);
  background: var(--danger-soft);
}

.spelling-area {
  margin-top: 34rpx;
}

.letter-spelling-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spelling-input {
  box-sizing: border-box;
  width: 100%;
  height: 94rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--surface-2);
  font-size: 34rpx;
  text-align: center;
}

.letter-spelling-input {
  height: 78rpx;
  padding: 0 18rpx;
  border-color: var(--accent);
  border-radius: 999rpx;
  background: var(--surface);
  font-size: 34rpx;
  font-weight: 600;
}

.letter-auto-hint {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.spelling-submit,
.next-action,
.result-primary,
.result-secondary {
  display: flex;
  min-height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.spelling-submit,
.next-action,
.result-primary {
  margin-top: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.feedback-card {
  border-width: 2rpx;
}

.feedback-correct {
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.feedback-wrong {
  border-color: var(--danger-line);
  background: var(--danger-soft);
}

.feedback-title {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.feedback-answer {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.55;
}

.feedback-source,
.save-warning {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.save-warning {
  color: var(--danger);
}

.action-disabled {
  opacity: 0.5;
}

.result-card {
  padding: 34rpx 26rpx;
  text-align: center;
}

.result-eyebrow {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.result-title {
  margin: 12rpx 0 8rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

.result-tip {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.result-warning {
  color: var(--danger);
  font-weight: 600;
}

.result-actions {
  display: grid;
  gap: 12rpx;
  margin-top: 24rpx;
}

.result-primary {
  margin-top: 0;
}

.result-secondary {
  color: var(--accent);
  background: var(--accent-soft);
}
