.bind-card {
  background: var(--accent-soft);
}

.eyebrow {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.title {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.7;
}

.label {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 34rpx;
  line-height: 88rpx;
}

.tip,
.message {
  margin-top: 18rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.message {
  color: var(--danger);
}
