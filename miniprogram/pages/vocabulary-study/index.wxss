.study-page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: var(--line);
}

.status-card,
.loading-card {
  color: var(--ink-2);
  text-align: center;
}

.status-action {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-weight: 600;
}

.study-header,
.session-progress-meta,
.result-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.study-header {
  margin-bottom: 24rpx;
}

.study-eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.study-title {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.preview-badge,
.retry-badge {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.preview-tip {
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.session-progress {
  margin-bottom: 24rpx;
}

.session-progress-meta {
  color: var(--ink-2);
  font-size: 24rpx;
}

.session-progress-track {
  height: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--line);
}

.session-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

.memory-card {
  position: relative;
  min-height: 720rpx;
  padding: 38rpx 30rpx 32rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  text-align: center;
}

.memory-stage {
  color: var(--warn);
  font-size: 22rpx;
  font-weight: 600;
}

.retry-badge {
  display: inline-flex;
  margin-top: 14rpx;
  color: var(--warn);
  background: var(--warn-soft);
}

.memory-word {
  margin-top: 76rpx;
  color: var(--accent);
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1.15;
  word-break: break-word;
}

.memory-source {
  margin-top: 18rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.pronunciation-action {
  display: inline-flex;
  min-height: 68rpx;
  align-items: center;
  justify-content: center;
  margin-top: 30rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 28rpx;
  font-weight: 600;
}

.pronunciation-playing {
  color: var(--on-fill);
  background: var(--accent);
}

.audio-preload-note {
  margin-top: 13rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.audio-preload-ready {
  color: var(--accent);
}

.audio-preload-partial {
  color: var(--warn);
}

.audio-output-hint {
  max-width: 560rpx;
  margin: 14rpx auto 0;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.memory-prompt {
  margin: 62rpx 0 24rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.7;
}

.reveal-action,
.completion-primary {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.answer-panel {
  margin-top: 42rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--line);
}

.answer-label {
  color: var(--ink-3);
  font-size: 22rpx;
}

.answer-meaning {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.5;
}

.answer-pos {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
}

.rating-guide {
  margin: 30rpx 8rpx 20rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.rating-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.rating-button {
  min-width: 0;
  padding: 20rpx 10rpx 18rpx;
  border-radius: 16rpx;
}

.rating-title {
  font-size: 28rpx;
  font-weight: 600;
}

.rating-note {
  margin-top: 7rpx;
  font-size: 22rpx;
}

.rating-forgot {
  color: var(--danger);
  background: var(--danger-soft);
}

.rating-hard {
  color: var(--warn);
  background: var(--warn-soft);
}

.rating-known {
  color: var(--accent);
  background: var(--accent-soft);
}

.rating-easy {
  color: var(--info);
  background: var(--info-soft);
}

.rating-disabled {
  opacity: 0.55;
}

.completion-card {
  padding: 58rpx 30rpx 34rpx;
  text-align: center;
}

.completion-mark {
  display: flex;
  width: 108rpx;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border-radius: 50%;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 52rpx;
  font-weight: 600;
}

.completion-title {
  margin-top: 26rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.completion-hint {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.result-summary {
  margin: 34rpx 0;
  padding: 24rpx 8rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.result-summary > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.result-number {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.completion-secondary {
  margin-top: 16rpx;
  padding: 22rpx;
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.study-tip {
  margin-top: 22rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
