.french-shadowing-page {
  gap: 18rpx;
}

.level-tabs { display: flex; gap: 12rpx; }
.level-tab { flex: 1; padding: 16rpx; border-radius: 16rpx; color: var(--ink-2); background: var(--line); text-align: center; }
.level-tab.active { color: var(--on-fill); background: var(--info); }

.loading-card,
.empty-card,
.feature-disabled-card {
  color: var(--ink-2);
  line-height: 1.6;
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
  line-height: 1.6;
}

.retry-btn {
  margin-top: 18rpx;
  min-height: 68rpx;
  font-size: 30rpx;
}

.feature-disabled-title,
.complete-title {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.feature-disabled-hint,
.complete-hint {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-label {
  color: var(--ink-2);
  font-size: 26rpx;
}

.progress-bar {
  height: 14rpx;
  margin: 10rpx 0 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--line);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--info);
}

.sentence-card {
  padding: 40rpx 30rpx 32rpx;
  text-align: center;
  background: var(--surface);
}

.sentence-eyebrow {
  color: var(--info);
  font-size: 24rpx;
  font-weight: 600;
}

.sentence-text {
  margin-top: 34rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.45;
}

.sentence-translation {
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.6;
}

.sentence-note {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.listen-btn {
  min-height: 76rpx;
  margin: 32rpx auto 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: 999rpx;
  color: var(--info);
  background: var(--info-soft);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.repeat-hint {
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.sentence-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.action-btn,
.next-btn {
  width: 100%;
  min-height: 80rpx;
  margin: 0;
  font-size: 30rpx;
}

.next-btn {
  grid-column: 1 / -1;
}

.complete-card {
  text-align: center;
}

.restart-btn {
  margin-top: 28rpx;
}
