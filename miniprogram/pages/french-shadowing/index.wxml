<view class="page french-shadowing-page">
  <teacher-preview-banner wx:if="{{isTeacherPreview}}"></teacher-preview-banner>
  <view class="level-tabs">
    <view class="level-tab {{level === 'A1' ? 'active' : ''}}" data-level="A1" bindtap="switchLevel">A1</view>
    <view class="level-tab {{level === 'A2' ? 'active' : ''}}" data-level="A2" bindtap="switchLevel">A2</view>
  </view>
  <view class="card loading-card" wx:if="{{loading}}">正在准备跟读句子…</view>
  <view class="card message-card" wx:elif="{{message}}">
    <view>{{message}}</view>
    <view class="ghost-btn retry-btn" bindtap="loadSentences">重新加载</view>
  </view>
  <view class="card feature-disabled-card" wx:elif="{{!enabled}}">
    <view class="feature-disabled-title">法语学习暂未开启</view>
    <view class="feature-disabled-hint">请联系老师开启后再进入学习。</view>
  </view>
  <block wx:elif="{{!sentences.length}}">
    <view class="card empty-card">暂时还没有法语跟读句子。</view>
  </block>
  <block wx:elif="{{currentSentence}}">
    <view class="progress-row">
      <view class="progress-label">第 {{currentIndex + 1}} / {{sentences.length}} 句</view>
      <view class="progress-label" wx:if="{{currentSentence.topicLabel}}">{{currentSentence.topicLabel}}</view>
    </view>
    <view class="progress-bar"><view class="progress-fill" style="width: {{((currentIndex + 1) / sentences.length) * 100}}%;"></view></view>

    <view class="card sentence-card">
      <view class="sentence-eyebrow">先听，再跟读</view>
      <view class="sentence-text">{{currentSentence.text}}</view>
      <view class="sentence-translation">{{currentSentence.translation}}</view>
      <view class="sentence-note" wx:if="{{currentSentence.note}}">提示：{{currentSentence.note}}</view>
      <button class="listen-btn" data-key="{{currentSentence.audioKey}}" bindtap="playAudio" disabled="{{audioLoading}}">{{audioLoading ? '准备发音…' : '🔊 播放示范'}}</button>
    </view>

    <view class="repeat-hint">不录音、不评分，听完后自己读一遍即可。</view>
    <view class="sentence-actions">
      <button class="primary-btn action-btn" wx:if="{{!isTeacherPreview}}" disabled="{{submitting}}" bindtap="completeSentence">我跟读了</button>
      <button class="ghost-btn action-btn" disabled="{{submitting || audioLoading}}" bindtap="playAudio" data-key="{{currentSentence.audioKey}}">{{audioLoading ? '准备中…' : '再听一次'}}</button>
      <button class="ghost-btn next-btn" disabled="{{submitting}}" bindtap="nextSentence">{{isTeacherPreview ? '查看下一句' : '下一句'}}</button>
    </view>
  </block>
  <block wx:elif="{{enabled && sentences.length && !currentSentence}}">
    <view class="card complete-card">
      <view class="complete-title">这一轮跟读完成了</view>
      <view class="complete-hint">很好，保持每天听一点、说一点。</view>
      <view class="primary-btn restart-btn" bindtap="restart">再练一轮</view>
    </view>
  </block>
</view>
