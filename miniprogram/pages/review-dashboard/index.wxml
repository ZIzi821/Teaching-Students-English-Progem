<view class="page">
  <view class="card no-permission" wx:if="{{message}}">
    <view>{{message}}</view>
    <view class="review-retry" bindtap="loadAnalytics">重新加载</view>
  </view>

  <view wx:if="{{analytics}}">
    <view class="card hero-card">
      <view class="eyebrow">{{student.name}} 的错题复习</view>
      <view class="title">{{cycleStatus.label}}</view>
      <view class="subtitle">{{analytics.weakPointSummary}}</view>
    </view>

    <view class="metric-grid">
      <view class="card metric-card">
        <view class="metric-number">{{analytics.pendingCount}}</view>
        <view class="metric-label">待复习</view>
      </view>
      <view class="card metric-card">
        <view class="metric-number">{{analytics.reviewedCount}}</view>
        <view class="metric-label">已复习</view>
      </view>
      <view class="card metric-card">
        <view class="metric-number">{{analytics.masteredCount}}</view>
        <view class="metric-label">已掌握</view>
      </view>
    </view>

    <view class="card status-chart-card">
      <view class="section-title">错题掌握情况</view>
      <data-chart
        segments="{{mistakeStatusSegments}}"
        center-value="{{analytics.totalMistakeCount + ''}}"
        center-label="错题总数"
        aria-label="错题共 {{analytics.totalMistakeCount}} 道，待复习 {{analytics.pendingCount}} 道，已复习 {{analytics.reviewedCount}} 道，已掌握 {{analytics.masteredCount}} 道"
      ></data-chart>
    </view>

    <view class="card">
      <view class="section-title">最需要复习的题型</view>
      <view class="empty" wx:if="{{!analytics.topQuestionTypes.length}}">积累更多错题后，这里会生成题型统计。</view>
      <view class="rank-row" wx:for="{{analytics.topQuestionTypes}}" wx:key="label">
        <view class="rank-name">{{item.label}}</view>
        <view class="rank-bar"><view class="rank-fill" style="width: {{item.percent}}%;"></view></view>
        <view class="rank-count">{{item.count}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">知识点标签</view>
      <view class="tags">
        <text class="tag" wx:for="{{analytics.topSkillTags}}" wx:key="label">{{item.label}} {{item.count}}</text>
      </view>
      <view class="empty" wx:if="{{!analytics.topSkillTags.length}}">暂无知识点统计。</view>
    </view>

    <view class="card">
      <view class="section-title">建议先复习</view>
      <view class="empty" wx:if="{{!analytics.reviewSuggestions.length}}">目前没有待复习错题。</view>
      <view class="suggestion" wx:for="{{analytics.reviewSuggestions}}" wx:key="_id" bindtap="goMistake" data-id="{{item._id}}">
        <view class="suggestion-title">{{item.title}}</view>
        <view class="suggestion-meta">{{item.paperSection}} · {{item.questionType}} · 优先级：{{item.reviewPriority}}</view>
        <view class="status">{{item.reviewStatus}}</view>
      </view>
    </view>
  </view>
</view>
