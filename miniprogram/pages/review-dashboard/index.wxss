.hero-card {
  background: var(--accent-soft);
}

.eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.6;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.metric-card {
  padding: 22rpx 8rpx;
  text-align: center;
}

.metric-number {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.metric-label {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.status-chart-card {
  padding-bottom: 24rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.rank-row {
  display: grid;
  grid-template-columns: 150rpx 1fr 44rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.rank-name,
.rank-count {
  color: var(--ink-2);
  font-size: 24rpx;
}

.rank-count {
  text-align: right;
}

.rank-bar {
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.rank-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
}

.suggestion {
  position: relative;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.suggestion:last-child {
  border-bottom: 0;
}

.suggestion-title {
  padding-right: 120rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.suggestion-meta {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.status {
  position: absolute;
  top: 20rpx;
  right: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
}

.empty,
.no-permission {
  color: var(--warn);
  font-size: 28rpx;
  line-height: 1.6;
}

.review-retry {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 24rpx;
  font-weight: 600;
}
