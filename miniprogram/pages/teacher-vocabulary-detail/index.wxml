<view class="page vocabulary-catalog-page">
  <view class="page-head">
    <view class="eyebrow">教师管理</view>
    <view class="title">学生词库</view>
    <view class="subtitle">先看每名学生已经配置的词库；进入具体学生后，才读取学习记录和单词明细。</view>
  </view>

  <view class="card state-card" wx:if="{{loading}}">正在读取词库目录…</view>
  <view class="card state-card state-error" wx:elif="{{noPermission}}">
    <view>{{message}}</view>
    <view class="retry-link" bindtap="loadCatalog">重新加载</view>
  </view>
  <view class="card state-card" wx:elif="{{!students.length}}">目前还没有可管理的学生。</view>

  <view
    class="card student-catalog-card {{item.studentId === requestedStudentId ? 'student-catalog-focus' : ''}}"
    wx:for="{{students}}"
    wx:key="studentId"
  >
    <view class="student-head">
      <view>
        <view class="student-name">{{item.name}}</view>
        <view class="student-meta">{{item.grade}} · {{item.libraryCount}} 个已配置词库</view>
      </view>
      <view class="state-pill {{item.enabled ? 'state-on' : 'state-off'}}">{{item.stateLabel}}</view>
    </view>

    <view class="disabled-note" wx:if="{{!item.enabled}}">当前展示预配置；开启背词后同步到学生端。</view>

    <view class="library-list" wx:if="{{item.libraries.length}}">
      <view class="library-row" wx:for="{{item.libraries}}" wx:key="id" wx:for-item="library">
        <view class="library-main">
          <view class="library-name">{{library.label}}</view>
          <view class="library-edition" wx:if="{{library.edition}}">{{library.edition}}</view>
          <view class="library-scope" wx:if="{{library.scopeLabel}}">{{library.scopeLabel}}</view>
        </view>
        <view class="library-count"><text>{{library.wordCount}}</text> 词</view>
      </view>
    </view>
    <view class="empty-library" wx:else>尚未选择课本或基础词库。</view>

    <view class="mistake-source" wx:if="{{item.mistakeWordsEnabled}}">
      <text>错题单词</text>
      随学生错题自动整理，动态数量进入管理页后查看
    </view>

    <view class="manage-button" data-id="{{item.studentId}}" bindtap="openStudentVocabulary">
      进入英语学习设置
      <text>→</text>
    </view>
  </view>
</view>
