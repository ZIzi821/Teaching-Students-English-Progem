.vocabulary-catalog-page {
  padding-bottom: 100rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: #4f8f73;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 8rpx;
  color: #243f35;
  font-size: 43rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 10rpx;
  color: #7b7064;
  font-size: 24rpx;
  line-height: 1.55;
}

.state-card {
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: center;
}

.state-error {
  color: #8a6730;
  background: #fff7e7;
}

.retry-link {
  margin-top: 12rpx;
  color: #36795e;
  font-weight: 700;
}

.student-catalog-card {
  padding: 25rpx;
}

.student-catalog-focus {
  border-color: #9fcbb7;
  box-shadow: 0 9rpx 24rpx rgba(60, 116, 91, 0.12);
}

.student-head,
.library-row,
.manage-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.student-name {
  color: #244c3d;
  font-size: 33rpx;
  font-weight: 800;
}

.student-meta {
  margin-top: 6rpx;
  color: #83776b;
  font-size: 21rpx;
}

.state-pill {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.state-on {
  color: #36795e;
  background: #e3f1ea;
}

.state-off {
  color: #8a704f;
  background: #f3eadf;
}

.disabled-note,
.empty-library {
  margin-top: 17rpx;
  padding: 15rpx 17rpx;
  border-radius: 13rpx;
  color: #846b49;
  background: #faf1df;
  font-size: 21rpx;
  line-height: 1.5;
}

.library-list {
  overflow: hidden;
  margin-top: 18rpx;
  border: 1rpx solid #e5ddd1;
  border-radius: 16rpx;
  background: #fffefa;
}

.library-row {
  padding: 19rpx 20rpx;
  border-bottom: 1rpx solid #eee7de;
}

.library-row:last-child {
  border-bottom: 0;
}

.library-main {
  min-width: 0;
  flex: 1;
}

.library-name {
  color: #354d43;
  font-size: 25rpx;
  font-weight: 800;
}

.library-edition,
.library-scope {
  margin-top: 5rpx;
  color: #8a7d70;
  font-size: 19rpx;
  line-height: 1.45;
}

.library-count {
  flex-shrink: 0;
  color: #7d7266;
  font-size: 20rpx;
}

.library-count text {
  color: #39765d;
  font-size: 28rpx;
  font-weight: 900;
}

.mistake-source {
  margin-top: 15rpx;
  color: #776b60;
  font-size: 20rpx;
  line-height: 1.5;
}

.mistake-source text {
  margin-right: 9rpx;
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  color: #9a5e45;
  background: #fae9df;
  font-weight: 800;
}

.manage-button {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 15rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 24rpx;
  font-weight: 800;
}

.manage-button text {
  font-size: 27rpx;
}
