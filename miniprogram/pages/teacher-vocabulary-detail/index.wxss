.vocabulary-catalog-page {
  padding-bottom: 100rpx;
}

.page-head {
  margin-bottom: 24rpx;
}

.eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.55;
}

.state-card {
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.state-error {
  color: var(--warn);
  background: var(--warn-soft);
}

.retry-link {
  margin-top: 12rpx;
  color: var(--accent);
  font-weight: 600;
}

.student-catalog-card {
  padding: 25rpx;
}

.student-catalog-focus {
  border-color: var(--accent-line);
}

.student-head,
.library-row,
.manage-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.student-name {
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
}

.student-meta {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.state-pill {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.state-on {
  color: var(--accent);
  background: var(--accent-soft);
}

.state-off {
  color: var(--ink-2);
  background: var(--line);
}

.disabled-note,
.empty-library {
  margin-top: 17rpx;
  padding: 15rpx 17rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
  background: var(--warn-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.library-list {
  overflow: hidden;
  margin-top: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
}

.library-row {
  padding: 19rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}

.library-row:last-child {
  border-bottom: 0;
}

.library-main {
  min-width: 0;
  flex: 1;
}

.library-name {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.library-edition,
.library-scope {
  margin-top: 5rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.45;
}

.library-count {
  flex-shrink: 0;
  color: var(--ink-2);
  font-size: 24rpx;
}

.library-count text {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.mistake-source {
  margin-top: 15rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.mistake-source text {
  margin-right: 9rpx;
  padding: 5rpx 9rpx;
  border-radius: 999rpx;
  color: var(--danger);
  background: var(--warn-soft);
  font-weight: 600;
}

.manage-button {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.manage-button text {
  font-size: 30rpx;
}
