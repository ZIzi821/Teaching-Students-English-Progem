.page { gap: 16rpx; }.tabs { display: flex; gap: 12rpx; }.tabs view { flex: 1; padding: 16rpx; text-align: center; background: #f5ead8; border-radius: 14rpx; }.tabs .on { background: #4f8f73; color: #fff; }.state-card { text-align: center; color: #817669; }.error { color: #9c463b; }.retry { margin-top: 16rpx; font-size: 24rpx; }.title { font-size: 32rpx; font-weight: 700; }.small { margin-top: 10rpx; color: #817669; }.completion { margin-top: 12rpx; color: #326d56; font-size: 24rpx; }.answer, .reference { margin-top: 18rpx; padding: 16rpx; background: #eef7f1; line-height: 1.6; }.tokens { margin-top: 16rpx; }.tokens button { display: inline-block; margin: 0 10rpx 10rpx 0; font-size: 24rpx; } textarea { width: 100%; min-height: 110rpx; margin-top: 16rpx; padding: 14rpx; box-sizing: border-box; background: #fffdfa; }.card > button { margin: 18rpx 10rpx 0 0; font-size: 24rpx; }.result { margin-top: 16rpx; color: #326d56; }
