.page { gap: 16rpx; }.tabs { display: flex; gap: 12rpx; }.tabs view { flex: 1; padding: 16rpx; text-align: center; background: var(--line); border-radius: 16rpx; }.tabs .on { background: var(--accent); color: var(--on-fill); }.state-card { text-align: center; color: var(--ink-2); }.error { color: var(--danger); }.retry { margin-top: 16rpx; font-size: 26rpx; }.title { font-size: 34rpx; font-weight: 600; }.small { margin-top: 10rpx; color: var(--ink-2); }.completion { margin-top: 12rpx; color: var(--accent); font-size: 26rpx; }.answer, .reference { margin-top: 18rpx; padding: 16rpx; background: var(--accent-soft); line-height: 1.6; }.tokens { margin-top: 16rpx; }.tokens button { display: inline-block; margin: 0 10rpx 10rpx 0; font-size: 26rpx; } textarea { width: 100%; min-height: 110rpx; margin-top: 16rpx; padding: 14rpx; box-sizing: border-box; background: var(--surface); }.card > button { margin: 18rpx 10rpx 0 0; font-size: 26rpx; }.result { margin-top: 16rpx; color: var(--accent); }
