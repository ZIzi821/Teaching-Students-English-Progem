<view class="page">
  <teacher-preview-banner wx:if="{{isTeacherPreview}}"></teacher-preview-banner>
  <view class="tabs" aria-label="选择法语等级">
    <view data-level="A1" class="{{level === 'A1' ? 'on' : ''}}" bindtap="switchLevel">A1</view>
    <view data-level="A2" class="{{level === 'A2' ? 'on' : ''}}" bindtap="switchLevel">A2</view>
  </view>
  <view class="card state-card" wx:if="{{loading}}">正在准备语法…</view>
  <view class="card state-card error" wx:elif="{{message}}"><view>{{message}}</view><button class="retry" bindtap="load">重试</button></view>
  <view class="card state-card" wx:elif="{{!items.length}}">这个等级暂时没有语法卡，稍后再来看看。</view>
  <view wx:for="{{items}}" wx:key="id" class="card grammar" data-id="{{item.id}}" bindtap="toggle">
    <view class="title">{{item.titleCN}} <text>{{openId === item.id ? '⌃' : '⌄'}}</text></view>
    <view class="small">{{item.title}}</view>
    <view class="completion" wx:if="{{item.completed}}">已完成</view>
    <block wx:if="{{openId === item.id}}">
      <view class="explain">{{item.shortExplanationCN}}</view><view class="pattern">{{item.pattern}}</view>
      <view wx:for="{{item.examples}}" wx:for-item="example" wx:key="text" class="example">{{example.text}}<view>{{example.meaningCN}}</view></view>
      <view class="mistake" wx:if="{{item.commonMistakesText}}">易错：{{item.commonMistakesText}}</view>
      <button wx:if="{{!isTeacherPreview}}" data-id="{{item.id}}" catchtap="complete" disabled="{{item.completed || savingId === item.id}}">{{item.completed ? '已完成' : (savingId === item.id ? '保存中…' : '标记完成')}}</button>
    </block>
  </view>
</view>
