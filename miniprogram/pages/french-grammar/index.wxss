.page { gap: 16rpx; }
.tabs { display: flex; gap: 12rpx; }
.tabs view { flex: 1; padding: 16rpx; text-align: center; background: #f5ead8; border-radius: 14rpx; }
.tabs .on { background: #4f8f73; color: #fff; }
.state-card { text-align: center; color: #817669; }
.error { color: #9c463b; }
.retry { margin-top: 16rpx; font-size: 24rpx; }
.title { font-size: 30rpx; font-weight: 700; color: #3d352e; }
.title text { float: right; }
.small, .explain, .mistake { margin-top: 12rpx; color: #817669; font-size: 24rpx; line-height: 1.6; }
.completion { margin-top: 12rpx; color: #326d56; font-size: 24rpx; }
.pattern { margin-top: 16rpx; padding: 14rpx; background: #eef7f1; color: #326d56; }
.example { margin-top: 12rpx; line-height: 1.6; }
.grammar button { margin-top: 18rpx; font-size: 24rpx; }
