.page { gap: 16rpx; }.tabs { display: flex; gap: 12rpx; }.tabs view { flex: 1; padding: 16rpx; text-align: center; background: var(--line); border-radius: 16rpx; }.tabs .on { background: var(--accent); color: var(--on-fill); }.state-card { text-align: center; color: var(--ink-2); }.error { color: var(--danger); }.retry { margin-top: 16rpx; font-size: 24rpx; }.situation, .en { color: var(--ink-2); font-size: 24rpx; }.french { margin: 14rpx 0; font-size: 40rpx; font-weight: 600; color: var(--accent); }.example { margin-top: 14rpx; padding: 14rpx; background: var(--warn-soft); line-height: 1.55; }.completion { margin-top: 14rpx; color: var(--accent); font-size: 24rpx; }.card button { margin: 18rpx 10rpx 0 0; font-size: 24rpx; }
