.workbench-page {
  padding-top: 24rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.workbench-hero {
  margin-bottom: 28rpx;
  padding: 34rpx 30rpx;
  overflow: hidden;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.55;
}

.status-card,
.no-permission {
  color: var(--ink-2);
  text-align: center;
}

.overview-grid,
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.overview-card {
  padding: 25rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 24rpx;
  background: var(--accent-soft);
}

.hidden-overview-card {
  border-color: var(--line);
  background: var(--warn-soft);
}

.overview-number {
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

.overview-label {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.quick-card {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 15rpx;
  padding: 22rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.quick-mark {
  display: flex;
  flex: 0 0 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.quick-mark-add {
  color: var(--warn);
  background: var(--line);
  font-size: 34rpx;
}

.quick-mark-lesson {
  background: var(--ink-3);
}

.quick-mark-ket {
  color: var(--warn);
  background: var(--line);
}

.quick-mark-engagement {
  color: var(--warn);
  background: var(--warn-soft);
}

.quick-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
}

.quick-hint {
  margin-top: 5rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.archive-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 38rpx 0 18rpx;
}

.archive-title {
  margin: 0;
}

.archive-hint {
  max-width: 560rpx;
  margin-top: 9rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.55;
}

.archive-count {
  display: flex;
  min-width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--line);
  font-size: 24rpx;
  font-weight: 600;
}

.empty-card {
  padding: 42rpx 26rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 34rpx;
  font-weight: 600;
}

.empty-title {
  margin-top: 16rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.55;
}

.hidden-student-card {
  padding: 24rpx;
}

.hidden-student-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 70rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 30rpx;
  font-weight: 600;
}

.student-info {
  min-width: 0;
  flex: 1;
}

.student-name {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.nickname {
  color: var(--ink-3);
  font-size: 24rpx;
  font-weight: 400;
}

.student-meta,
.student-note {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.student-note {
  color: var(--accent);
}

.restore-btn {
  margin-top: 20rpx;
  padding: 17rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.restore-disabled {
  opacity: 0.58;
}

.calibration-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.calibration-hint {
  color: var(--ink-3);
  font-size: 26rpx;
}

.calibration-group {
  margin-bottom: 24rpx;
}

.calibration-empty {
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}
