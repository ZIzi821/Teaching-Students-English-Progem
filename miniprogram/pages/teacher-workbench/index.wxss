.workbench-page {
  padding-top: 24rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.workbench-hero {
  margin-bottom: 28rpx;
  padding: 34rpx 30rpx;
  overflow: hidden;
  border-radius: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #315c4b 0%, #4f8f73 60%, #76a88d 100%);
  box-shadow: 0 16rpx 34rpx rgba(56, 105, 82, 0.2);
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.55;
}

.status-card,
.no-permission {
  color: #74695e;
  text-align: center;
}

.overview-grid,
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.overview-card {
  padding: 25rpx;
  border: 1rpx solid #dfe9e3;
  border-radius: 20rpx;
  background: #f2f8f5;
}

.hidden-overview-card {
  border-color: #eadfce;
  background: #fff9f0;
}

.overview-number {
  color: #315c4b;
  font-size: 42rpx;
  font-weight: 800;
}

.overview-label {
  margin-top: 4rpx;
  color: #786e63;
  font-size: 23rpx;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #342f29;
  font-size: 29rpx;
  font-weight: 750;
}

.quick-card {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 15rpx;
  padding: 22rpx 18rpx;
  border: 1rpx solid #eadfcf;
  border-radius: 19rpx;
  background: #fffdfa;
}

.quick-mark {
  display: flex;
  flex: 0 0 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 23rpx;
  font-weight: 800;
}

.quick-mark-add {
  color: #745a38;
  background: #f0dfc4;
  font-size: 32rpx;
}

.quick-mark-lesson {
  background: #7b6a53;
}

.quick-mark-ket {
  color: #6e572b;
  background: #f3e9ce;
}

.quick-title {
  color: #39332d;
  font-size: 25rpx;
  font-weight: 700;
}

.quick-hint {
  margin-top: 5rpx;
  color: #8a7e72;
  font-size: 20rpx;
}

.archive-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 38rpx 0 18rpx;
}

.archive-title {
  margin: 0;
}

.archive-hint {
  max-width: 560rpx;
  margin-top: 9rpx;
  color: #84796d;
  font-size: 22rpx;
  line-height: 1.55;
}

.archive-count {
  display: flex;
  min-width: 46rpx;
  height: 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #775b38;
  background: #f2e3ca;
  font-size: 22rpx;
  font-weight: 700;
}

.empty-card {
  padding: 42rpx 26rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #4f8f73;
  background: #e7f3ed;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 16rpx;
  color: #403931;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-hint {
  margin-top: 8rpx;
  color: #8a7e72;
  font-size: 22rpx;
  line-height: 1.55;
}

.hidden-student-card {
  padding: 24rpx;
}

.hidden-student-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  flex: 0 0 70rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #6a5841;
  background: #eadfce;
  font-size: 29rpx;
  font-weight: 800;
}

.student-info {
  min-width: 0;
  flex: 1;
}

.student-name {
  color: #38322c;
  font-size: 28rpx;
  font-weight: 750;
}

.nickname {
  color: #8d8277;
  font-size: 22rpx;
  font-weight: 400;
}

.student-meta,
.student-note {
  margin-top: 7rpx;
  color: #81776c;
  font-size: 22rpx;
}

.student-note {
  color: #4f8f73;
}

.restore-btn {
  margin-top: 20rpx;
  padding: 17rpx;
  border-radius: 14rpx;
  color: #39765d;
  background: #e9f4ee;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.restore-disabled {
  opacity: 0.58;
}
