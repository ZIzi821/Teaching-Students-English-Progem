<view class="page workbench-page {{isTeacher ? 'has-teacher-tabbar' : ''}}">
  <view class="workbench-hero">
    <view class="hero-kicker">TEACHER MANAGEMENT</view>
    <view class="title">教师管理</view>
    <view class="subtitle">学生账号、课程记录和隐藏资料集中在这里。</view>
  </view>

  <view class="card status-card" wx:if="{{loading}}">正在整理工作台…</view>
  <view class="card no-permission" wx:elif="{{noPermission}}">{{message}}</view>

  <block wx:elif="{{isTeacher}}">
    <view class="overview-grid">
      <view class="overview-card">
        <view class="overview-number">{{activeCount}}</view>
        <view class="overview-label">当前学生</view>
      </view>
      <view class="overview-card hidden-overview-card">
        <view class="overview-number">{{hiddenCount}}</view>
        <view class="overview-label">已隐藏学生</view>
      </view>
    </view>

    <view class="section-title">快捷管理</view>
    <view class="quick-grid">
      <view class="quick-card" bindtap="goStudents">
        <view class="quick-mark">生</view>
        <view><view class="quick-title">管理当前学生</view><view class="quick-hint">查看、设置或隐藏学生</view></view>
      </view>
      <view class="quick-card" bindtap="goAddStudent">
        <view class="quick-mark quick-mark-add">＋</view>
        <view><view class="quick-title">添加学生</view><view class="quick-hint">建立新的学习账号</view></view>
      </view>
      <view class="quick-card" bindtap="goAddLesson">
        <view class="quick-mark quick-mark-lesson">课</view>
        <view><view class="quick-title">建立课程记录</view><view class="quick-hint">课后记录、任务与学生录音</view></view>
      </view>
      <view class="quick-card" bindtap="goKetMockLibrary">
        <view class="quick-mark quick-mark-ket">K</view>
        <view><view class="quick-title">KET 模拟录音库</view><view class="quick-hint">逐套准备考官与虚拟搭档音频</view></view>
      </view>
      <view class="quick-card" bindtap="goEngagementManager">
        <view class="quick-mark quick-mark-engagement">榜</view>
        <view><view class="quick-title">成就与 PK 管理</view><view class="quick-hint">参榜学生、挑战选手与分数规则</view></view>
      </view>
    </view>

    <view class="archive-head">
      <view>
        <view class="section-title archive-title">已隐藏学生</view>
        <view class="archive-hint">隐藏后，访问码、课程、错题和学习进度继续保留；可随时恢复学生。</view>
      </view>
      <view class="archive-count">{{hiddenCount}}</view>
    </view>

    <view class="card empty-card" wx:if="{{!hiddenStudents.length}}">
      <view class="empty-icon">✓</view>
      <view class="empty-title">目前没有隐藏学生</view>
      <view class="empty-hint">在“管理当前学生”页面点击学生卡片右侧的“隐藏”即可移入这里。</view>
    </view>

    <view class="card hidden-student-card" wx:for="{{hiddenStudents}}" wx:key="_id">
      <view class="hidden-student-main">
        <view class="avatar">{{item.initial}}</view>
        <view class="student-info">
          <view class="student-name">{{item.name}} <text class="nickname">{{item.nickname}}</text></view>
          <view class="student-meta">{{item.grade || '年级未设置'}} · {{item.learningLabel}}</view>
          <view class="student-note">资料和记录完整保留</view>
        </view>
      </view>
      <view
        class="restore-btn {{restoringId === item._id ? 'restore-disabled' : ''}}"
        data-id="{{item._id}}"
        data-name="{{item.name}}"
        bindtap="restoreStudent"
      >{{restoringId === item._id ? '恢复中…' : '恢复到学生列表'}}</view>
    </view>
  </block>

  <teacher-tabbar wx:if="{{isTeacher}}" current="workbench"></teacher-tabbar>
</view>
