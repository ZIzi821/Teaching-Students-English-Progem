.vocabulary-page {
  padding-bottom: 96rpx;
}

.message-card,
.loading-card {
  color: var(--ink-2);
  text-align: center;
}

.retry-action {
  margin-top: 16rpx;
  color: var(--accent);
  font-weight: 500;
}

.action-disabled {
  opacity: 0.5;
}

.vocab-head {
  margin: 0 4rpx 16rpx;
}

.vocab-kicker {
  color: var(--ink-3);
  font-size: 26rpx;
}

.vocab-title {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.vocab-note {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.hero-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-progress {
  flex-shrink: 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.hero-progress-number {
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

.hero-bar {
  margin-top: 16rpx;
}

.feature-disabled-card {
  border-color: var(--warn-line);
  background: var(--warn-soft);
}

.disabled-title {
  color: var(--warn);
  font-weight: 600;
}

.disabled-hint {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.catalog-detail-button {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.catalog-detail-title {
  font-size: 34rpx;
  font-weight: 600;
}

.catalog-detail-hint {
  margin-top: 4rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.catalog-source-note {
  margin: 16rpx 4rpx 0;
  color: var(--ink-3);
  font-size: 26rpx;
}

.catalog-empty,
.empty {
  padding: 48rpx 24rpx;
  border: 1rpx dashed var(--line-strong);
  border-radius: 24rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}

.view-mode-tip {
  margin: 0 4rpx 8rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.section-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.section-hint {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* 单词 */
.library-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 28rpx;
}

.library-toggle-title {
  color: var(--ink);
  font-weight: 500;
}

.library-toggle-hint {
  color: var(--ink-3);
  font-size: 26rpx;
}

.library-toggle-action {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
}

.word-tools {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.word-search {
  box-sizing: border-box;
  min-width: 0;
  height: 76rpx;
  flex: 1;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  font-size: 30rpx;
}

.clear-search {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 26rpx;
}

.search-scope-hint,
.result-count {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.filter-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.filter-picker {
  min-width: 0;
}

.filter-value {
  overflow: hidden;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--ink);
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface);
  font-size: 26rpx;
}

.tab-active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
  font-weight: 500;
}

.word-list-heading {
  margin: 24rpx 4rpx 16rpx;
}

.word-card {
  margin-bottom: 16rpx;
  padding: 24rpx 28rpx;
}

.word-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.word-meta-actions {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.source-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
  font-weight: 500;
}

.mistake-badge {
  color: var(--danger);
  background: var(--danger-soft);
}

.word-progress {
  overflow: hidden;
  color: var(--ink-3);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pronunciation-btn {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--accent);
  font-size: 24rpx;
}

.pronunciation-playing {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
}

.word-card-main {
  margin-top: 16rpx;
}

.word-text {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-word;
}

.word-level,
.word-edition,
.word-memory-schedule {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.meaning-hidden {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  color: var(--ink-3);
  background: var(--surface-2);
  font-size: 26rpx;
}

.meaning-question {
  font-weight: 600;
}

.meaning-shown {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.part-of-speech {
  color: var(--ink-3);
  font-size: 26rpx;
}

.meaning-text {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 500;
  word-break: break-word;
}

.source-context {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  word-break: break-word;
}

.source-link {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 26rpx;
}

.review-actions-four {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
}

.review-btn {
  display: flex;
  min-height: 80rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.forgot-btn {
  color: var(--danger);
  background: var(--danger-soft);
}

.hard-btn {
  color: var(--warn);
  background: var(--warn-soft);
}

.known-btn {
  color: var(--on-fill);
  background: var(--accent);
}

.easy-btn {
  color: var(--accent);
  background: var(--accent-soft);
}

.review-waiting {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  text-align: center;
}

.restore-word-btn {
  margin-top: 16rpx;
  padding: 14rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--accent);
  font-size: 26rpx;
  text-align: center;
}

.load-more-btn {
  padding: 24rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

/* 进度 */
.daily-goal-head,
.teacher-daily-head,
.weekly-head,
.memory-scheduler-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.daily-goal-head > view:first-child,
.teacher-daily-head > view:first-child,
.weekly-head > view:first-child,
.memory-scheduler-head > view:first-child {
  min-width: 0;
  flex: 1;
}

.daily-goal-current,
.teacher-daily-count {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
}

.daily-goal-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 20rpx;
}

.daily-goal-option {
  min-width: 88rpx;
  box-sizing: border-box;
  padding: 10rpx 16rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  text-align: center;
}

.daily-goal-option-active {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
}

.daily-goal-option-disabled {
  opacity: 0.4;
}

.reviewed-word-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.reviewed-word-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
}

.insight-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.insight-card {
  min-width: 0;
  margin-bottom: 0;
  padding: 24rpx 16rpx;
}

.insight-title {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.weekly-streak {
  flex-shrink: 0;
  max-width: 260rpx;
  color: var(--accent);
  font-size: 24rpx;
  text-align: right;
}

.weekly-summary {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.memory-scheduler-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
}

.memory-retention-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
}

.memory-retention-value {
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.memory-retention-label,
.memory-risk-copy {
  color: var(--ink-3);
  font-size: 26rpx;
}

.memory-risk-copy {
  min-width: 0;
  flex: 1;
}

.memory-load-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
}

.memory-load-item {
  padding: 16rpx 4rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  text-align: center;
}

.memory-load-value {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.memory-load-label {
  color: var(--ink-3);
  font-size: 24rpx;
}

.memory-empty,
.memory-disclaimer {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* 待确认 */
.pending-section > .section-hint {
  margin: 4rpx 4rpx 16rpx;
}

.pending-word-card {
  margin-bottom: 16rpx;
}

.pending-word-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pending-word {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
  word-break: break-word;
}

.pending-field {
  margin-top: 20rpx;
}

.pending-label {
  margin-bottom: 8rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.pending-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 12rpx;
  font-size: 30rpx;
}

.pending-actions {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.pending-btn {
  min-height: 80rpx;
  font-size: 26rpx;
}

.ignore-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  color: var(--ink-2);
}
