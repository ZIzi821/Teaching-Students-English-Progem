.vocabulary-page {
  padding-bottom: 90rpx;
}

.message-card,
.loading-card {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.retry-action {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 24rpx;
  font-weight: 600;
}

.vocabulary-hero {
  padding: 34rpx 30rpx;
  background: var(--accent-soft);
}

.hero-eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.hero-progress {
  margin-top: 22rpx;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.hero-progress-number {
  font-size: 52rpx;
  line-height: 1;
}

.hero-meta {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.hero-action {
  display: inline-flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.insight-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.insight-card {
  min-width: 0;
  margin-bottom: 16rpx;
  padding: 22rpx 18rpx;
}

.insight-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.weekly-card {
  padding-bottom: 22rpx;
}

.weekly-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.weekly-head .section-hint {
  margin-bottom: 0;
}

.weekly-streak {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.weekly-summary {
  color: var(--ink-2);
  font-size: 22rpx;
  text-align: center;
}

.memory-scheduler-card {
  padding: 28rpx;
  background: var(--accent-soft);
}

.memory-scheduler-head,
.memory-retention-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.memory-scheduler-head .section-hint {
  margin-bottom: 0;
}

.memory-scheduler-badge {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.memory-retention-row {
  align-items: flex-end;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
}

.memory-retention-value {
  color: var(--accent);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1;
}

.memory-retention-label,
.memory-load-label {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.memory-risk-copy {
  max-width: 390rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: right;
}

.memory-load-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.memory-load-item {
  min-width: 0;
  padding: 18rpx 6rpx;
  border-radius: 16rpx;
  background: var(--surface);
  text-align: center;
}

.memory-load-value {
  color: var(--warn);
  font-size: 32rpx;
  font-weight: 600;
}

.memory-empty {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 1.6;
}

.memory-disclaimer {
  margin-top: 16rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.word-memory-schedule {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 650;
}

.daily-goal-card,
.teacher-daily-card {
  background: var(--surface);
}

.daily-goal-head,
.teacher-daily-head,
.library-toggle,
.word-meta-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.daily-goal-head .section-hint,
.teacher-daily-head .section-hint {
  margin-bottom: 0;
}

.daily-goal-current,
.teacher-daily-count {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.daily-goal-options {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.daily-goal-option {
  box-sizing: border-box;
  min-height: 68rpx;
  padding: 17rpx 4rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.daily-goal-option-active {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
}

.daily-goal-option-disabled {
  opacity: 0.4;
}

.reviewed-word-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.reviewed-word-chip {
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
}

.feature-disabled-card {
  color: var(--ink-2);
  background: var(--warn-soft);
}

.disabled-title {
  font-size: 32rpx;
  font-weight: 600;
}

.disabled-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.catalog-hero {
  padding: 32rpx 28rpx;
  background: var(--accent-soft);
}

.catalog-eyebrow {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.catalog-title {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.catalog-subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.6;
}

.catalog-goal {
  display: inline-flex;
  margin-top: 19rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 600;
}

.catalog-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 30rpx 2rpx 17rpx;
}

.catalog-section-head .section-hint {
  margin-bottom: 0;
}

.catalog-count {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.catalog-library-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 23rpx;
}

.catalog-library-mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.catalog-library-copy {
  min-width: 0;
  flex: 1;
}

.catalog-library-name {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.catalog-library-edition,
.catalog-library-scope {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.catalog-library-state {
  flex-shrink: 0;
  padding: 7rpx 11rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.catalog-empty {
  color: var(--ink-2);
  font-size: 22rpx;
  text-align: center;
}

.catalog-source-note {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.catalog-detail-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 23rpx 25rpx;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.catalog-detail-title {
  font-size: 28rpx;
  font-weight: 600;
}

.catalog-detail-hint {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  line-height: 1.45;
}

.catalog-detail-button > text {
  flex-shrink: 0;
  font-size: 32rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  margin-bottom: 0;
  padding: 22rpx 8rpx;
  text-align: center;
}

.summary-number {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.summary-label {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.view-mode-tip {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  line-height: 1.5;
}

.challenge-entry {
  background: var(--surface);
}

.challenge-entry .section-title,
.challenge-entry .section-hint {
  margin-bottom: 0;
}

.challenge-entry-copy {
  min-width: 0;
}

.challenge-weak-count {
  margin-top: 12rpx;
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 600;
}

.challenge-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.challenge-primary,
.challenge-secondary {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.challenge-primary {
  flex: 1;
  color: var(--on-fill);
  background: var(--accent);
}

.challenge-secondary {
  padding: 0 22rpx;
  color: var(--accent);
  background: var(--surface);
  border: 1rpx solid var(--accent-line);
}

.tab-bar {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: var(--line);
}

.tab-item {
  flex: 1;
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.word-tools {
  margin-top: 20rpx;
  padding: 20rpx;
}

.search-scope-hint {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.search-row,
.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.word-search {
  box-sizing: border-box;
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: var(--ink);
  background: var(--surface-2);
  font-size: 24rpx;
}

.clear-search {
  padding: 18rpx 10rpx;
  color: var(--danger);
  font-size: 22rpx;
}

.filter-row {
  margin-top: 14rpx;
}

.filter-picker {
  min-width: 0;
  flex: 1;
}

.filter-value {
  overflow: hidden;
  padding: 17rpx 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  color: var(--ink-2);
  background: var(--surface);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-count {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  text-align: right;
}

.tab-active {
  color: var(--accent);
  background: var(--surface);
}

.library-toggle {
  min-height: 92rpx;
}

.library-toggle-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.library-toggle-hint {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.library-toggle-action {
  flex-shrink: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.browse-panel {
  margin-bottom: 24rpx;
}

.word-list-heading {
  margin: 30rpx 4rpx 18rpx;
}

.word-list-heading .section-hint {
  margin-bottom: 0;
}

.source-filters {
  width: 100%;
  margin: 20rpx 0 22rpx;
  white-space: nowrap;
}

.source-filter-row {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.source-filter {
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface);
  font-size: 22rpx;
}

.source-filter-active {
  border-color: var(--accent);
  color: var(--on-fill);
  background: var(--accent);
}

.empty {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.word-card {
  padding: 24rpx;
}

.word-meta-row,
.pending-word-head,
.review-actions,
.pending-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.source-badge {
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
}

.mistake-badge {
  color: var(--warn);
  background: var(--warn-soft);
}

.word-progress {
  color: var(--ink-2);
  font-size: 22rpx;
}

.word-meta-row {
  align-items: flex-start;
}

.word-meta-row .source-badge {
  max-width: 290rpx;
}

.word-meta-actions {
  flex-shrink: 0;
  justify-content: flex-end;
}

.pronunciation-btn {
  min-width: 104rpx;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.pronunciation-playing {
  color: var(--on-fill);
  background: var(--accent);
}

.word-card-main {
  margin-top: 18rpx;
  padding: 28rpx 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  text-align: center;
}

.word-text {
  color: var(--accent);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.2;
  word-break: break-word;
}

.word-level {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.word-edition {
  margin-top: 4rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.meaning-hidden {
  display: flex;
  min-height: 120rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.meaning-question {
  margin-bottom: 6rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.meaning-shown {
  min-height: 120rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.part-of-speech {
  color: var(--accent);
  font-size: 22rpx;
}

.meaning-text {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.source-context {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: left;
}

.source-link {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 22rpx;
}

.review-actions {
  margin-top: 18rpx;
}

.review-waiting {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  text-align: center;
}

.restore-word-btn {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--info);
  border-radius: 16rpx;
  color: var(--info);
  background: var(--info-soft);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.review-btn {
  flex: 1;
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.review-actions-four {
  gap: 8rpx;
}

.review-actions-four .review-btn {
  padding: 18rpx 4rpx;
  font-size: 22rpx;
}

.forgot-btn {
  color: var(--warn);
  background: var(--warn-soft);
}

.known-btn {
  color: var(--on-fill);
  background: var(--accent);
}

.hard-btn {
  color: var(--ink-2);
  background: var(--line);
}

.easy-btn {
  color: var(--on-fill);
  background: var(--info);
}

.load-more-btn {
  margin: 10rpx 0 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.action-disabled {
  opacity: 0.55;
}

.pending-section {
  margin-top: 42rpx;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.section-hint {
  margin: 8rpx 0 18rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.pending-word-card {
  background: var(--surface);
}

.pending-word {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.pending-source-link {
  background: var(--accent-soft);
}

.pending-field {
  margin-top: 22rpx;
}

.pending-label {
  margin-bottom: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.pending-input {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  color: var(--ink);
  background: var(--surface-2);
  font-size: 28rpx;
}

.pending-actions {
  margin-top: 24rpx;
}

.pending-btn {
  box-sizing: border-box;
  flex: 1;
  min-height: 74rpx;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.ignore-btn {
  display: flex;
  border-radius: 16rpx;
  color: var(--danger);
  background: var(--danger-soft);
}
.learning-route-card {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
}

.route-head,
.route-step {
  display: flex;
  align-items: center;
}

.route-head {
  justify-content: space-between;
}

.route-head .section-title {
  margin-bottom: 0;
}

.route-time {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--accent-soft);
  font-size: 22rpx;
}

.route-hint {
  margin: 10rpx 0 24rpx;
}

.route-step {
  min-height: 122rpx;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--surface-2);
}

.route-step-primary {
  background: var(--accent-soft);
}

.route-number {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.route-number-secondary {
  background: var(--warn-fill);
}

.route-copy {
  min-width: 0;
  flex: 1;
}

.route-title {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.route-note {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.route-action {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.route-connector {
  width: 4rpx;
  height: 18rpx;
  margin-left: 47rpx;
  background: var(--line);
}
