.french-vocabulary-page {
  gap: 18rpx;
}

.difficult-mode-banner {
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--warn-soft);
}

.difficult-mode-kicker {
  color: var(--warn);
  font-size: 22rpx;
  font-weight: 600;
}

.difficult-mode-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.difficult-mode-copy {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.level-tabs,.search-row { display: flex; gap: 12rpx; }
.level-tab { flex: 1; padding: 14rpx; color: var(--ink-2); background: var(--line); border-radius: 16rpx; text-align: center; }
.level-tab.active { color: var(--on-fill); background: var(--accent); }
.search-row input { flex: 1; min-height: 70rpx; padding: 0 20rpx; border-radius: 16rpx; background: var(--surface); font-size: 24rpx; }
.search-btn { width: 120rpx; margin: 0; font-size: 24rpx; }
.recall-hint { margin-top: 28rpx; color: var(--ink-2); font-size: 24rpx; }
.reveal-btn { margin-top: 24rpx; }
.meaning-en,.meta,.example { margin-top: 12rpx; color: var(--ink-2); line-height: 1.55; }
.example { padding: 18rpx; border-radius: 16rpx; background: var(--warn-soft); font-size: 24rpx; }
.memory-link { margin-top: 24rpx; border: 0; color: var(--info); background: var(--info-soft); font-size: 24rpx; }

.loading-card,
.empty-card,
.feature-disabled-card {
  color: var(--ink-2);
  line-height: 1.6;
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
  line-height: 1.6;
}

.retry-btn {
  margin-top: 18rpx;
  min-height: 68rpx;
  font-size: 28rpx;
}

.feature-disabled-title,
.complete-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.feature-disabled-hint,
.complete-hint {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-label {
  color: var(--ink-2);
  font-size: 24rpx;
}

.round-hint {
  margin-top: 8rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.progress-bar {
  height: 14rpx;
  margin: 10rpx 0 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--line);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
}

.word-card {
  min-height: 440rpx;
  padding: 42rpx 32rpx;
  text-align: center;
  background: var(--surface);
}

.word-eyebrow {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.word-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 38rpx;
}

.word-text {
  color: var(--accent);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.25;
}

.audio-btn {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 32rpx;
  line-height: 76rpx;
}

.ipa {
  margin-top: 20rpx;
  color: var(--info);
  font-size: 28rpx;
}

.word-meta {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.meaning {
  margin-top: 28rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.audio-hint {
  margin-top: 36rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.rating-title {
  margin: 8rpx 0 14rpx;
  color: var(--ink-2);
  font-size: 28rpx;
  text-align: center;
}

.rating-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.rating-btn {
  min-height: 78rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.rating-btn[disabled] {
  opacity: 0.55;
}

.again-btn {
  color: var(--warn);
  background: var(--warn-soft);
}

.hard-btn {
  color: var(--ink-2);
  background: var(--line);
}

.good-btn {
  color: var(--accent);
  background: var(--accent-soft);
}

.easy-btn {
  color: var(--info);
  background: var(--info-soft);
}

.complete-card {
  text-align: center;
}

.restart-btn {
  margin-top: 28rpx;
}
