.french-memory-page {
  gap: 18rpx;
}

.loading-card,
.message-card,
.empty-card {
  color: var(--ink-2);
  line-height: 1.6;
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
}

.retry-btn {
  margin-top: 18rpx;
}

.word-card {
  text-align: center;
}

.level-label {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.word {
  margin-top: 16rpx;
  color: var(--accent);
  font-size: 52rpx;
  font-weight: 600;
}

.meaning {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.ipa,
.section-hint,
.disclaimer {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.metric {
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  text-align: center;
}

.metric-value {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.small-value {
  font-size: 28rpx;
}

.metric-label,
.history-time {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.schedule-card .section-title {
  margin-bottom: 12rpx;
}

.detail-row,
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
}

.detail-row:last-child,
.history-item:last-child {
  border-bottom: 0;
}

.detail-row text:last-child {
  max-width: 66%;
  color: var(--accent);
  text-align: right;
}

.history-rating {
  color: var(--ink);
  font-weight: 600;
}

.history-result {
  color: var(--ink-2);
  font-size: 22rpx;
  text-align: right;
}

.disclaimer {
  padding: 0 10rpx 24rpx;
}
