.form-head {
  margin-bottom: 22rpx;
}

.title {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.split-fields {
  display: flex;
  gap: 18rpx;
}

.split-field {
  min-width: 0;
  flex: 1;
}

.label {
  margin-bottom: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  font-weight: 600;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 30rpx;
}

.input,
.picker-value {
  min-height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
}

.tall {
  min-height: 220rpx;
}

.message-card {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
  line-height: 1.6;
}

.advanced-toggle,
.action-row {
  display: flex;
  align-items: center;
}

.advanced-toggle {
  justify-content: space-between;
  padding: 22rpx 0 4rpx;
  border-top: 1rpx solid var(--line);
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.advanced-fields {
  margin-top: 26rpx;
}

.quick-tip {
  margin: 20rpx 0;
  color: var(--ink-2);
  font-size: 26rpx;
  text-align: center;
}

.action-row {
  gap: 18rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
}
