.form-head {
  margin-bottom: 22rpx;
}

.title {
  color: #2f2a24;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #817669;
  font-size: 26rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #655b50;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 14rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 28rpx;
}

.input,
.picker-value {
  min-height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
}

.tall {
  min-height: 220rpx;
}

.upload-box {
  display: flex;
  min-height: 260rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed #d7c7b6;
  border-radius: 16rpx;
  background: #fffaf1;
}

.upload-text {
  color: #8f7f6d;
  font-size: 28rpx;
}

.preview {
  width: 100%;
  height: 320rpx;
}

.message-card {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}
