.form-head {
  margin-bottom: 22rpx;
}

.title {
  color: #2f2a24;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #817669;
  font-size: 26rpx;
  line-height: 1.6;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.split-fields {
  display: flex;
  gap: 18rpx;
}

.split-field {
  min-width: 0;
  flex: 1;
}

.label {
  margin-bottom: 12rpx;
  color: #655b50;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker-value,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 14rpx;
  background: #f8f2e8;
  color: #2f2a24;
  font-size: 28rpx;
}

.input,
.picker-value {
  min-height: 82rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.6;
}

.tall {
  min-height: 220rpx;
}

.message-card {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}

.advanced-toggle,
.action-row {
  display: flex;
  align-items: center;
}

.advanced-toggle {
  justify-content: space-between;
  padding: 22rpx 0 4rpx;
  border-top: 1rpx solid #eadfce;
  color: #4f8f73;
  font-size: 27rpx;
  font-weight: 600;
}

.advanced-fields {
  margin-top: 26rpx;
}

.quick-tip {
  margin: 20rpx 0;
  color: #817669;
  font-size: 24rpx;
  text-align: center;
}

.action-row {
  gap: 18rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
}
