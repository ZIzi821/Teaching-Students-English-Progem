.homework-page {
  gap: 22rpx;
}

.preview-banner,
.task-top,
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.preview-banner {
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.preview-title {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.preview-hint {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.4;
}

.preview-action {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.homework-head {
  padding: 18rpx 4rpx 6rpx;
}

.eyebrow {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.summary-card {
  flex: 1;
  min-width: 0;
  padding: 21rpx 10rpx;
  border-radius: 16rpx;
  text-align: center;
}

.summary-actionable {
  background: var(--warn-soft);
}

.summary-awaiting {
  background: var(--info-soft);
}

.summary-completed {
  background: var(--accent-soft);
}

.summary-number {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.summary-label {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  white-space: nowrap;
}

.homework-section {
  margin-top: 26rpx;
}

.section-head,
.completed-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 4rpx;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.section-hint {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.45;
}

.section-count {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.section-returned .section-count,
.status-returned {
  color: var(--danger);
  background: var(--warn-soft);
}

.section-overdue .section-count,
.status-overdue {
  color: var(--danger);
  background: var(--danger-soft);
}

.section-today .section-count,
.status-today {
  color: var(--warn);
  background: var(--warn-soft);
}

.section-upcoming .section-count,
.status-upcoming {
  color: var(--accent);
  background: var(--accent-soft);
}

.section-awaiting .section-count,
.status-awaiting {
  color: var(--info);
  background: var(--info-soft);
}

.status-neutral {
  color: var(--ink-2);
  background: var(--line);
}

.task-card {
  margin-top: 14rpx;
  padding: 24rpx;
}

.task-returned {
  border-color: var(--danger-line);
  background: var(--warn-soft);
}

.task-overdue {
  border-color: var(--danger-line);
  background: var(--danger-soft);
}

.task-today {
  border-color: var(--warn-line);
  background: var(--warn-soft);
}

.task-upcoming {
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.task-neutral {
  border-color: var(--line);
  background: var(--surface);
}

.task-awaiting {
  border-color: var(--info-line);
  background: var(--info-soft);
}

.task-completed {
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.task-top {
  align-items: flex-start;
}

.task-date {
  color: var(--ink-3);
  font-size: 22rpx;
}

.task-title {
  margin-top: 7rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.task-course-type {
  display: inline-flex;
  margin-top: 9rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--line);
  font-size: 22rpx;
  font-weight: 600;
}

.status-pill {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-completed {
  color: var(--accent);
  background: var(--accent-soft);
}

.task-copy {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.task-meta {
  margin-top: 12rpx;
  color: var(--accent);
  font-size: 22rpx;
}

.task-deadline {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.deadline-upcoming {
  color: var(--accent);
  background: var(--accent-soft);
}

.deadline-today {
  color: var(--warn);
  background: var(--warn-soft);
}

.deadline-overdue,
.deadline-late {
  color: var(--danger);
  background: var(--danger-soft);
}

.task-link {
  margin-top: 17rpx;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
}

.completed-toggle {
  margin-top: 30rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.completed-toggle-action {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.empty-card {
  margin-top: 14rpx;
  text-align: center;
}

.empty-mark {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.empty-title {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.empty-hint,
.state-card,
.error-card {
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.retry {
  margin-top: 12rpx;
  color: var(--accent);
  font-weight: 600;
}
