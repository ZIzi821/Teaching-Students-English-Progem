.homework-page {
  gap: 22rpx;
}

.preview-banner,
.task-top,
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.preview-banner {
  padding: 20rpx 22rpx;
  border: 1rpx solid #b9d8c8;
  border-radius: 18rpx;
  background: #edf7f2;
}

.preview-title {
  color: #285b47;
  font-size: 25rpx;
  font-weight: 800;
}

.preview-hint {
  margin-top: 6rpx;
  color: #668073;
  font-size: 20rpx;
  line-height: 1.4;
}

.preview-action {
  flex-shrink: 0;
  color: #39765d;
  font-size: 21rpx;
  font-weight: 700;
}

.homework-head {
  padding: 18rpx 4rpx 6rpx;
}

.eyebrow {
  color: #6d8177;
  font-size: 21rpx;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  color: #2d3f37;
  font-size: 42rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 10rpx;
  color: #7a7167;
  font-size: 24rpx;
}

.summary-card {
  flex: 1;
  min-width: 0;
  padding: 21rpx 10rpx;
  border-radius: 18rpx;
  text-align: center;
}

.summary-actionable {
  background: #fff1d2;
}

.summary-awaiting {
  background: #edf2f6;
}

.summary-completed {
  background: #e6f2eb;
}

.summary-number {
  color: #355d4d;
  font-size: 38rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 4rpx;
  color: #786d61;
  font-size: 20rpx;
  white-space: nowrap;
}

.homework-section {
  margin-top: 26rpx;
}

.section-head,
.completed-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 4rpx;
}

.section-title {
  color: #3d352e;
  font-size: 30rpx;
  font-weight: 800;
}

.section-hint {
  margin-top: 6rpx;
  color: #857b70;
  font-size: 20rpx;
  line-height: 1.45;
}

.section-count {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  color: #685f55;
  background: #eee9e2;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.section-returned .section-count,
.status-returned {
  color: #985a3d;
  background: #f9dfcf;
}

.section-overdue .section-count,
.status-overdue {
  color: #9a4f48;
  background: #f8dfdc;
}

.section-today .section-count,
.status-today {
  color: #8a6730;
  background: #ffedc2;
}

.section-upcoming .section-count,
.status-upcoming {
  color: #49715f;
  background: #e2efe8;
}

.section-awaiting .section-count,
.status-awaiting {
  color: #526d7d;
  background: #e2eaf0;
}

.status-neutral {
  color: #71665a;
  background: #eee8df;
}

.task-card {
  margin-top: 14rpx;
  padding: 24rpx;
}

.task-returned {
  border-color: #e5b69e;
  background: #fff7f1;
}

.task-overdue {
  border-color: #e2aaa4;
  background: #fff7f6;
}

.task-today {
  border-color: #e5cb89;
  background: #fffbef;
}

.task-upcoming {
  border-color: #b9d4c5;
  background: #f7fbf8;
}

.task-neutral {
  border-color: #ddd2c5;
  background: #fffdfa;
}

.task-awaiting {
  border-color: #c4d2dd;
  background: #f7fafc;
}

.task-completed {
  border-color: #c2d8cc;
  background: #f8fbf9;
}

.task-top {
  align-items: flex-start;
}

.task-date {
  color: #8a7d6e;
  font-size: 21rpx;
}

.task-title {
  margin-top: 7rpx;
  color: #332f2a;
  font-size: 28rpx;
  font-weight: 800;
}

.status-pill {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.status-completed {
  color: #39765d;
  background: #dceee5;
}

.task-copy {
  margin-top: 16rpx;
  color: #62584d;
  font-size: 24rpx;
  line-height: 1.55;
}

.task-meta {
  margin-top: 12rpx;
  color: #4f7d69;
  font-size: 22rpx;
}

.task-deadline {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.deadline-upcoming {
  color: #4f7462;
  background: #e8f2ed;
}

.deadline-today {
  color: #8a6730;
  background: #ffedc2;
}

.deadline-overdue,
.deadline-late {
  color: #985148;
  background: #fae6e4;
}

.task-link {
  margin-top: 17rpx;
  color: #39765d;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
}

.completed-toggle {
  margin-top: 30rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #d3dfd8;
  border-radius: 18rpx;
  background: #f5f9f7;
}

.completed-toggle-action {
  flex-shrink: 0;
  color: #39765d;
  font-size: 21rpx;
  font-weight: 800;
}

.empty-card {
  margin-top: 14rpx;
  text-align: center;
}

.empty-mark {
  color: #4f8f73;
  font-size: 44rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 8rpx;
  color: #3f554b;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-hint,
.state-card,
.error-card {
  color: #817669;
  font-size: 23rpx;
  line-height: 1.5;
}

.retry {
  margin-top: 12rpx;
  color: #39765d;
  font-weight: 700;
}
