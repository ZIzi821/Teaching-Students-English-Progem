.page-head {
  margin-bottom: 22rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.title {
  color: #2f2a24;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #817669;
  font-size: 26rpx;
  line-height: 1.6;
}

.add-btn {
  margin-bottom: 24rpx;
}

.hidden-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #eadcc7;
  border-radius: 17rpx;
  background: #fff8ec;
}

.hidden-summary-title {
  color: #6f5534;
  font-size: 25rpx;
  font-weight: 700;
}

.hidden-summary-hint {
  margin-top: 5rpx;
  color: #96856f;
  font-size: 20rpx;
}

.hidden-summary-link {
  flex-shrink: 0;
  color: #8d6737;
  font-size: 22rpx;
  font-weight: 700;
}

.no-permission {
  color: #8a6730;
  background: #fff1cf;
  font-size: 28rpx;
  line-height: 1.6;
}

.student-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.student-card-side {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 17rpx;
}

.avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #78a98f;
  font-size: 34rpx;
  font-weight: 700;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  color: #2f2a24;
  font-size: 32rpx;
  font-weight: 700;
}

.nickname {
  color: #817669;
  font-size: 24rpx;
  font-weight: 400;
}

.student-meta {
  margin-top: 10rpx;
  color: #817669;
  font-size: 24rpx;
}

.progress-text {
  margin-top: 12rpx;
  color: #4f6f63;
  font-size: 24rpx;
}

.mini-progress {
  position: relative;
  width: 100%;
  height: 12rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0e8;
}

.mini-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4f8f73;
  transition: width 0.25s ease, background 0.25s ease;
}

.mini-progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-tone-near-end .mini-progress-fill {
  background: #c99a52;
}

.progress-tone-complete .mini-progress-fill {
  background: #b98743;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #4f8f73;
  background: #e9f4ee;
  font-size: 22rpx;
}

.hide-action {
  padding: 8rpx 14rpx;
  border: 1rpx solid #dfc9aa;
  border-radius: 999rpx;
  color: #8c6232;
  background: #fffaf2;
  font-size: 22rpx;
}

.hide-action-disabled {
  opacity: 0.5;
}

.empty-students {
  padding: 42rpx 28rpx;
  text-align: center;
}

.empty-title {
  color: #443c34;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-hint {
  margin-top: 10rpx;
  color: #897d71;
  font-size: 22rpx;
  line-height: 1.55;
}
