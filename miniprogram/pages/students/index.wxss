.page-head {
  margin-bottom: 22rpx;
}

.has-teacher-tabbar {
  padding-bottom: 180rpx;
}

.title {
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.6;
}

.add-btn {
  margin-bottom: 24rpx;
}

.hidden-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--warn-soft);
}

.hidden-summary-title {
  color: var(--warn);
  font-size: 26rpx;
  font-weight: 600;
}

.hidden-summary-hint {
  margin-top: 5rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.hidden-summary-link {
  flex-shrink: 0;
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 600;
}

.no-permission {
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 30rpx;
  line-height: 1.6;
}

.student-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.student-card-side {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  flex-direction: column;
  gap: 17rpx;
}

.avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 600;
}

.nickname {
  color: var(--ink-2);
  font-size: 26rpx;
  font-weight: 400;
}

.student-meta {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.progress-text {
  margin-top: 12rpx;
  color: var(--accent);
  font-size: 26rpx;
}

.mini-progress {
  position: relative;
  width: 100%;
  height: 12rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.mini-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent);
  transition: width 0.25s ease, background 0.25s ease;
}

.mini-progress-marker {
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  transform: translateX(-50%);
}

.progress-tone-near-end .mini-progress-fill {
  background: var(--warn-fill);
}

.progress-tone-complete .mini-progress-fill {
  background: var(--warn-fill);
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
}

.hide-action {
  padding: 8rpx 14rpx;
  border: 1rpx solid var(--warn-line);
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 24rpx;
}

.hide-action-disabled {
  opacity: 0.5;
}

.empty-students {
  padding: 42rpx 28rpx;
  text-align: center;
}

.empty-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.empty-hint {
  margin-top: 10rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.55;
}
