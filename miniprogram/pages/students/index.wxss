.page-head {
  margin-bottom: 22rpx;
}

.title {
  color: #2f2a24;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 12rpx;
  color: #817669;
  font-size: 26rpx;
  line-height: 1.6;
}

.sample-tip {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  color: #8a6730;
  background: #fff1cf;
  font-size: 24rpx;
}

.add-btn {
  margin-bottom: 24rpx;
}

.student-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #78a98f;
  font-size: 34rpx;
  font-weight: 700;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  color: #2f2a24;
  font-size: 32rpx;
  font-weight: 700;
}

.nickname {
  color: #817669;
  font-size: 24rpx;
  font-weight: 400;
}

.student-meta {
  margin-top: 10rpx;
  color: #817669;
  font-size: 24rpx;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #4f8f73;
  background: #e9f4ee;
  font-size: 22rpx;
}
