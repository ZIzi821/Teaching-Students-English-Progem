.reminder-hero {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #e3f2ea 0%, #f6eddc 100%);
}

.hero-kicker {
  color: #4f8f73;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  color: #29483b;
  font-size: 37rpx;
  font-weight: 800;
}

.hero-hint,
.editor-hint,
.section-hint,
.reminder-meta {
  color: #817669;
  font-size: 21rpx;
  line-height: 1.55;
}

.hero-hint {
  margin-top: 12rpx;
}

.status-card,
.error-card,
.empty-card {
  color: #756b60;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.editor-card {
  border-color: #cfe2d7;
}

.editor-head,
.section-head,
.reminder-card-head,
.reminder-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.editor-title,
.section-title {
  color: #30463d;
  font-size: 30rpx;
  font-weight: 800;
}

.editing-badge,
.active-badge,
.withdrawn-badge,
.section-count {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.editing-badge,
.active-badge,
.section-count {
  color: #39765d;
  background: #e4f2ea;
}

.withdrawn-badge {
  color: #85786c;
  background: #eee8df;
}

.field {
  position: relative;
  margin-top: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #4f5d56;
  font-size: 24rpx;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #ded4c7;
  border-radius: 15rpx;
  color: #332f2a;
  background: #fcfaf6;
  font-size: 26rpx;
}

.input {
  height: 82rpx;
  padding: 0 22rpx;
}

.textarea {
  min-height: 190rpx;
  padding: 20rpx 22rpx 44rpx;
  line-height: 1.6;
}

.counter {
  position: absolute;
  right: 16rpx;
  bottom: 10rpx;
  color: #aaa093;
  font-size: 18rpx;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.editor-button {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
}

.button-disabled {
  opacity: 0.62;
}

.section-head {
  margin: 32rpx 4rpx 16rpx;
}

.history-head {
  margin-top: 42rpx;
}

.reminder-card {
  padding: 24rpx;
}

.reminder-title {
  color: #32483f;
  font-size: 27rpx;
  font-weight: 800;
}

.reminder-content {
  margin-top: 14rpx;
  color: #554d45;
  font-size: 25rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.reminder-meta {
  margin-top: 14rpx;
}

.reminder-actions {
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee5da;
}

.edit-button,
.withdraw-button {
  min-width: 112rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}

.edit-button {
  color: #39765d;
  background: #e8f3ed;
}

.withdraw-button {
  color: #985148;
  background: #f9e8e5;
}

.withdrawn-card {
  opacity: 0.72;
  box-shadow: none;
}
