.reminder-hero {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
}

.hero-kicker {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 600;
}

.hero-hint,
.editor-hint,
.section-hint,
.reminder-meta {
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.hero-hint {
  margin-top: 12rpx;
}

.status-card,
.error-card,
.empty-card {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.editor-card {
  border-color: var(--accent-line);
}

.editor-head,
.section-head,
.reminder-card-head,
.reminder-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.editor-title,
.section-title {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.editing-badge,
.active-badge,
.withdrawn-badge,
.section-count {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.editing-badge,
.active-badge,
.section-count {
  color: var(--accent);
  background: var(--accent-soft);
}

.withdrawn-badge {
  color: var(--ink-3);
  background: var(--line);
}

.field {
  position: relative;
  margin-top: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  color: var(--ink);
  background: var(--surface);
  font-size: 28rpx;
}

.input {
  height: 82rpx;
  padding: 0 22rpx;
}

.textarea {
  min-height: 190rpx;
  padding: 20rpx 22rpx 44rpx;
  line-height: 1.6;
}

.counter {
  position: absolute;
  right: 16rpx;
  bottom: 10rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.editor-button {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
}

.button-disabled {
  opacity: 0.62;
}

.section-head {
  margin: 32rpx 4rpx 16rpx;
}

.history-head {
  margin-top: 42rpx;
}

.reminder-card {
  padding: 24rpx;
}

.reminder-title {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.reminder-content {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.reminder-meta {
  margin-top: 14rpx;
}

.reminder-actions {
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.edit-button,
.withdraw-button {
  min-width: 112rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.edit-button {
  color: var(--accent);
  background: var(--accent-soft);
}

.withdraw-button {
  color: var(--danger);
  background: var(--danger-soft);
}

.withdrawn-card {
  opacity: 0.72;
}
