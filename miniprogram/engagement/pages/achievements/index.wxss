.achievement-page {
  padding-bottom: 180rpx;
}

.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #b9d8c8;
  border-radius: 20rpx;
  background: #edf7f2;
}

.preview-banner > view:first-child {
  min-width: 0;
  flex: 1;
}

.preview-banner-title {
  color: #285b47;
  font-size: 26rpx;
  font-weight: 800;
}

.preview-banner-hint {
  margin-top: 7rpx;
  color: #668073;
  font-size: 21rpx;
  line-height: 1.45;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 13rpx 16rpx;
  border-radius: 13rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 22rpx;
  font-weight: 700;
}

.loading-card,
.error-card {
  color: #6e6458;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.retry-button {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #4f8f73;
  font-weight: 700;
}

.achievement-hero {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 26rpx;
  color: #fffdf8;
  background: linear-gradient(140deg, #356f58 0%, #4f8f73 55%, #d0a25c 145%);
  box-shadow: 0 16rpx 38rpx rgba(55, 104, 82, 0.2);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.76);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 18rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 800;
}

.hero-level {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
}

.point-orb {
  display: flex;
  width: 126rpx;
  height: 126rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
}

.point-number {
  font-size: 38rpx;
  font-weight: 800;
}

.point-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 20rpx;
}

.level-track,
.achievement-progress {
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.level-track {
  height: 14rpx;
  margin-top: 26rpx;
}

.level-fill,
.achievement-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #f5d99f;
}

.level-note {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 21rpx;
}

.summary-grid {
  display: grid;
  margin-bottom: 32rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.summary-card {
  padding: 22rpx 10rpx;
  border: 1rpx solid #eadfcf;
  border-radius: 18rpx;
  background: #fffdfa;
  text-align: center;
}

.summary-number {
  color: #356f58;
  font-size: 34rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 6rpx;
  color: #807467;
  font-size: 20rpx;
}

.section-head,
.pk-head,
.breakdown-row,
.recent-row,
.ranking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-head {
  margin: 6rpx 2rpx 18rpx;
}

.section-title {
  color: #2f2a24;
  font-size: 31rpx;
  font-weight: 800;
}

.card-section-title {
  font-size: 29rpx;
}

.section-hint {
  margin-top: 6rpx;
  color: #897e72;
  font-size: 21rpx;
  line-height: 1.45;
}

.section-count,
.my-rank {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #e2f1e9;
  font-size: 22rpx;
  font-weight: 700;
}

.achievement-grid {
  display: grid;
  margin-bottom: 30rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.achievement-card {
  box-sizing: border-box;
  min-height: 260rpx;
  padding: 22rpx;
  border: 1rpx solid #e6dccf;
  border-radius: 20rpx;
  background: #fffdfa;
}

.achievement-unlocked {
  border-color: #cddfd5;
  background: linear-gradient(150deg, #fffdfa 0%, #edf7f2 100%);
}

.achievement-locked {
  opacity: 0.72;
  filter: grayscale(0.45);
}

.achievement-mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #fff;
  background: #4f8f73;
  font-size: 22rpx;
  font-weight: 800;
}

.achievement-locked .achievement-mark {
  color: #766c60;
  background: #e4ddd3;
}

.achievement-title {
  margin-top: 14rpx;
  color: #31463e;
  font-size: 25rpx;
  font-weight: 800;
}

.achievement-description {
  min-height: 62rpx;
  margin-top: 7rpx;
  color: #7c7165;
  font-size: 20rpx;
  line-height: 1.45;
}

.achievement-progress {
  height: 9rpx;
  margin-top: 14rpx;
  background: #ebe4da;
}

.achievement-progress-fill {
  background: #d5a85e;
}

.achievement-state {
  margin-top: 7rpx;
  color: #8b6a37;
  font-size: 19rpx;
  text-align: right;
}

.pk-card,
.breakdown-card,
.recent-card {
  padding: 26rpx;
}

.pk-message {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #745724;
  background: #fff1cf;
  font-size: 23rpx;
}

.pk-relation-note {
  margin-top: 12rpx;
  padding: 14rpx 17rpx;
  border-radius: 14rpx;
  color: #5f675f;
  background: #edf7f2;
  font-size: 20rpx;
  line-height: 1.55;
}

.pk-relation-note view + view {
  margin-top: 5rpx;
}

.ranking-list {
  margin-top: 10rpx;
}

.ranking-row {
  min-height: 70rpx;
  border-bottom: 1rpx solid #eee5da;
}

.ranking-row:last-child {
  border-bottom: 0;
}

.ranking-current {
  margin: 0 -12rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #edf7f2;
}

.rank-mark {
  display: flex;
  width: 43rpx;
  height: 43rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #71675d;
  background: #eee8df;
  font-size: 19rpx;
  font-weight: 800;
}

.rank-1 {
  color: #7b551b;
  background: #f7d991;
}

.rank-2 {
  color: #566068;
  background: #dce2e5;
}

.rank-3 {
  color: #74452f;
  background: #e9c1a4;
}

.rank-copy {
  min-width: 0;
  flex: 1;
}

.rank-name {
  color: #3e4944;
  font-size: 25rpx;
  font-weight: 700;
}

.rank-name text {
  margin-left: 7rpx;
  padding: 3rpx 8rpx;
  border-radius: 999rpx;
  color: #805b23;
  background: #f7e4bc;
  font-size: 16rpx;
}

.rank-source {
  margin-top: 3rpx;
  color: #918579;
  font-size: 18rpx;
}

.rank-points {
  color: #39765d;
  font-size: 24rpx;
  font-weight: 800;
}

.privacy-note,
.evidence-note {
  color: #92877b;
  font-size: 20rpx;
  line-height: 1.55;
}

.privacy-note {
  margin-top: 16rpx;
}

.breakdown-row,
.recent-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eee5da;
}

.rule-summary {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #625a50;
  background: #f7f1e7;
  font-size: 20rpx;
  line-height: 1.7;
}

.breakdown-row:last-child,
.recent-row:last-child {
  border-bottom: 0;
}

.breakdown-copy {
  min-width: 0;
  flex: 1;
}

.breakdown-title,
.recent-title {
  color: #3d4843;
  font-size: 25rpx;
  font-weight: 700;
}

.breakdown-detail,
.recent-date,
.breakdown-empty {
  margin-top: 5rpx;
  color: #8b8074;
  font-size: 20rpx;
  line-height: 1.45;
}

.breakdown-empty {
  padding: 24rpx 0 8rpx;
  text-align: center;
}

.breakdown-points,
.recent-points {
  flex-shrink: 0;
  color: #b47b2a;
  font-size: 25rpx;
  font-weight: 800;
}

.recent-date {
  margin-top: 3rpx;
}

.evidence-note {
  margin: 4rpx 10rpx 22rpx;
  text-align: center;
}
