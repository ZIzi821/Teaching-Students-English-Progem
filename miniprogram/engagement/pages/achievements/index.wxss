.achievement-page {
  padding-bottom: 180rpx;
}

.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 24rpx;
  background: var(--accent-soft);
}

.preview-banner > view:first-child {
  min-width: 0;
  flex: 1;
}

.preview-banner-title {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.preview-banner-hint {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.preview-banner-action {
  flex-shrink: 0;
  padding: 13rpx 16rpx;
  border-radius: 12rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.loading-card,
.error-card {
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.retry-button {
  display: inline-flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-weight: 600;
}

.achievement-hero {
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  font-weight: 600;
}

.hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
}

.hero-level {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
}

.point-orb {
  display: flex;
  width: 126rpx;
  height: 126rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
}

.point-number {
  font-size: 40rpx;
  font-weight: 600;
}

.point-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.level-track,
.achievement-progress {
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.level-track {
  height: 14rpx;
  margin-top: 26rpx;
}

.level-fill,
.achievement-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--warn-soft);
}

.level-note {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
}

.summary-grid {
  display: grid;
  margin-bottom: 32rpx;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.summary-card {
  padding: 22rpx 10rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  text-align: center;
}

.summary-number {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.summary-label {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.section-head,
.pk-head,
.breakdown-row,
.recent-row,
.ranking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-head {
  margin: 6rpx 2rpx 18rpx;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.card-section-title {
  font-size: 28rpx;
}

.section-hint {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.45;
}

.section-count,
.my-rank {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.achievement-grid {
  display: grid;
  margin-bottom: 30rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.achievement-card {
  box-sizing: border-box;
  min-height: 260rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.achievement-unlocked {
  border-color: var(--accent-line);
  background: var(--surface);
}

.achievement-locked {
  opacity: 0.72;
  filter: grayscale(0.45);
}

.achievement-mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
}

.achievement-locked .achievement-mark {
  color: var(--ink-2);
  background: var(--line);
}

.achievement-title {
  margin-top: 14rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.achievement-description {
  min-height: 62rpx;
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.achievement-progress {
  height: 9rpx;
  margin-top: 14rpx;
  background: var(--line);
}

.achievement-progress-fill {
  background: var(--warn-fill);
}

.achievement-state {
  margin-top: 7rpx;
  color: var(--warn);
  font-size: 22rpx;
  text-align: right;
}

.pk-card,
.breakdown-card,
.recent-card {
  padding: 26rpx;
}

.pk-message {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 22rpx;
}

.pk-relation-note {
  margin-top: 12rpx;
  padding: 14rpx 17rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--accent-soft);
  font-size: 22rpx;
  line-height: 1.55;
}

.pk-relation-note view + view {
  margin-top: 5rpx;
}

.ranking-list {
  margin-top: 10rpx;
}

.ranking-row {
  min-height: 70rpx;
  border-bottom: 1rpx solid var(--line);
}

.ranking-row:last-child {
  border-bottom: 0;
}

.ranking-current {
  margin: 0 -12rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.rank-mark {
  display: flex;
  width: 43rpx;
  height: 43rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--ink-2);
  background: var(--line);
  font-size: 22rpx;
  font-weight: 600;
}

.rank-1 {
  color: var(--warn);
  background: var(--warn-soft);
}

.rank-2 {
  color: var(--ink-2);
  background: var(--info-soft);
}

.rank-3 {
  color: var(--danger);
  background: var(--warn-soft);
}

.rank-copy {
  min-width: 0;
  flex: 1;
}

.rank-name {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.rank-name text {
  margin-left: 7rpx;
  padding: 3rpx 8rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 22rpx;
}

.rank-source {
  margin-top: 3rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.rank-points {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.privacy-note,
.evidence-note {
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.55;
}

.privacy-note {
  margin-top: 16rpx;
}

.breakdown-row,
.recent-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rule-summary {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 22rpx;
  line-height: 1.7;
}

.breakdown-row:last-child,
.recent-row:last-child {
  border-bottom: 0;
}

.breakdown-copy {
  min-width: 0;
  flex: 1;
}

.breakdown-title,
.recent-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.breakdown-detail,
.recent-date,
.breakdown-empty {
  margin-top: 5rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.45;
}

.breakdown-empty {
  padding: 24rpx 0 8rpx;
  text-align: center;
}

.breakdown-points,
.recent-points {
  flex-shrink: 0;
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 600;
}

.recent-date {
  margin-top: 3rpx;
}

.evidence-note {
  margin: 4rpx 10rpx 22rpx;
  text-align: center;
}
