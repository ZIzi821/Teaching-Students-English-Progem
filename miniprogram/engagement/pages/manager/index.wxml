<view class="page manager-page">
  <view class="hero">
    <view class="eyebrow">ACHIEVEMENT &amp; PK CONTROL</view>
    <view class="hero-title">成就与 PK 管理</view>
    <view class="hero-copy">控制真实学生是否参榜，并设置公开标注的挑战选手。</view>
  </view>

  <view class="card state-card" wx:if="{{loading}}">正在核对本周积分与参榜设置…</view>
  <view class="card error-card" wx:elif="{{message}}">
    <view>{{message}}</view>
    <view class="retry" bindtap="loadManager">重新加载</view>
  </view>

  <block wx:else>
    <view class="card fairness-card">
      <view class="card-title">积分和 PK 分是什么关系？</view>
      <view class="fairness-row"><text>1</text><view>真实学生的 PK 分由本周可核验学习积分按 1:1 生成。</view></view>
      <view class="fairness-row"><text>2</text><view>系统按学习行为去重计分；单词和法语采用每日上限，作业积分在教师确认后生成。</view></view>
      <view class="fairness-row"><text>3</text><view>挑战选手使用教师设置的分数，并在学生端显示“挑战选手”标签；学生成就按真实学习记录计算。</view></view>
      <view class="week-pill" wx:if="{{week}}">本周 {{week.label}}</view>
    </view>

    <view class="section-head">
      <view><view class="section-title">真实学生参榜</view><view class="section-hint">建议选择当前在读、学习机会相近的学生互相比较。</view></view>
    </view>
    <view class="card student-card" wx:for="{{studentRows}}" wx:key="_id">
      <view class="student-top">
        <view class="student-main">
          <view class="student-name">{{item.name}} <text wx:if="{{item.nickname}}">{{item.nickname}}</text></view>
          <view class="student-meta">{{item.status}} · 累计课程 {{item.completedLessonCount}} 节 · 成就 {{item.unlockedAchievementCount}} / {{item.achievementCount}}</view>
        </view>
        <switch
          checked="{{item.effectivePkEnabled}}"
          disabled="{{!item.statusEligible || savingStudentId === item._id}}"
          color="#14645A"
          data-id="{{item._id}}"
          bindchange="toggleStudentPk"
        ></switch>
      </view>
      <view class="score-row">
        <view><text>{{item.weeklyPoints}}</text><view>本周真实积分 / PK 分</view></view>
        <view><text>{{item.totalPoints}}</text><view>累计学习积分</view></view>
      </view>
      <view class="student-foot">
        <view class="eligibility-note">{{!item.statusEligible ? '当前状态：未参与本周 PK' : item.effectivePkEnabled ? '正在参与本周 PK' : '已由教师移出 PK'}}</view>
        <view class="preview-action" data-id="{{item._id}}" bindtap="previewStudent">预览成就页 →</view>
      </view>
    </view>

    <view class="section-head challenge-head">
      <view><view class="section-title">挑战选手</view><view class="section-hint">公开标注的学习激励目标。</view></view>
      <view class="add-action" bindtap="startCreateProfile">＋ 新建</view>
    </view>

    <view class="card profile-form" wx:if="{{showProfileForm}}">
      <view class="form-title">{{editingProfileId ? '编辑挑战选手' : '新建挑战选手'}}</view>
      <view class="field">
        <view class="label">显示名称</view>
        <input class="input" maxlength="{{limits.nameLength}}" placeholder="例如：闪电挑战者" value="{{profileForm.name}}" data-field="name" bindinput="onProfileInput" />
      </view>
      <view class="number-grid">
        <view class="field">
          <view class="label">周一起始分</view>
          <input class="input" type="number" value="{{profileForm.weeklyBaseScore}}" data-field="weeklyBaseScore" bindinput="onProfileInput" />
        </view>
        <view class="field">
          <view class="label">每日增幅</view>
          <input class="input" type="number" value="{{profileForm.dailyIncrement}}" data-field="dailyIncrement" bindinput="onProfileInput" />
        </view>
      </view>
      <view class="formula-note">PK 分 = 周一起始分 + 本周已过天数 × 每日增幅；每周一重新从起始分计算。</view>
      <view class="enabled-row"><view><view class="label">显示在榜单</view><view class="field-hint">关闭后保留当前设置，再次开启即可显示。</view></view><switch checked="{{profileForm.enabled}}" color="#14645A" bindchange="onProfileEnabledChange"></switch></view>
      <view class="form-actions">
        <view class="ghost-action" bindtap="cancelProfileEdit">取消</view>
        <view class="primary-action" bindtap="saveProfile">{{savingProfile ? '保存中…' : '保存挑战选手'}}</view>
      </view>
    </view>

    <view class="card empty-card" wx:if="{{!challengeProfiles.length}}">还没有挑战选手。真实学生仍可按本周学习积分正常 PK。</view>
    <view class="card challenge-card {{item.enabled ? '' : 'challenge-disabled'}}" wx:for="{{challengeProfiles}}" wx:key="_id">
      <view class="challenge-top">
        <view><view class="challenge-name">{{item.name}} <text>挑战选手</text></view><view class="challenge-state">{{item.enabled ? '榜单中显示' : '目前已隐藏'}}</view></view>
        <view class="challenge-score"><text>{{item.currentScore}}</text><view>当前 PK 分</view></view>
      </view>
      <view class="challenge-formula">周一起始 {{item.weeklyBaseScore}} 分 · 每日 +{{item.dailyIncrement}} 分 · 已过 {{item.elapsedDays}} 天</view>
      <view class="challenge-actions">
        <view class="edit-action" data-id="{{item._id}}" bindtap="editProfile">编辑</view>
        <view class="delete-action" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="deleteProfile">{{deletingProfileId === item._id ? '删除中…' : '删除'}}</view>
      </view>
    </view>
  </block>
</view>
