.manager-page { padding-top: 22rpx; padding-bottom: 70rpx; }
.hero { padding: 34rpx 30rpx; border-radius: 26rpx; color: #fff; background: linear-gradient(135deg, #315c4b, #5d9276 62%, #c89955 145%); box-shadow: 0 16rpx 34rpx rgba(56, 105, 82, .2); }
.eyebrow { color: rgba(255,255,255,.72); font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-title { margin-top: 9rpx; font-size: 42rpx; font-weight: 800; }
.hero-copy { margin-top: 10rpx; color: rgba(255,255,255,.84); font-size: 23rpx; line-height: 1.55; }
.state-card,.error-card { margin-top: 24rpx; color: #71675c; text-align: center; }
.retry { display: inline-flex; margin-top: 16rpx; padding: 12rpx 20rpx; border-radius: 999rpx; color: #fff; background: #4f8f73; font-weight: 700; }
.fairness-card { margin-top: 24rpx; padding: 26rpx; border-color: #d9e7df; background: #f2f8f5; }
.card-title,.section-title,.form-title { color: #332f2a; font-size: 29rpx; font-weight: 800; }
.fairness-row { display: flex; gap: 14rpx; margin-top: 16rpx; color: #5e675f; font-size: 22rpx; line-height: 1.55; }
.fairness-row text { display: flex; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; align-items: center; justify-content: center; border-radius: 50%; color: #fff; background: #4f8f73; font-size: 18rpx; font-weight: 800; }
.week-pill { display: inline-flex; margin-top: 20rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: #7b5b2f; background: #f5e6c9; font-size: 21rpx; font-weight: 700; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin: 34rpx 2rpx 17rpx; }
.section-hint { margin-top: 6rpx; color: #887d71; font-size: 21rpx; line-height: 1.45; }
.student-card,.challenge-card,.profile-form { padding: 24rpx; }
.student-top,.student-foot,.challenge-top,.challenge-actions,.enabled-row,.form-actions { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.student-main { min-width: 0; flex: 1; }
.student-name,.challenge-name { color: #38322c; font-size: 27rpx; font-weight: 800; }
.student-name text { margin-left: 7rpx; color: #8a7e72; font-size: 21rpx; font-weight: 400; }
.student-meta,.eligibility-note,.challenge-state,.challenge-formula,.formula-note,.field-hint { margin-top: 7rpx; color: #83786d; font-size: 20rpx; line-height: 1.5; }
.score-row { display: grid; margin-top: 20rpx; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.score-row > view { padding: 16rpx; border-radius: 15rpx; background: #f7f2e9; }
.score-row text { color: #3d795f; font-size: 31rpx; font-weight: 800; }
.score-row view view { margin-top: 3rpx; color: #897d70; font-size: 19rpx; }
.student-foot { align-items: flex-end; margin-top: 16rpx; }
.eligibility-note { margin-top: 0; }
.preview-action,.edit-action { flex-shrink: 0; color: #39765d; font-size: 21rpx; font-weight: 700; }
.challenge-head { align-items: center; }
.add-action { flex-shrink: 0; padding: 11rpx 16rpx; border-radius: 999rpx; color: #fff; background: #4f8f73; font-size: 21rpx; font-weight: 700; }
.profile-form { border-color: #cddfd5; background: #fffefa; }
.field { margin-top: 20rpx; }
.label { color: #514940; font-size: 23rpx; font-weight: 700; }
.input { box-sizing: border-box; width: 100%; min-height: 76rpx; margin-top: 9rpx; padding: 0 18rpx; border: 1rpx solid #ddd1c1; border-radius: 14rpx; color: #322d28; background: #fff; font-size: 24rpx; }
.number-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }
.formula-note { padding: 14rpx 16rpx; border-radius: 13rpx; background: #f7f1e7; }
.enabled-row { margin-top: 20rpx; }
.form-actions { margin-top: 24rpx; }
.ghost-action,.primary-action { display: flex; min-height: 70rpx; flex: 1; align-items: center; justify-content: center; border-radius: 14rpx; font-size: 23rpx; font-weight: 700; }
.ghost-action { color: #6f665d; background: #eee8df; }
.primary-action { color: #fff; background: #4f8f73; }
.empty-card { color: #8a7e72; font-size: 22rpx; line-height: 1.55; text-align: center; }
.challenge-disabled { opacity: .68; }
.challenge-name text { margin-left: 8rpx; padding: 4rpx 9rpx; border-radius: 999rpx; color: #805b23; background: #f7e4bc; font-size: 17rpx; }
.challenge-score { flex-shrink: 0; text-align: right; }
.challenge-score text { color: #39765d; font-size: 34rpx; font-weight: 800; }
.challenge-score view { color: #8a7e72; font-size: 18rpx; }
.challenge-formula { margin-top: 16rpx; padding: 13rpx 15rpx; border-radius: 12rpx; background: #f7f2e9; }
.challenge-actions { justify-content: flex-end; margin-top: 18rpx; }
.edit-action,.delete-action { padding: 10rpx 16rpx; border-radius: 12rpx; background: #e8f3ed; }
.delete-action { color: #a1544a; background: #faece8; font-size: 21rpx; font-weight: 700; }
