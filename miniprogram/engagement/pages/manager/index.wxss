.manager-page { padding-top: 22rpx; padding-bottom: 70rpx; }
.hero { padding: 34rpx 30rpx; border-radius: 24rpx; color: var(--on-fill); background: var(--accent);  }
.eyebrow { color: rgba(255,255,255,.72); font-size: 24rpx; font-weight: 600;  }
.hero-title { margin-top: 9rpx; font-size: 44rpx; font-weight: 600; }
.hero-copy { margin-top: 10rpx; color: rgba(255,255,255,.84); font-size: 24rpx; line-height: 1.55; }
.state-card,.error-card { margin-top: 24rpx; color: var(--ink-2); text-align: center; }
.retry { display: inline-flex; margin-top: 16rpx; padding: 12rpx 20rpx; border-radius: 999rpx; color: var(--on-fill); background: var(--accent); font-weight: 600; }
.fairness-card { margin-top: 24rpx; padding: 26rpx; border-color: var(--accent-line); background: var(--accent-soft); }
.card-title,.section-title,.form-title { color: var(--ink); font-size: 30rpx; font-weight: 600; }
.fairness-row { display: flex; gap: 14rpx; margin-top: 16rpx; color: var(--ink-2); font-size: 24rpx; line-height: 1.55; }
.fairness-row text { display: flex; width: 36rpx; height: 36rpx; flex: 0 0 36rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--accent); font-size: 24rpx; font-weight: 600; }
.week-pill { display: inline-flex; margin-top: 20rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--warn); background: var(--line); font-size: 24rpx; font-weight: 600; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin: 34rpx 2rpx 17rpx; }
.section-hint { margin-top: 6rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.45; }
.student-card,.challenge-card,.profile-form { padding: 24rpx; }
.student-top,.student-foot,.challenge-top,.challenge-actions,.enabled-row,.form-actions { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.student-main { min-width: 0; flex: 1; }
.student-name,.challenge-name { color: var(--ink); font-size: 30rpx; font-weight: 600; }
.student-name text { margin-left: 7rpx; color: var(--ink-3); font-size: 24rpx; font-weight: 400; }
.student-meta,.eligibility-note,.challenge-state,.challenge-formula,.formula-note,.field-hint { margin-top: 7rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.5; }
.score-row { display: grid; margin-top: 20rpx; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.score-row > view { padding: 16rpx; border-radius: 16rpx; background: var(--surface-2); }
.score-row text { color: var(--accent); font-size: 34rpx; font-weight: 600; }
.score-row view view { margin-top: 3rpx; color: var(--ink-3); font-size: 24rpx; }
.student-foot { align-items: flex-end; margin-top: 16rpx; }
.eligibility-note { margin-top: 0; }
.preview-action,.edit-action { flex-shrink: 0; color: var(--accent); font-size: 24rpx; font-weight: 600; }
.challenge-head { align-items: center; }
.add-action { flex-shrink: 0; padding: 11rpx 16rpx; border-radius: 999rpx; color: var(--on-fill); background: var(--accent); font-size: 24rpx; font-weight: 600; }
.profile-form { border-color: var(--accent-line); background: var(--surface); }
.field { margin-top: 20rpx; }
.label { color: var(--ink); font-size: 24rpx; font-weight: 600; }
.input { box-sizing: border-box; width: 100%; min-height: 76rpx; margin-top: 9rpx; padding: 0 18rpx; border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--ink); background: var(--surface); font-size: 26rpx; }
.number-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }
.formula-note { padding: 14rpx 16rpx; border-radius: 12rpx; background: var(--surface-2); }
.enabled-row { margin-top: 20rpx; }
.form-actions { margin-top: 24rpx; }
.ghost-action,.primary-action { display: flex; min-height: 70rpx; flex: 1; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 24rpx; font-weight: 600; }
.ghost-action { color: var(--ink-2); background: var(--line); }
.primary-action { color: var(--on-fill); background: var(--accent); }
.empty-card { color: var(--ink-3); font-size: 24rpx; line-height: 1.55; text-align: center; }
.challenge-disabled { opacity: .68; }
.challenge-name text { margin-left: 8rpx; padding: 4rpx 9rpx; border-radius: 999rpx; color: var(--warn); background: var(--warn-soft); font-size: 24rpx; }
.challenge-score { flex-shrink: 0; text-align: right; }
.challenge-score text { color: var(--accent); font-size: 34rpx; font-weight: 600; }
.challenge-score view { color: var(--ink-3); font-size: 24rpx; }
.challenge-formula { margin-top: 16rpx; padding: 13rpx 15rpx; border-radius: 12rpx; background: var(--surface-2); }
.challenge-actions { justify-content: flex-end; margin-top: 18rpx; }
.edit-action,.delete-action { padding: 10rpx 16rpx; border-radius: 12rpx; background: var(--accent-soft); }
.delete-action { color: var(--danger); background: var(--danger-soft); font-size: 24rpx; font-weight: 600; }
