<view class="page schedule-page {{isTeacher ? 'has-teacher-tabbar' : ''}} {{isStudent ? 'has-student-tabbar' : ''}}">
  <view class="preview-banner" wx:if="{{isTeacherPreview}}">
    <view>
      <view class="preview-title">正在查看 {{student.name}} 的学生日程</view>
      <view class="preview-hint">界面与家长看到的一样，只显示这个孩子自己的课程，预览中的点击不会改动日程。</view>
    </view>
    <view class="preview-action" bindtap="goBackToTeacher">返回教师端</view>
  </view>

  <view class="schedule-hero">
    <view class="hero-kicker">WEEKLY SCHEDULE</view>
    <view class="hero-title">每周上课日程</view>
    <view class="hero-hint" wx:if="{{isTeacher}}">查看所有课程，并在这里统一开关学生的长期固定上课时间。</view>
    <view class="hero-hint" wx:elif="{{student}}">这里显示 {{student.name}} 每周什么时候上课；日程由朱老师统一维护。</view>
  </view>

  <view class="card loading-card" wx:if="{{loading}}">正在整理本周日程…</view>
  <view class="card error-card" wx:elif="{{message}}">{{message}}</view>

  <block wx:else>
    <scroll-view class="day-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="day-strip-inner">
        <view
          class="day-pill {{selectedWeekday === item.weekday ? 'day-pill-active' : ''}}"
          wx:for="{{days}}"
          wx:key="dateKey"
          data-weekday="{{item.weekday}}"
          bindtap="selectDay"
        >
          <view class="day-week">{{item.label}}</view>
          <view class="day-date">{{item.dateLabel}}<text wx:if="{{item.isYesterday}}"> · 昨天</text><text wx:elif="{{item.isToday}}"> · 今天</text></view>
          <view class="day-count">{{item.eventCount ? item.eventCount + ' 项' : '无课程'}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="schedule-summary">
      <view>
        <view class="summary-title">{{selectedDayLabel}}</view>
        <view class="summary-hint" wx:if="{{isTeacher}}">本页显示每周固定课程和临时安排；固定课表可在下方单独打开或关闭。</view>
        <view class="summary-hint" wx:else>只显示当前孩子自己的课程，不再展示其他学生或老师的空闲时间。</view>
      </view>
      <view class="summary-actions">
        <view class="schedule-add" wx:if="{{isTeacher && canWrite}}" bindtap="openForm">＋ 添加临时安排</view>
      </view>
    </view>

    <view class="legend-row">
      <view class="legend-item" wx:if="{{isTeacher}}"><view class="legend-dot legend-monash"></view>MONASH</view>
      <view class="legend-item" wx:if="{{isTeacher}}"><view class="legend-dot legend-teacher"></view>老师安排</view>
      <view class="legend-item"><view class="legend-dot legend-student"></view>学生课程</view>
    </view>

    <view class="fixed-schedule-card" wx:if="{{isTeacher}}">
      <view class="fixed-schedule-head">
        <view>
          <view class="fixed-schedule-title">长期固定上课时间</view>
          <view class="fixed-schedule-hint">关闭后只会从课表隐藏，不会删除这条固定设置；以后可再次打开。</view>
        </view>
        <view class="fixed-schedule-count">{{fixedStudentSchedules.length}} 条</view>
      </view>
      <view class="fixed-schedule-empty" wx:if="{{!fixedStudentSchedules.length}}">暂未找到需要管理的固定课程。</view>
      <view class="fixed-schedule-row" wx:for="{{fixedStudentSchedules}}" wx:key="_id">
        <view class="fixed-schedule-color event-{{item.colorKey}}"></view>
        <view class="fixed-schedule-copy">
          <view class="fixed-schedule-name">{{item.title}}</view>
          <view class="fixed-schedule-time">{{item.weekdayLabel}} · {{item.timeLabel}} · {{item.enabled ? '已打开' : '已关闭'}}</view>
        </view>
        <switch checked="{{item.enabled}}" color="#4f8f73" disabled="{{fixedScheduleSavingId}}" data-id="{{item._id}}" bindchange="onFixedScheduleEnabledChange" />
      </view>
    </view>

    <view class="timeline-card">
      <view class="timeline-empty" wx:if="{{!selectedDayEvents.length}}">这一天没有安排课程。</view>
      <view class="timeline" style="height: {{timelineHeight}}rpx;">
        <view class="hour-line" wx:for="{{timelineHours}}" wx:key="label" style="top: {{item.topRpx}}rpx;">
          <view class="hour-label">{{item.label}}</view>
          <view class="hour-rule"></view>
        </view>
        <view
          class="schedule-event event-{{item.colorKey}} {{item.actionable ? 'schedule-event-actionable' : ''}}"
          wx:for="{{selectedDayEvents}}"
          wx:key="_id"
          style="top: {{item.topRpx}}rpx; height: {{item.heightRpx}}rpx;"
          data-id="{{item._id}}"
          bindtap="handleEventTap"
        >
          <view class="event-time">{{item.timeLabel}}</view>
          <view class="event-title">{{item.title}}</view>
          <view class="event-note" wx:if="{{item.note}}">{{item.note}}</view>
          <view class="event-action" wx:if="{{item.actionable}}">点按可编辑</view>
        </view>
      </view>
    </view>
  </block>

  <view class="modal-mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="schedule-modal" catchtap="stopPropagation">
      <view class="modal-title">{{editingId ? '编辑每周日程' : formMode === 'teacher' ? '添加老师安排' : '添加学生临时课程'}}</view>
      <view class="modal-hint" wx:if="{{formMode === 'booking' && bookingStudent}}">{{bookingStudent.name}} 每节 {{bookingStudent.bookingDurationMinutes}} 分钟；结束时间由系统自动计算。</view>
      <view class="modal-hint" wx:else>这段时间会直接显示在家长看到的日程表中。</view>

      <view class="field" wx:if="{{isTeacher && !editingId}}">
        <view class="field-label">安排类型</view>
        <picker mode="selector" range="{{arrangementTypes}}" range-key="label" value="{{formModeIndex}}" bindchange="onFormModeChange">
          <view class="picker-value">{{arrangementTypes[formModeIndex].label}}</view>
        </picker>
      </view>
      <view class="field" wx:if="{{isTeacher && formMode === 'booking'}}">
        <view class="field-label">预约学生</view>
        <picker mode="selector" range="{{students}}" range-key="name" value="{{formStudentIndex}}" bindchange="onFormStudentChange" disabled="{{editingId}}">
          <view class="picker-value">{{bookingStudent ? bookingStudent.name : '请选择学生'}}</view>
        </picker>
      </view>

      <view class="field">
        <view class="field-label">星期</view>
        <picker mode="selector" range="{{weekdayOptions}}" range-key="label" value="{{form.weekdayIndex}}" bindchange="onFormDayChange">
          <view class="picker-value">{{weekdayOptions[form.weekdayIndex].label}}</view>
        </picker>
      </view>
      <view class="time-grid">
        <view class="field time-field">
          <view class="field-label">开始时间</view>
          <picker mode="time" start="09:00" end="22:55" value="{{form.startTime}}" bindchange="onStartTimeChange">
            <view class="picker-value">{{form.startTime}}</view>
          </picker>
        </view>
        <view class="field time-field" wx:if="{{formMode === 'teacher'}}">
          <view class="field-label">结束时间</view>
          <picker mode="time" start="09:05" end="23:00" value="{{form.endTime}}" bindchange="onEndTimeChange">
            <view class="picker-value">{{form.endTime}}</view>
          </picker>
        </view>
        <view class="field time-field" wx:else>
          <view class="field-label">自动结束</view>
          <view class="picker-value picker-readonly">{{bookingEndTime}}</view>
        </view>
      </view>
      <view class="field" wx:if="{{formMode === 'teacher'}}">
        <view class="field-label">事项名称</view>
        <input class="text-input" maxlength="50" placeholder="例如：备课、外出、回家" value="{{form.title}}" data-field="title" bindinput="onFormInput" />
      </view>
      <view class="field">
        <view class="field-label">备注（可选）</view>
        <input class="text-input" maxlength="100" placeholder="补充说明" value="{{form.note}}" data-field="note" bindinput="onFormInput" />
      </view>
      <view class="weekly-note">这里用于额外的每周安排；Molly、冯嘉文的长期固定课程请使用页面上的固定课表开关。</view>
      <view class="modal-actions">
        <view class="modal-cancel" bindtap="closeForm">返回</view>
        <view class="modal-confirm {{saving ? 'modal-confirm-disabled' : ''}}" bindtap="submitForm">{{saving ? '保存中…' : editingId ? '保存修改' : '加入日程'}}</view>
      </view>
    </view>
  </view>

  <teacher-tabbar wx:if="{{isTeacher}}" current="schedule"></teacher-tabbar>
  <student-tabbar wx:if="{{isStudent}}" current="schedule" mode="{{mode}}" preview-student-id="{{previewStudentId}}"></student-tabbar>
</view>
