.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx 150rpx;
  background: #f7f3ea;
  color: #243b31;
}

.schedule-hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-kicker {
  color: #4f8f73;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 8rpx;
  color: #173b2e;
  font-size: 46rpx;
  font-weight: 800;
}

.hero-hint {
  margin-top: 10rpx;
  color: #766d63;
  font-size: 25rpx;
  line-height: 1.6;
}

.card,
.timeline-card {
  border: 1rpx solid #e6dacb;
  border-radius: 22rpx;
  background: #fffdfa;
  box-shadow: 0 8rpx 24rpx rgba(70, 52, 32, 0.05);
}

.loading-card,
.error-card {
  padding: 34rpx;
  color: #766d63;
  text-align: center;
}

.error-card { color: #a44c45; }

.preview-banner {
  display: flex;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #b9d8ca;
  border-radius: 18rpx;
  background: #edf7f2;
}

.preview-title { font-size: 26rpx; font-weight: 800; }
.preview-hint { margin-top: 5rpx; color: #6b7f75; font-size: 21rpx; }
.preview-action { margin-left: 18rpx; color: #2f7257; font-size: 22rpx; font-weight: 700; white-space: nowrap; }

.day-strip {
  margin: 0 -28rpx;
  padding: 2rpx 28rpx 16rpx;
  white-space: nowrap;
}

.day-strip-inner { display: inline-flex; gap: 12rpx; }

.day-pill {
  box-sizing: border-box;
  width: 144rpx;
  padding: 15rpx 8rpx;
  border: 1rpx solid #e5dacd;
  border-radius: 18rpx;
  background: #fffdfa;
  text-align: center;
}

.day-pill-active {
  border-color: #4f8f73;
  background: #e8f3ed;
  box-shadow: 0 6rpx 18rpx rgba(79, 143, 115, 0.14);
}

.day-week { font-size: 25rpx; font-weight: 800; }
.day-date { margin-top: 3rpx; color: #665f57; font-size: 18rpx; white-space: nowrap; }
.day-count { margin-top: 4rpx; color: #887d70; font-size: 20rpx; }
.day-pill-active .day-count { color: #39765d; }
.day-pill-active .day-date { color: #39765d; }
.day-count-closed,
.day-pill-active .day-count-closed { color: #a4574e; font-weight: 800; }

.schedule-summary {
  display: flex;
  margin: 18rpx 2rpx;
  align-items: center;
  justify-content: space-between;
}

.summary-title { color: #203d32; font-size: 32rpx; font-weight: 800; }
.summary-hint { max-width: 440rpx; margin-top: 4rpx; color: #8a8076; font-size: 20rpx; line-height: 1.45; }
.summary-hint-closed { color: #a4574e; }

.summary-actions {
  display: flex;
  margin-left: 16rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.availability-toggle {
  padding: 11rpx 16rpx;
  border: 1rpx solid #82aa97;
  border-radius: 999rpx;
  background: #edf6f1;
  color: #39765d;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
}

.availability-toggle-closed {
  border-color: #d4a49d;
  background: #fff0ed;
  color: #a4574e;
}

.schedule-add {
  padding: 15rpx 20rpx;
  border-radius: 999rpx;
  background: #4f8f73;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.schedule-closed {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #eee8e2;
  color: #9b5d55;
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.legend-row {
  display: flex;
  margin-bottom: 14rpx;
  color: #7f756b;
  font-size: 20rpx;
  gap: 20rpx;
}

.legend-item { display: flex; align-items: center; gap: 7rpx; }
.legend-dot { width: 13rpx; height: 13rpx; border-radius: 50%; }
.legend-monash { background: #668bb0; }
.legend-teacher { background: #c48b50; }
.legend-student { background: #639b80; }

.fixed-schedule-card {
  margin: 18rpx 0 22rpx;
  padding: 24rpx;
  border: 1rpx solid #d7e5dd;
  border-radius: 20rpx;
  background: #fffdfa;
}

.fixed-schedule-head,
.fixed-schedule-row {
  display: flex;
  align-items: center;
}

.fixed-schedule-head {
  justify-content: space-between;
  gap: 18rpx;
}

.fixed-schedule-title {
  color: #24483a;
  font-size: 28rpx;
  font-weight: 800;
}

.fixed-schedule-hint {
  margin-top: 6rpx;
  color: #7b807b;
  font-size: 20rpx;
  line-height: 1.5;
}

.fixed-schedule-count {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #39765d;
  background: #e9f4ee;
  font-size: 20rpx;
  font-weight: 800;
}

.fixed-schedule-empty {
  margin-top: 18rpx;
  color: #8d8276;
  font-size: 22rpx;
  text-align: center;
}

.fixed-schedule-row {
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx 4rpx 0;
  border-top: 1rpx solid #ece5dc;
}

.fixed-schedule-row:active { opacity: 0.7; }

.fixed-schedule-color {
  width: 12rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
}

.fixed-schedule-copy {
  min-width: 0;
  flex: 1;
}

.fixed-schedule-name {
  color: #2c463a;
  font-size: 24rpx;
  font-weight: 800;
}

.fixed-schedule-time {
  margin-top: 5rpx;
  color: #7c746c;
  font-size: 20rpx;
}

.fixed-schedule-action {
  flex-shrink: 0;
  color: #39765d;
  font-size: 22rpx;
  font-weight: 800;
}

.timeline-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 18rpx 30rpx;
}

.timeline-empty {
  margin: 0 0 22rpx 96rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: #f4f0e9;
  color: #8d8276;
  font-size: 22rpx;
}
.timeline-empty-closed { background: #fff0ed; color: #9b5d55; }

.timeline { position: relative; }

.hour-line {
  position: absolute;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
}

.hour-label {
  width: 82rpx;
  color: #9a8e81;
  font-size: 19rpx;
  transform: translateY(-50%);
}

.hour-rule {
  height: 1rpx;
  flex: 1;
  background: #eee6dc;
}

.schedule-event {
  position: absolute;
  right: 4rpx;
  left: 92rpx;
  z-index: 2;
  box-sizing: border-box;
  overflow: hidden;
  padding: 9rpx 15rpx;
  border-left: 7rpx solid rgba(40, 70, 58, 0.35);
  border-radius: 12rpx;
  color: #243b31;
}

.schedule-event-actionable { box-shadow: 0 6rpx 16rpx rgba(59, 70, 60, 0.13); }
.event-time { font-size: 20rpx; font-weight: 800; }
.event-title { overflow: hidden; margin-top: 2rpx; font-size: 23rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.event-note { overflow: hidden; color: rgba(36, 59, 49, 0.72); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.event-action { position: absolute; right: 12rpx; bottom: 7rpx; font-size: 16rpx; opacity: 0.75; }

.event-monash { background: #dceaf5; border-color: #668bb0; }
.event-teacher { background: #f5e7d4; border-color: #c48b50; }
.event-sage { background: #dcece3; border-color: #5c9277; }
.event-rose { background: #f4dfe1; border-color: #ba7278; }
.event-sky { background: #dcebf1; border-color: #6f9fb1; }
.event-violet { background: #e8e1f2; border-color: #8d78ad; }
.event-amber { background: #f5e9c8; border-color: #b99643; }
.event-mint { background: #d9eee9; border-color: #57988a; }
.event-coral { background: #f6e0d5; border-color: #bd7b62; }
.event-indigo { background: #dfe4f3; border-color: #707fae; }
.event-occupied { background: #ece8e2; border-color: #9a9288; }

.modal-mask {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(31, 37, 33, 0.48);
}

.schedule-modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fffdfa;
}

.modal-title { color: #203d32; font-size: 34rpx; font-weight: 800; }
.modal-hint { margin: 8rpx 0 24rpx; color: #7e746a; font-size: 22rpx; line-height: 1.5; }
.booking-closed-note { margin: -8rpx 0 20rpx; padding: 15rpx 18rpx; border-radius: 12rpx; background: #fff0ed; color: #9b5149; font-size: 21rpx; line-height: 1.55; }
.field { margin-top: 20rpx; }
.field-label { margin-bottom: 9rpx; color: #4d5d55; font-size: 22rpx; font-weight: 700; }
.picker-value,
.text-input {
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #ded3c6;
  border-radius: 14rpx;
  background: #faf7f1;
  color: #263f34;
  font-size: 26rpx;
}

.picker-readonly { color: #39765d; font-weight: 800; }
.time-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.time-field { min-width: 0; }
.weekly-note { margin-top: 22rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: #f2eee7; color: #81766c; font-size: 20rpx; line-height: 1.5; }
.modal-actions { display: grid; margin-top: 26rpx; grid-template-columns: 1fr 1.7fr; gap: 16rpx; }
.modal-cancel,
.modal-confirm { padding: 22rpx; border-radius: 14rpx; text-align: center; font-size: 25rpx; font-weight: 800; }
.modal-cancel { background: #eee8df; color: #6f655c; }
.modal-confirm { background: #4f8f73; color: #fff; }
.modal-confirm-disabled { opacity: 0.55; }

.fixed-editor-modal { max-height: 92vh; }
.fixed-day-list { display: flex; flex-direction: column; gap: 12rpx; }
.fixed-day-row {
  padding: 18rpx 20rpx;
  border: 1rpx solid #dce7e0;
  border-radius: 16rpx;
  background: #f7fbf8;
}
.fixed-day-disabled { border-color: #e9e3db; background: #f7f3ed; }
.fixed-day-head { display: flex; align-items: center; justify-content: space-between; }
.fixed-day-head switch { transform: scale(0.82); transform-origin: right center; }
.fixed-day-name { color: #28483b; font-size: 25rpx; font-weight: 800; }
.fixed-day-disabled .fixed-day-name { color: #8f877e; }
.fixed-day-times { display: flex; margin-top: 12rpx; align-items: center; gap: 12rpx; }
.fixed-day-times picker { min-width: 0; flex: 1; }
.fixed-time-value {
  display: flex;
  box-sizing: border-box;
  min-height: 64rpx;
  padding: 14rpx 16rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #d7cec2;
  border-radius: 12rpx;
  background: #fffdfa;
  color: #254437;
  font-size: 23rpx;
  font-weight: 800;
}
.fixed-time-value text { margin-right: 10rpx; color: #8a8075; font-size: 18rpx; font-weight: 500; }
.fixed-day-disabled .fixed-time-value { color: #9b938a; background: #eee9e2; }
.fixed-time-arrow { flex-shrink: 0; color: #91877d; font-size: 22rpx; }
