.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx 150rpx;
  background: var(--surface-2);
  color: var(--accent);
}

.schedule-hero {
  padding: 8rpx 4rpx 28rpx;
}

.hero-kicker {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 8rpx;
  color: var(--accent);
  font-size: 56rpx;
  font-weight: 600;
}

.hero-hint {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.card,
.timeline-card {
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.loading-card,
.error-card {
  padding: 34rpx;
  color: var(--ink-2);
  text-align: center;
}

.error-card { color: var(--danger); }

.preview-banner {
  display: flex;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--accent-line);
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.preview-title { font-size: 30rpx; font-weight: 600; }
.preview-hint { margin-top: 5rpx; color: var(--ink-2); font-size: 24rpx; }
.preview-action { margin-left: 18rpx; color: var(--accent); font-size: 24rpx; font-weight: 600; white-space: nowrap; }

.day-strip {
  margin: 0 -28rpx;
  padding: 2rpx 28rpx 16rpx;
  white-space: nowrap;
}

.day-strip-inner { display: inline-flex; gap: 12rpx; }

.day-pill {
  box-sizing: border-box;
  width: 144rpx;
  padding: 15rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  text-align: center;
}

.day-pill-active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.day-week { font-size: 26rpx; font-weight: 600; }
.day-date { margin-top: 3rpx; color: var(--ink-2); font-size: 24rpx; white-space: nowrap; }
.day-count { margin-top: 4rpx; color: var(--ink-3); font-size: 24rpx; }
.day-pill-active .day-count { color: var(--accent); }
.day-pill-active .day-date { color: var(--accent); }
.day-count-closed,
.day-pill-active .day-count-closed { color: var(--danger); font-weight: 600; }

.schedule-summary {
  display: flex;
  margin: 18rpx 2rpx;
  align-items: center;
  justify-content: space-between;
}

.summary-title { color: var(--accent); font-size: 34rpx; font-weight: 600; }
.summary-hint { max-width: 440rpx; margin-top: 4rpx; color: var(--ink-3); font-size: 24rpx; line-height: 1.45; }
.summary-hint-closed { color: var(--danger); }

.summary-actions {
  display: flex;
  margin-left: 16rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.availability-toggle {
  padding: 11rpx 16rpx;
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.availability-toggle-closed {
  border-color: var(--danger-line);
  background: var(--danger-soft);
  color: var(--danger);
}

.schedule-add {
  padding: 15rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--on-fill);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.schedule-closed {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: var(--line);
  color: var(--danger);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.legend-row {
  display: flex;
  margin-bottom: 14rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  gap: 20rpx;
}

.legend-item { display: flex; align-items: center; gap: 7rpx; }
.legend-dot { width: 13rpx; height: 13rpx; border-radius: 50%; }
.legend-monash { background: var(--info); }
.legend-teacher { background: var(--warn-fill); }
.legend-student { background: var(--accent); }

.fixed-schedule-card {
  margin: 18rpx 0 22rpx;
  padding: 24rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 24rpx;
  background: var(--surface);
}

.fixed-schedule-head,
.fixed-schedule-row {
  display: flex;
  align-items: center;
}

.fixed-schedule-head {
  justify-content: space-between;
  gap: 18rpx;
}

.fixed-schedule-title {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.fixed-schedule-hint {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.fixed-schedule-count {
  flex-shrink: 0;
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.fixed-schedule-empty {
  margin-top: 18rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}

.fixed-schedule-row {
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 18rpx 4rpx 0;
  border-top: 1rpx solid var(--line);
}

.fixed-schedule-row:active { opacity: 0.7; }

.fixed-schedule-color {
  width: 12rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
}

.fixed-schedule-copy {
  min-width: 0;
  flex: 1;
}

.fixed-schedule-name {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.fixed-schedule-time {
  margin-top: 5rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.fixed-schedule-action {
  flex-shrink: 0;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 18rpx 30rpx;
}

.timeline-empty {
  margin: 0 0 22rpx 96rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 24rpx;
}
.timeline-empty-closed { background: var(--danger-soft); color: var(--danger); }

.timeline { position: relative; }

.hour-line {
  position: absolute;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
}

.hour-label {
  width: 82rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  transform: translateY(-50%);
}

.hour-rule {
  height: 1rpx;
  flex: 1;
  background: var(--line);
}

.schedule-event {
  position: absolute;
  right: 4rpx;
  left: 92rpx;
  z-index: 2;
  box-sizing: border-box;
  overflow: hidden;
  padding: 9rpx 15rpx;
  border-left: 7rpx solid var(--accent-line);
  border-radius: 12rpx;
  color: var(--accent);
}

.schedule-event-actionable {  }
.event-time { font-size: 24rpx; font-weight: 600; }
.event-title { overflow: hidden; margin-top: 2rpx; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.event-own-badge { display: inline-flex; margin-left: 8rpx; padding: 2rpx 8rpx; border-radius: 999rpx; color: var(--on-fill); background: var(--accent); font-size: 24rpx; vertical-align: 3rpx; }
.event-note { overflow: hidden; color: var(--accent); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.event-action { position: absolute; right: 12rpx; bottom: 7rpx; font-size: 24rpx; opacity: 0.75; }

.event-monash { background: var(--info-soft); border-color: var(--info); }
.event-teacher { background: var(--line); border-color: var(--warn-fill); }
.event-sage { background: var(--accent-soft); border-color: var(--accent); }
.event-rose { background: var(--danger-soft); border-color: var(--danger); }
.event-sky { background: var(--info-soft); border-color: var(--info); }
.event-violet { background: var(--info-soft); border-color: var(--info); }
.event-amber { background: var(--line); border-color: var(--warn-fill); }
.event-mint { background: var(--accent-soft); border-color: var(--accent); }
.event-coral { background: var(--danger-soft); border-color: var(--danger); }
.event-indigo { background: var(--info-soft); border-color: var(--info); }
.event-occupied { background: var(--line); border-color: var(--line-strong); }

.modal-mask {
  position: fixed;
  z-index: 200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: var(--ink-3);
}

.schedule-modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 34rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
}

.modal-title { color: var(--accent); font-size: 34rpx; font-weight: 600; }
.modal-hint { margin: 8rpx 0 24rpx; color: var(--ink-2); font-size: 24rpx; line-height: 1.5; }
.booking-closed-note { margin: -8rpx 0 20rpx; padding: 15rpx 18rpx; border-radius: 12rpx; background: var(--danger-soft); color: var(--danger); font-size: 24rpx; line-height: 1.55; }
.field { margin-top: 20rpx; }
.field-label { margin-bottom: 9rpx; color: var(--ink-2); font-size: 24rpx; font-weight: 600; }
.picker-value,
.text-input {
  box-sizing: border-box;
  min-height: 82rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--accent);
  font-size: 30rpx;
}

.picker-readonly { color: var(--accent); font-weight: 600; }
.time-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.time-field { min-width: 0; }
.weekly-note { margin-top: 22rpx; padding: 16rpx 18rpx; border-radius: 12rpx; background: var(--line); color: var(--ink-2); font-size: 24rpx; line-height: 1.5; }
.modal-actions { display: grid; margin-top: 26rpx; grid-template-columns: 1fr 1.7fr; gap: 16rpx; }
.modal-cancel,
.modal-confirm { padding: 22rpx; border-radius: 16rpx; text-align: center; font-size: 26rpx; font-weight: 600; }
.modal-cancel { background: var(--line); color: var(--ink-2); }
.modal-confirm { background: var(--accent); color: var(--on-fill); }
.modal-confirm-disabled { opacity: 0.55; }

.fixed-editor-modal { max-height: 92vh; }
.fixed-day-list { display: flex; flex-direction: column; gap: 12rpx; }
.fixed-day-row {
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 16rpx;
  background: var(--accent-soft);
}
.fixed-day-disabled { border-color: var(--line); background: var(--surface-2); }
.fixed-day-head { display: flex; align-items: center; justify-content: space-between; }
.fixed-day-head switch { transform: scale(0.82); transform-origin: right center; }
.fixed-day-name { color: var(--accent); font-size: 26rpx; font-weight: 600; }
.fixed-day-disabled .fixed-day-name { color: var(--ink-3); }
.fixed-day-times { display: flex; margin-top: 12rpx; align-items: center; gap: 12rpx; }
.fixed-day-times picker { min-width: 0; flex: 1; }
.fixed-time-value {
  display: flex;
  box-sizing: border-box;
  min-height: 64rpx;
  padding: 14rpx 16rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--surface);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}
.fixed-time-value text { margin-right: 10rpx; color: var(--ink-3); font-size: 24rpx; font-weight: 500; }
.fixed-day-disabled .fixed-time-value { color: var(--ink-3); background: var(--line); }
.fixed-time-arrow { flex-shrink: 0; color: var(--ink-3); font-size: 24rpx; }
