<view class="chart-shell">
  <canvas
    id="chartCanvas"
    class="chart-canvas {{type === 'bar' ? 'bar-canvas' : (type === 'line' ? 'line-canvas' : 'donut-canvas')}}"
    type="2d"
    aria-role="img"
    aria-label="{{resolvedAriaLabel}}"
  ></canvas>
  <view
    wx:if="{{(type === 'bar' && isBarEmpty) || (type === 'line' && isLineEmpty)}}"
    class="bar-empty-state"
    aria-hidden="true"
  >
    <text class="bar-empty-title">暂无学习记录</text>
    <text class="bar-empty-hint">开始学习后，这里会显示近期趋势</text>
  </view>
  <view class="chart-legend" wx:if="{{type !== 'bar' && type !== 'line'}}">
    <view class="legend-item" wx:for="{{segments}}" wx:key="label">
      <view class="legend-dot" style="background: {{item.color}};"></view>
      <text class="legend-label">{{item.label}}</text>
      <text class="legend-value">{{item.value}}</text>
    </view>
  </view>
</view>
