.chart-shell {
  position: relative;
  width: 100%;
}

.chart-canvas {
  display: block;
  width: 100%;
}

.donut-canvas {
  height: 300rpx;
}

.bar-canvas {
  height: 270rpx;
}

.bar-empty-state {
  position: absolute;
  top: 66rpx;
  right: 44rpx;
  left: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 253, 249, 0.9);
  color: #817669;
  pointer-events: none;
}

.bar-empty-title {
  color: #4f6f63;
  font-size: 24rpx;
  font-weight: 700;
}

.bar-empty-hint {
  margin-top: 6rpx;
  font-size: 21rpx;
}

.chart-legend {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 18rpx;
  margin-top: 10rpx;
}

.legend-item {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
  color: #655b50;
  font-size: 23rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.legend-label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-value {
  color: #2f2a24;
  font-weight: 700;
}
