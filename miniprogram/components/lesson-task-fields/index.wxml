<view class="group-title">课后整理</view>
<block wx:if="{{form.lessonTemplateKey === 'feng_beginner'}}">
  <view class="field">
    <view class="label">今日复习</view>
    <textarea class="textarea" placeholder="先写旧内容，例如：A–I 和数字 1–3" value="{{form.reviewContent}}" data-field="reviewContent" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">今日新内容（少量）</view>
    <textarea class="textarea" placeholder="一次只加入少量新内容" value="{{form.taughtContent}}" data-field="taughtContent" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">掌握情况</view>
    <textarea class="textarea" placeholder="能否独立完成、需要什么提示" value="{{form.masterySummary}}" data-field="masterySummary" bindinput="onInput"></textarea>
  </view>
</block>

<block wx:elif="{{form.lessonTemplateKey === 'molly_oral_ket'}}">
  <view class="field">
    <view class="label">今日口语主题</view>
    <textarea class="textarea" placeholder="本节围绕什么情境开口" value="{{form.oralTopic}}" data-field="oralTopic" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">目标表达</view>
    <textarea class="textarea" placeholder="本节真正练习的词块或句型" value="{{form.targetExpression}}" data-field="targetExpression" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">独立输出</view>
    <textarea class="textarea" placeholder="学生不看答案能够说出的内容" value="{{form.independentOutput}}" data-field="independentOutput" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">需要纠正</view>
    <textarea class="textarea" placeholder="下次继续纠正的 1–3 项" value="{{form.correctionNotes}}" data-field="correctionNotes" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">本节 KET 技能</view>
    <input class="input" placeholder="例如：Speaking Part 1；没有可留空" value="{{form.ketSkill}}" data-field="ketSkill" bindinput="onInput" />
  </view>
</block>

<block wx:else>
  <view class="field">
    <view class="label">今天学了什么</view>
    <textarea class="textarea" placeholder="写下本节实际完成的内容" value="{{form.taughtContent}}" data-field="taughtContent" bindinput="onInput"></textarea>
  </view>
  <view class="field">
    <view class="label">掌握情况</view>
    <textarea class="textarea" placeholder="学生最关键的表现" value="{{form.masterySummary}}" data-field="masterySummary" bindinput="onInput"></textarea>
  </view>
</block>

<view class="field">
  <view class="label">下节需要复习</view>
  <textarea class="textarea" placeholder="下次开课先做什么" value="{{form.nextReview}}" data-field="nextReview" bindinput="onInput"></textarea>
</view>

<view class="group-title">课后任务</view>
<view class="field">
  <view class="label">任务内容</view>
  <textarea class="textarea" placeholder="例如：跟读目标句 3 遍" value="{{form.homeworkTask}}" data-field="homeworkTask" bindinput="onInput"></textarea>
</view>

<view class="switch-row">
  <view class="switch-copy">
    <view class="label switch-label">需要学生提交录音</view>
    <view class="hint">学生在课程页录制，老师直接播放检查</view>
  </view>
  <switch checked="{{form.recordingTaskEnabled}}" color="#14645A" bindchange="onRecordingTaskChange" />
</view>

<block wx:if="{{form.recordingTaskEnabled}}">
  <view class="field">
    <view class="label">录音作业期限</view>
    <picker mode="selector" range="{{homeworkDueOptions}}" range-key="label" value="{{homeworkDueIndex}}" bindchange="onHomeworkDueChange">
      <view class="picker-value">{{homeworkDueOptions[homeworkDueIndex].label}}</view>
    </picker>
    <view class="hint">以课程日期为当天，最多 7 天</view>
  </view>

  <view class="field">
    <view class="label">录音任务类型</view>
    <picker mode="selector" range="{{recordingTaskTypeOptions}}" range-key="label" value="{{recordingTaskTypeIndex}}" bindchange="onRecordingTaskTypeChange">
      <view class="picker-value">{{recordingTaskTypeOptions[recordingTaskTypeIndex].label}}</view>
    </picker>
    <view class="hint" wx:if="{{form.lessonTemplateKey === 'molly_oral_ket'}}">独立朗读由学生直接开始；跟读会先播放你的逐条录音。Molly 还可选择 KET 单题或全流程模拟。</view>
    <view class="hint" wx:else>独立朗读由学生直接录音；跟读先播放老师的逐条示范，再自动打开麦克风。</view>
  </view>

  <view class="field" wx:if="{{form.recordingTaskType === 'ket_official'}}">
    <view class="label">选择官方口语样题</view>
    <picker mode="selector" range="{{ketSpeakingTasks}}" range-key="label" value="{{ketSpeakingTaskIndex}}" bindchange="onKetSpeakingTaskChange">
      <view class="picker-value">{{selectedKetSpeakingTask.label}}</view>
    </picker>
    <view class="source-card">
      <view class="source-title">{{selectedKetSpeakingTask.sourceYear}} · {{selectedKetSpeakingTask.part}} · {{selectedKetSpeakingTask.difficulty}}</view>
      <view class="source-line">{{selectedKetSpeakingTask.sourceLabel}}</view>
      <view class="source-line">官方定位：{{selectedKetSpeakingTask.sourceReference}}</view>
      <view class="source-line">{{selectedKetSpeakingTask.timingLabel}}</view>
      <view class="source-copy" bindtap="copyKetSource">复制 Cambridge 官方来源</view>
      <view class="source-warning" wx:if="{{selectedKetSpeakingTask.preparationSeconds}}">本页 {{selectedKetSpeakingTask.preparationSeconds}} 秒用于练习读题；正式任务以实际题目流程为准。</view>
      <view class="source-warning" wx:else>正式练习采用直接听题回答流程。</view>
    </view>
    <view class="source-warning" wx:if="{{ketWeeklyHint}}">{{ketWeeklyHint}}</view>
  </view>

  <view class="field" wx:if="{{form.recordingTaskType === 'ket_mock'}}">
    <view class="label">选择完整模拟套题</view>
    <picker mode="selector" range="{{ketMockSets}}" range-key="title" value="{{ketMockSetIndex}}" bindchange="onKetMockSetChange">
      <view class="picker-value">{{selectedKetMockSet.title}}</view>
    </picker>
    <view class="source-card source-card-mock">
      <view class="source-title">{{selectedKetMockSet.sourceBadge}}</view>
      <view class="source-line">{{selectedKetMockSet.formatLabel}} · {{selectedKetMockSet.expectedMinutes}}</view>
      <view class="source-line">主题：{{selectedKetMockSet.topic}}</view>
      <view class="source-line">{{selectedKetMockSet.sourceLabel}}</view>
      <view class="source-warning">学生开始前，需先在“教师管理 → KET 模拟录音库”准备本套 {{selectedKetMockSet.cues.length}} 段考官与虚拟搭档音频。</view>
    </view>
    <view class="source-warning" wx:if="{{ketWeeklyHint}}">{{ketWeeklyHint}}</view>
  </view>

  <view class="field">
    <view class="label">{{form.recordingTaskType === 'follow_reading' ? '补充要求（可不填）' : '录音要求'}}</view>
    <textarea class="textarea {{form.recordingTaskType === 'ket_official' || form.recordingTaskType === 'ket_mock' ? 'textarea-locked' : ''}}" maxlength="2000" disabled="{{form.recordingTaskType === 'ket_official' || form.recordingTaskType === 'ket_mock'}}" placeholder="{{form.recordingTaskType === 'follow_reading' ? '例如：先听完整，再按相同语速读一遍' : recordingPlaceholder}}" value="{{form.recordingPrompt}}" data-field="recordingPrompt" bindinput="onInput"></textarea>
  </view>

  <block wx:if="{{form.recordingTaskType === 'follow_reading'}}">
    <view class="field">
      <view class="label">跟读内容</view>
      <textarea class="textarea textarea-tall" maxlength="4000" placeholder="每行填写一个单词或一句话，最多 20 条" value="{{form.followReadingContent}}" data-field="followReadingContent" bindinput="onInput"></textarea>
      <view class="hint" wx:if="{{mode === 'edit'}}">修改某条文字后，对应示范音频需要重新上传；未修改的条目继续保留。</view>
      <view class="hint" wx:else>保存课程后，在课程页为每一条内容上传老师示范录音。</view>
    </view>
    <view class="option-grid">
      <view class="option">
        <view class="label">播放方式</view>
        <picker mode="selector" range="{{followReadingModeOptions}}" range-key="label" value="{{followReadingModeIndex}}" bindchange="onFollowReadingModeChange">
          <view class="picker-value">{{followReadingModeOptions[followReadingModeIndex].label}}</view>
        </picker>
      </view>
      <view class="option">
        <view class="label">听完准备</view>
        <picker mode="selector" range="{{followReadingGapOptions}}" value="{{followReadingGapIndex}}" bindchange="onFollowReadingGapChange">
          <view class="picker-value">{{form.followReadingGapSeconds}} 秒</view>
        </picker>
      </view>
      <view class="option option-wide">
        <view class="label">每条最长录音</view>
        <picker mode="selector" range="{{followReadingResponseOptions}}" value="{{followReadingResponseIndex}}" bindchange="onFollowReadingResponseChange">
          <view class="picker-value">{{form.followReadingResponseSeconds}} 秒</view>
        </picker>
      </view>
    </view>
  </block>

  <view class="option-grid" wx:if="{{form.recordingTaskType === 'manual'}}">
    <view class="option">
      <view class="label">朗读遍数</view>
      <picker mode="selector" range="{{recordingRepeatOptions}}" value="{{recordingRepeatIndex}}" bindchange="onRecordingRepeatChange">
        <view class="picker-value">{{form.recordingRepeatCount}} 遍</view>
      </picker>
    </view>
    <view class="option">
      <view class="label">准备时间</view>
      <picker mode="selector" range="{{recordingPreparationOptions}}" value="{{recordingPreparationIndex}}" bindchange="onRecordingPreparationChange">
        <view class="picker-value">{{form.recordingPreparationSeconds}} 秒</view>
      </picker>
    </view>
  </view>

  <view class="meta" wx:if="{{form.recordingTaskType === 'ket_official'}}">建议录音约 {{selectedKetSpeakingTask.suggestedRecordingSeconds}} 秒 · 录制 1 次即可</view>
  <view class="meta" wx:if="{{form.recordingTaskType === 'ket_mock'}}">一次连续完成 · 考官录音自动播放 · 回答分段保存</view>
</block>
