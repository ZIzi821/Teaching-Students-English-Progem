.ket-trend-card {
  box-sizing: border-box;
  margin: 26rpx 0;
  padding: 26rpx;
  border: 1rpx solid var(--accent-line);
  border-radius: 24rpx;
  background: var(--surface);
}

.trend-head,
.trend-summary,
.dimension-head,
.dimension-latest {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.trend-head > view:first-child,
.dimension-label {
  min-width: 0;
  flex: 1;
}

.trend-title {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.trend-subtitle {
  margin-top: 6rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.45;
}

.trend-count {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.trend-empty {
  margin-top: 20rpx;
  padding: 26rpx 20rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.trend-empty-mark {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto 12rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--ink-3);
  font-size: 24rpx;
  font-weight: 600;
}

.trend-summary {
  margin-top: 20rpx;
  padding: 19rpx 21rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.trend-summary-label {
  color: var(--ink-2);
  font-size: 24rpx;
}

.trend-summary-score {
  margin-top: 4rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

.trend-summary-score text {
  margin-left: 4rpx;
  font-size: 24rpx;
}

.trend-change {
  flex-shrink: 0;
  text-align: right;
}

.trend-change view {
  font-size: 30rpx;
  font-weight: 600;
}

.trend-change text {
  display: block;
  margin-top: 3rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.change-up {
  color: var(--accent);
}

.change-down {
  color: var(--danger);
}

.change-steady,
.change-baseline {
  color: var(--ink-2);
}

.dimension-row {
  margin-top: 21rpx;
  padding-top: 19rpx;
  border-top: 1rpx solid var(--line);
}

.dimension-label {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.dimension-latest {
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 9rpx;
}

.dimension-latest > text {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.dimension-change {
  min-width: 50rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

.bar-grid,
.session-axis {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.bar-grid {
  height: 100rpx;
  margin-top: 13rpx;
}

.bar-column,
.session-axis-item {
  min-width: 0;
  flex: 1;
  text-align: center;
}

.bar-column {
  display: flex;
  height: 100%;
  flex-direction: column;
}

.bar-track {
  position: relative;
  overflow: hidden;
  flex: 1;
  border-radius: 12rpx 12rpx 3rpx 3rpx;
  background: var(--line);
}

.bar-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 12rpx 12rpx 3rpx 3rpx;
}

.fill-grammar {
  background: #5d9279;
}

.fill-pronunciation {
  background: #d2a15a;
}

.fill-interaction {
  background: #6688a0;
}

.fill-global {
  background: #8b74a2;
}

.bar-score {
  margin-top: 5rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.session-axis {
  margin-top: 19rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
}

.session-axis-item view {
  overflow: hidden;
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-axis-item text {
  display: block;
  margin-top: 3rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.trend-hidden-note,
.trend-notice {
  margin-top: 14rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.5;
}

.trend-notice {
  padding: 13rpx 15rpx;
  border-radius: 12rpx;
  color: var(--ink-2);
  background: var(--warn-soft);
}
