.preview-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--info-line);
  border-radius: 16rpx;
  color: var(--info);
  background: var(--info-soft);
}

.preview-dot {
  flex: 0 0 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--info);
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
}

.preview-hint {
  margin-top: 3rpx;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.45;
}
