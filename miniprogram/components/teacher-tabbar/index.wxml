<view class="teacher-tabbar" role="navigation" aria-label="教师端底部导航">
  <view class="teacher-tabbar-inner">
    <view class="tab-item {{current === 'home' ? 'tab-active' : ''}}" data-key="home" bindtap="switchTab">
      <view class="tab-symbol tab-symbol-home"><view class="home-roof"></view><view class="home-body"></view></view>
      <view class="tab-label">首页</view>
    </view>
    <view class="tab-item {{current === 'students' ? 'tab-active' : ''}}" data-key="students" bindtap="switchTab">
      <view class="tab-symbol tab-symbol-students"><view class="student-head student-head-one"></view><view class="student-head student-head-two"></view><view class="student-body"></view></view>
      <view class="tab-label">学生</view>
    </view>
    <view class="tab-item {{current === 'workbench' ? 'tab-active' : ''}}" data-key="workbench" bindtap="switchTab">
      <view class="tab-symbol tab-symbol-workbench"><view class="workbench-cell"></view><view class="workbench-cell"></view><view class="workbench-cell"></view><view class="workbench-cell"></view></view>
      <view class="tab-label">工作台</view>
    </view>
  </view>
</view>
