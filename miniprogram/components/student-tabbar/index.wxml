<view class="student-tabbar" role="navigation" aria-label="学生端底部导航">
  <view class="student-tabbar-inner">
    <view class="tab-item {{current === 'learning' ? 'tab-active' : ''}}" data-key="learning" bindtap="switchTab">
      <image class="tab-icon" src="/images/icons/tab/learning{{current === 'learning' ? '-active' : ''}}.svg" mode="aspectFit"></image>
      <view class="tab-label">学习</view>
    </view>
    <view class="tab-item {{current === 'achievements' ? 'tab-active' : ''}}" data-key="achievements" bindtap="switchTab">
      <image class="tab-icon" src="/images/icons/tab/achievements{{current === 'achievements' ? '-active' : ''}}.svg" mode="aspectFit"></image>
      <view class="tab-label">成就</view>
    </view>
    <view class="tab-item {{current === 'schedule' ? 'tab-active' : ''}}" data-key="schedule" bindtap="switchTab">
      <image class="tab-icon" src="/images/icons/tab/schedule{{current === 'schedule' ? '-active' : ''}}.svg" mode="aspectFit"></image>
      <view class="tab-label">日程</view>
    </view>
  </view>
</view>
