:host {
  display: block;
}

.student-tabbar {
  position: fixed;
  z-index: 90;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--line);
  background: var(--surface);
}

.student-tabbar-inner {
  display: flex;
  height: 104rpx;
  align-items: center;
  justify-content: space-around;
}

.tab-item {
  display: flex;
  width: 31%;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--ink-3);
}

.tab-active {
  color: var(--accent);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-label {
  margin-top: 2rpx;
  font-size: 24rpx;
  font-weight: 500;
}
