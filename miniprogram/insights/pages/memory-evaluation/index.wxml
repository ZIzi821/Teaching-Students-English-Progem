<view class="page evaluation-page">
  <view class="card state-card" wx:if="{{loading && !evaluation}}">正在对比预测与真实反馈…</view>
  <view class="card state-card" wx:elif="{{message}}">
    <view>{{message}}</view>
    <view class="retry" bindtap="loadEvaluation">重新加载</view>
  </view>

  <block wx:if="{{evaluation && student}}">
    <view class="eval-head">
      <view class="eval-kicker">{{student.name}} · 背词复习安排</view>
      <view class="eval-title-row">
        <view class="eval-title">{{evaluation.verdict.title}}</view>
        <view class="status-pill status-{{evaluation.status.tone}}">{{evaluation.status.label}}</view>
      </view>
      <view class="eval-meaning">{{evaluation.verdict.meaning}}</view>
    </view>

    <view class="card sample-card" wx:if="{{evaluation.status.key === 'collecting'}}">
      <view class="sample-line">
        <text>首轮判断还需要</text>
        <text class="sample-value">{{evaluation.sampleSize}} / {{evaluation.sampleTarget}} 次 · {{evaluation.uniqueWordCount}} / {{evaluation.uniqueWordTarget}} 词</text>
      </view>
      <view class="ui-bar"><view class="ui-bar-fill" style="width: {{evaluation.sampleProgressPercent}}%;"></view></view>
    </view>

    <view class="card compare-card" wx:if="{{evaluation.hasSample}}">
      <view class="compare-row">
        <view class="compare-label">系统预测记住</view>
        <view class="ui-bar compare-bar"><view class="ui-bar-fill compare-predicted" style="width: {{evaluation.predictedRetentionPercent}}%;"></view></view>
        <view class="compare-value">{{evaluation.predictedDisplay}}</view>
      </view>
      <view class="compare-row">
        <view class="compare-label">实际记住</view>
        <view class="ui-bar compare-bar"><view class="ui-bar-fill" style="width: {{evaluation.actualRecallPercent}}%;"></view></view>
        <view class="compare-value">{{evaluation.actualDisplay}}</view>
      </view>
      <view class="compare-recent">
        <view class="compare-recent-row" wx:for="{{evaluation.recentRows}}" wx:key="label">
          <text>{{item.label}} · {{item.sampleSize}} 次</text>
          <text>预测 {{item.predictedDisplay}} · 实际 {{item.actualDisplay}}</text>
        </view>
      </view>
    </view>

    <view class="section-title">下一步</view>
    <view class="card">
      <view class="recommendation-row" wx:for="{{evaluation.recommendations}}" wx:key="index">
        <view class="recommendation-index">{{index + 1}}</view>
        <view class="recommendation-text">{{item}}</view>
      </view>
    </view>

    <block wx:if="{{evaluation.activeBins.length}}">
      <view class="section-title">校准分组</view>
      <view class="section-hint">按系统预测的把握程度分组，看每组实际记住了多少。</view>
      <view class="card">
        <view class="bin-row" wx:for="{{evaluation.activeBins}}" wx:key="key">
          <view class="bin-head">
            <view class="bin-label">预测 {{item.label}} 的复习 · {{item.sampleSize}} 次</view>
            <view class="bin-flag" wx:if="{{item.largeGap}}">偏差大</view>
          </view>
          <view class="compare-row">
            <view class="compare-label">预测</view>
            <view class="ui-bar compare-bar"><view class="ui-bar-fill compare-predicted" style="width: {{item.predictedRetentionPercent}}%;"></view></view>
            <view class="compare-value">{{item.predictedDisplay}}</view>
          </view>
          <view class="compare-row">
            <view class="compare-label">实际</view>
            <view class="ui-bar compare-bar"><view class="ui-bar-fill" style="width: {{item.actualRecallPercent}}%;"></view></view>
            <view class="compare-value">{{item.actualDisplay}}</view>
          </view>
        </view>
      </view>
    </block>

    <view class="detail-toggle" bindtap="toggleDetails">{{showDetails ? '收起统计细节' : '查看统计细节'}}</view>

    <block wx:if="{{showDetails}}">
      <view class="card">
        <view class="detail-row"><text>Brier Score</text><text>{{evaluation.brierDisplay}}（越接近 0 越一致）</text></view>
        <view class="detail-row"><text>实际 − 预测</text><text>{{evaluation.gapDisplay}}</text></view>
        <view class="detail-row"><text>可评估反馈</text><text>{{evaluation.sampleSize}} 次 · {{evaluation.uniqueWordCount}} 个词</text></view>
        <view class="detail-row"><text>小测证据占比</text><text>{{evaluation.objectiveEvidencePercent}}%</text></view>
        <view class="detail-row"><text>算法与时间</text><text>{{evaluation.algorithmVersion}} · {{evaluation.dateRangeLabel}}</text></view>
        <view class="detail-note">{{evaluation.excludedColdStartCount}} 次首次学习用于建立初始状态，{{evaluation.excludedQualityCount}} 条其他版本记录不参与校准。</view>
      </view>

      <view class="card" wx:if="{{evaluation.sourceBreakdown.length}}">
        <view class="detail-title">按反馈来源</view>
        <view class="detail-row" wx:for="{{evaluation.sourceBreakdown}}" wx:key="key">
          <text>{{item.label}}{{item.objective ? '（小测）' : ''}}</text>
          <text>{{item.sampleSize}} 次 · 预测 {{item.predictedDisplay}} · 实际 {{item.actualDisplay}}</text>
        </view>
      </view>

      <view class="card">
        <view class="detail-title">统计口径</view>
        <view class="detail-note">{{evaluation.outcomeDefinition}}</view>
        <view class="detail-note">{{evaluation.samplingNote}}</view>
        <view class="detail-note">{{evaluation.evidenceNote}}</view>
        <view class="detail-note">{{evaluation.scoreNote}}</view>
      </view>
    </block>

    <view class="teacher-note">这些指标用于检查调度算法，参数调整由老师结合课堂表现决定。</view>
  </block>
</view>
