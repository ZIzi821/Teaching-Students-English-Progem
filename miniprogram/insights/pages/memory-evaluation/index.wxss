.evaluation-page {
  padding-bottom: 96rpx;
}

.state-card {
  color: var(--ink-2);
  text-align: center;
}

.retry {
  margin-top: 16rpx;
  color: var(--accent);
  font-weight: 500;
}

.eval-head {
  margin: 8rpx 4rpx 24rpx;
}

.eval-kicker {
  color: var(--ink-3);
  font-size: 26rpx;
}

.eval-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.eval-title {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.eval-meaning {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 30rpx;
  line-height: 1.6;
}

.status-pill {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-collecting {
  color: var(--ink-2);
  background: var(--surface-2);
}

.status-attention {
  color: var(--warn);
  background: var(--warn-soft);
}

.status-stable {
  color: var(--accent);
  background: var(--accent-soft);
}

.sample-line {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.sample-value {
  color: var(--ink);
  font-weight: 600;
}

.compare-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.compare-row:first-child {
  margin-top: 0;
}

.compare-label {
  flex: 0 0 168rpx;
  color: var(--ink-2);
  font-size: 26rpx;
}

.compare-bar {
  min-width: 0;
  flex: 1;
}

.compare-predicted {
  background: var(--info);
}

.compare-value {
  flex: 0 0 80rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  text-align: right;
}

.compare-recent {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.compare-recent-row,
.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
  color: var(--ink-2);
  font-size: 26rpx;
}

.compare-recent-row text:last-child,
.detail-row text:last-child {
  color: var(--ink);
  text-align: right;
}

.section-title {
  margin: 40rpx 4rpx 12rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.section-hint {
  margin: -4rpx 4rpx 16rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.recommendation-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0;
}

.recommendation-index {
  display: flex;
  flex: 0 0 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.recommendation-text {
  min-width: 0;
  flex: 1;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
}

.bin-row {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.bin-row:first-child {
  padding-top: 0;
  border-top: 0;
}

.bin-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.bin-label {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 500;
}

.bin-flag {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 24rpx;
}

.detail-toggle {
  margin: 32rpx 0 24rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
}

.detail-title {
  margin-bottom: 8rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
}

.detail-note {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  line-height: 1.6;
}

.teacher-note {
  margin: 24rpx 4rpx 0;
  color: var(--ink-3);
  font-size: 24rpx;
  text-align: center;
}
