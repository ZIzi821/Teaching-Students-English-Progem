.radar-page {
  padding-bottom: 56rpx;
}

.state-card {
  color: var(--ink-2);
  font-size: 28rpx;
  line-height: 1.6;
}

.state-card.error {
  color: var(--warn);
  background: var(--warn-soft);
}

.retry {
  display: inline-flex;
  margin-top: 14rpx;
  color: var(--accent);
  font-weight: 600;
}

.stage-hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  color: var(--on-fill);
  background: var(--accent);
}

.stage-kicker {
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  font-weight: 600;
}

.stage-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.stage-goal {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  line-height: 1.65;
}

.stage-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.stage-chip {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
}

.stage-picker {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--surface);
  font-size: 24rpx;
  font-weight: 600;
}

.stage-picker text {
  margin-left: 10rpx;
}

.section-head,
.prep-head,
.dimension-head,
.dimension-foot,
.mix-row,
.skill-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 600;
}

.section-subtitle {
  margin-top: 7rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.coverage-badge,
.prep-duration {
  display: flex;
  min-width: 76rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.evidence-note,
.teacher-gate {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.dimension-list {
  margin-top: 8rpx;
}

.dimension-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.dimension-row:last-child {
  border-bottom: 0;
}

.dimension-name {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}

.dimension-description {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.state-pill {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.state-stable { color: var(--accent); background: var(--accent-soft); }
.state-basic { color: var(--info); background: var(--info-soft); }
.state-consolidating { color: var(--warn); background: var(--warn-soft); }
.state-priority { color: var(--danger); background: var(--danger-soft); }
.state-insufficient,
.state-unassessed,
.state-inactive { color: var(--ink-2); background: var(--line); }

.radar-bar,
.skill-bar {
  height: 14rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--line);
}

.radar-fill,
.skill-fill {
  height: 100%;
  border-radius: 999rpx;
}

.fill-stable { background: var(--accent); }
.fill-basic { background: var(--info); }
.fill-consolidating { background: var(--warn-fill); }
.fill-priority { background: var(--danger); }
.fill-insufficient,
.fill-unassessed,
.fill-inactive { background: var(--line); }

.unassessed-line {
  margin-top: 13rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.dimension-foot {
  margin-top: 9rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.priority-list {
  margin-top: 8rpx;
}

.priority-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.priority-rank {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  color: var(--on-fill);
  background: var(--warn-fill);
  font-size: 22rpx;
  font-weight: 600;
}

.priority-copy {
  min-width: 0;
  flex: 1;
}

.priority-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.priority-meta,
.priority-reason {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

.priority-score {
  flex-shrink: 0;
  color: var(--warn);
  font-size: 24rpx;
  font-weight: 600;
}

.observation-block {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--surface-2);
}

.observation-title,
.mix-title {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
}

.observation-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.45;
}

.observation-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--info);
}

.observation-reason {
  margin-top: 3rpx;
  color: var(--ink-3);
  font-size: 22rpx;
}

.prep-card {
  border-color: var(--warn-line);
  background: var(--surface);
}

.prep-title {
  margin-top: 22rpx;
  color: var(--warn);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.prep-reason {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.content-rule,
.evidence-prompt {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid var(--warn-fill);
  border-radius: 12rpx 16rpx 16rpx 12rpx;
  color: var(--ink-2);
  background: var(--warn-soft);
  font-size: 22rpx;
  line-height: 1.55;
}

.mix-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.75);
}

.mix-row {
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.mix-value {
  color: var(--warn);
  font-weight: 600;
}

.mix-value.mix-complete {
  color: var(--accent);
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 64rpx 22rpx minmax(0, 1fr);
  gap: 12rpx;
  min-height: 96rpx;
}

.timeline-minute {
  padding-top: 1rpx;
  color: var(--warn);
  font-size: 22rpx;
  font-weight: 600;
  text-align: right;
}

.timeline-line-wrap {
  position: relative;
}

.timeline-dot {
  position: relative;
  z-index: 2;
  width: 18rpx;
  height: 18rpx;
  margin: 4rpx auto 0;
  border: 4rpx solid var(--warn-line);
  border-radius: 50%;
  background: var(--warn-fill);
}

.timeline-line {
  position: absolute;
  top: 24rpx;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  background: var(--warn-soft);
  transform: translateX(-50%);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-detail {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.readiness-status {
  margin-top: 14rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.criteria-list {
  margin-top: 14rpx;
}

.criteria-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.criteria-icon {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: var(--ink-3);
  background: var(--line);
  font-size: 22rpx;
  font-weight: 600;
}

.criteria-icon.criteria-pass {
  color: var(--on-fill);
  background: var(--accent);
}

.advance-btn {
  margin-top: 20rpx;
}

.skill-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.skill-row:last-child {
  border-bottom: 0;
}

.skill-main {
  min-width: 0;
  flex: 1;
}

.skill-title-row {
  justify-content: flex-start;
}

.skill-title {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.core-badge {
  flex-shrink: 0;
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  color: var(--warn);
  background: var(--warn-soft);
  font-size: 22rpx;
  font-weight: 600;
}

.skill-meta,
.skill-evidence {
  margin-top: 7rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  line-height: 1.45;
}

.skill-bar {
  height: 10rpx;
  margin-top: 11rpx;
}

.pin-button {
  display: flex;
  min-width: 94rpx;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--ink-2);
  background: var(--surface);
  font-size: 22rpx;
  font-weight: 600;
}

.pin-button.pin-active {
  border-color: var(--accent);
  color: var(--accent);
  background: var(--accent-soft);
}
