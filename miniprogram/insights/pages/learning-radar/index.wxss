.radar-page {
  padding-bottom: 56rpx;
}

.state-card {
  color: #5f574f;
  font-size: 27rpx;
  line-height: 1.6;
}

.state-card.error {
  color: #8a6730;
  background: #fff4d8;
}

.retry {
  display: inline-flex;
  margin-top: 14rpx;
  color: #39765d;
  font-weight: 700;
}

.stage-hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 28rpx;
  color: #fff;
  background: linear-gradient(145deg, #315f4d 0%, #4f8f73 72%, #6ba083 100%);
  box-shadow: 0 14rpx 36rpx rgba(52, 96, 77, 0.18);
}

.stage-kicker {
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.stage-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
}

.stage-goal {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 25rpx;
  line-height: 1.65;
}

.stage-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.stage-chip {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.1);
  font-size: 21rpx;
}

.stage-picker {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  border-radius: 16rpx;
  color: #315f4d;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.stage-picker text {
  margin-left: 10rpx;
}

.section-head,
.prep-head,
.dimension-head,
.dimension-foot,
.mix-row,
.skill-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #2f2a24;
  font-size: 31rpx;
  font-weight: 800;
}

.section-subtitle {
  margin-top: 7rpx;
  color: #786f65;
  font-size: 22rpx;
  line-height: 1.5;
}

.coverage-badge,
.prep-duration {
  display: flex;
  min-width: 76rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #39765d;
  background: #e7f2ec;
  font-size: 24rpx;
  font-weight: 800;
}

.evidence-note,
.teacher-gate {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #655e56;
  background: #f4f0e8;
  font-size: 22rpx;
  line-height: 1.55;
}

.dimension-list {
  margin-top: 8rpx;
}

.dimension-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee8df;
}

.dimension-row:last-child {
  border-bottom: 0;
}

.dimension-name {
  color: #3b352f;
  font-size: 26rpx;
  font-weight: 800;
}

.dimension-description {
  margin-top: 8rpx;
  color: #82786d;
  font-size: 21rpx;
  line-height: 1.5;
}

.state-pill {
  flex-shrink: 0;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.state-stable { color: #326d56; background: #e5f2eb; }
.state-basic { color: #536882; background: #e9eef4; }
.state-consolidating { color: #86632e; background: #f8edcf; }
.state-priority { color: #955a42; background: #f7e4dc; }
.state-insufficient,
.state-unassessed,
.state-inactive { color: #726b64; background: #efede9; }

.radar-bar,
.skill-bar {
  height: 14rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #ece8e1;
}

.radar-fill,
.skill-fill {
  height: 100%;
  border-radius: 999rpx;
}

.fill-stable { background: #4f8f73; }
.fill-basic { background: #7b8eaa; }
.fill-consolidating { background: #e0b96a; }
.fill-priority { background: #c98262; }
.fill-insufficient,
.fill-unassessed,
.fill-inactive { background: #aaa39a; }

.unassessed-line {
  margin-top: 13rpx;
  color: #90877e;
  font-size: 21rpx;
}

.dimension-foot {
  margin-top: 9rpx;
  color: #7c7369;
  font-size: 20rpx;
}

.priority-list {
  margin-top: 8rpx;
}

.priority-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee8df;
}

.priority-rank {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #c79045;
  font-size: 21rpx;
  font-weight: 800;
}

.priority-copy {
  min-width: 0;
  flex: 1;
}

.priority-title {
  color: #3c352e;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
}

.priority-meta,
.priority-reason {
  margin-top: 6rpx;
  color: #80766b;
  font-size: 21rpx;
  line-height: 1.45;
}

.priority-score {
  flex-shrink: 0;
  color: #9b6d2f;
  font-size: 24rpx;
  font-weight: 800;
}

.observation-block {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f3f0eb;
}

.observation-title,
.mix-title {
  color: #5f574f;
  font-size: 23rpx;
  font-weight: 800;
}

.observation-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 14rpx;
  color: #4b443d;
  font-size: 23rpx;
  line-height: 1.45;
}

.observation-dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #7b8eaa;
}

.observation-reason {
  margin-top: 3rpx;
  color: #82796f;
  font-size: 20rpx;
}

.prep-card {
  border-color: #e6d8b3;
  background: linear-gradient(145deg, #fffdfa 0%, #fff8e8 100%);
}

.prep-title {
  margin-top: 22rpx;
  color: #624b27;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.45;
}

.prep-reason {
  margin-top: 10rpx;
  color: #79694f;
  font-size: 22rpx;
  line-height: 1.55;
}

.content-rule,
.evidence-prompt {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid #e0b96a;
  border-radius: 8rpx 14rpx 14rpx 8rpx;
  color: #665538;
  background: #f8edcf;
  font-size: 22rpx;
  line-height: 1.55;
}

.mix-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.75);
}

.mix-row {
  margin-top: 10rpx;
  color: #6d645a;
  font-size: 21rpx;
}

.mix-value {
  color: #9b6d2f;
  font-weight: 800;
}

.mix-value.mix-complete {
  color: #4f8f73;
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: grid;
  grid-template-columns: 64rpx 22rpx minmax(0, 1fr);
  gap: 12rpx;
  min-height: 96rpx;
}

.timeline-minute {
  padding-top: 1rpx;
  color: #9b6d2f;
  font-size: 23rpx;
  font-weight: 800;
  text-align: right;
}

.timeline-line-wrap {
  position: relative;
}

.timeline-dot {
  position: relative;
  z-index: 2;
  width: 18rpx;
  height: 18rpx;
  margin: 4rpx auto 0;
  border: 4rpx solid #fff8e8;
  border-radius: 50%;
  background: #c79045;
}

.timeline-line {
  position: absolute;
  top: 24rpx;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  background: #e5d3a8;
  transform: translateX(-50%);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-title {
  color: #493e31;
  font-size: 24rpx;
  font-weight: 800;
}

.timeline-detail {
  margin-top: 6rpx;
  color: #7f715f;
  font-size: 21rpx;
  line-height: 1.5;
}

.readiness-status {
  margin-top: 14rpx;
  color: #4f6f63;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.criteria-list {
  margin-top: 14rpx;
}

.criteria-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
  color: #655e56;
  font-size: 22rpx;
  line-height: 1.5;
}

.criteria-icon {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: #837b72;
  background: #ebe8e2;
  font-size: 20rpx;
  font-weight: 800;
}

.criteria-icon.criteria-pass {
  color: #fff;
  background: #4f8f73;
}

.advance-btn {
  margin-top: 20rpx;
}

.skill-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee8df;
}

.skill-row:last-child {
  border-bottom: 0;
}

.skill-main {
  min-width: 0;
  flex: 1;
}

.skill-title-row {
  justify-content: flex-start;
}

.skill-title {
  color: #3b352f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.core-badge {
  flex-shrink: 0;
  padding: 4rpx 9rpx;
  border-radius: 999rpx;
  color: #8a6730;
  background: #fff0cc;
  font-size: 18rpx;
  font-weight: 700;
}

.skill-meta,
.skill-evidence {
  margin-top: 7rpx;
  color: #82796f;
  font-size: 20rpx;
  line-height: 1.45;
}

.skill-bar {
  height: 10rpx;
  margin-top: 11rpx;
}

.pin-button {
  display: flex;
  min-width: 94rpx;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid #d8d1c7;
  border-radius: 999rpx;
  color: #71695f;
  background: #fff;
  font-size: 21rpx;
  font-weight: 700;
}

.pin-button.pin-active {
  border-color: #4f8f73;
  color: #39765d;
  background: #e9f4ee;
}
