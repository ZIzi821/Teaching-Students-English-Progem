<view class="page radar-page">
  <view class="card state-card" wx:if="{{loading && !radar}}">正在读取学习计划…</view>
  <view class="card state-card" wx:elif="{{message}}">
    <view>{{message}}</view>
    <view class="retry" bindtap="loadRadar">重新加载</view>
  </view>
  <learning-plan wx:if="{{radar}}" radar="{{radar}}" student-id="{{studentId}}" bindupdated="loadRadar"></learning-plan>
</view>
