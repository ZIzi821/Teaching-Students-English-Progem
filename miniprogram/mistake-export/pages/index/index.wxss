page {
  min-height: 100%;
  background: var(--surface-2);
  color: var(--accent);
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx 64rpx;
}

.hero-card,
.card,
.state-card,
.empty-history {
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  background: var(--surface);
}

.state-card,
.empty-history {
  padding: 36rpx 28rpx;
  color: var(--ink-2);
  text-align: center;
}

.error-card {
  color: var(--danger);
}

.retry {
  margin-top: 16rpx;
  color: var(--accent);
  font-weight: 600;
}

.hero-card {
  padding: 30rpx;
  border-color: var(--accent-line);
  background: var(--accent-soft);
}

.eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 600;
}

.hero-copy {
  margin-top: 14rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.7;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-stats view {
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
}

.hero-stats text,
.hero-stats label {
  display: block;
}

.hero-stats text {
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
}

.hero-stats label {
  margin-top: 3rpx;
  color: var(--ink-3);
  font-size: 24rpx;
}

.card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.section-title,
.history-title {
  font-size: 30rpx;
  font-weight: 600;
}

.second-title {
  margin-top: 30rpx;
}

.picker-value,
.lesson-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 82rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 16rpx;
  background: var(--surface-2);
  color: var(--accent);
  font-size: 26rpx;
  line-height: 1.45;
}

.picker-value text {
  color: var(--ink-3);
}

.range-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.field-label {
  color: var(--ink-2);
  font-size: 24rpx;
  font-weight: 600;
}

.lesson-picker {
  display: block;
  min-height: 94rpx;
}

.policy-hint,
.download-hint,
.empty-lessons,
.history-policy,
.generating-note {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-lessons {
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--warn-soft);
  color: var(--warn);
}

.estimate-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: var(--accent-soft);
}

.estimate-label {
  color: var(--ink-2);
  font-size: 24rpx;
}

.estimate-value {
  margin-top: 4rpx;
  color: var(--accent);
  font-size: 34rpx;
  font-weight: 600;
}

.estimate-lessons {
  color: var(--accent);
  font-size: 24rpx;
  text-align: right;
}

.primary-btn,
.open-btn {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: var(--accent);
  color: var(--on-fill);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.disabled {
  opacity: 0.45;
}

.history-title {
  margin: 34rpx 4rpx 8rpx;
}

.history-card {
  padding: 24rpx;
}

.history-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.history-date {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.history-range {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.status {
  flex: none;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-ready {
  color: var(--accent);
  background: var(--accent-soft);
}

.status-generating {
  color: var(--warn);
  background: var(--warn-soft);
}

.status-failed {
  color: var(--danger);
  background: var(--danger-soft);
}

.history-meta {
  margin-top: 18rpx;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}

.failure {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.55;
}

.open-btn {
  padding: 17rpx;
  font-size: 26rpx;
}

.history-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.share-btn {
  padding: 17rpx;
  border: 1rpx solid var(--accent);
  border-radius: 16rpx;
  color: var(--accent);
  background: var(--accent-soft);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}
