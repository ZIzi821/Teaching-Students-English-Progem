.exam-page { min-height: 100vh; background: var(--accent-soft), var(--surface-2); }
.exam-hero { margin: 12rpx 6rpx 18rpx; }
.eyebrow, .part-label, .card-kicker { color: var(--accent); font-size: 22rpx; font-weight: 600;  }
.hero-title { margin-top: 8rpx; color: var(--accent); font-size: 52rpx; font-weight: 600; }
.hero-subtitle { margin-top: 8rpx; color: var(--ink-2); font-size: 24rpx; }
.source-badge { display: inline-block; margin: 0 6rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--warn); background: var(--line); font-size: 22rpx; font-weight: 600; }
.source-note { margin: 10rpx 6rpx 24rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.5; }
.instruction-card { padding: 30rpx; }
.instruction-title, .readiness-title { margin-top: 7rpx; color: var(--ink); font-size: 32rpx; font-weight: 600; }
.rule-row { display: flex; gap: 15rpx; margin-top: 20rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.6; }
.rule-row text { display: flex; width: 40rpx; height: 40rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--accent); font-size: 22rpx; font-weight: 600; }
.readiness-card { background: var(--warn-soft); }
.check-row { margin-top: 15rpx; color: var(--ink-2); font-size: 22rpx; }
.audio-preload-state { margin-top: 22rpx; padding: 14rpx 16rpx; border-radius: 12rpx; color: var(--ink-2); background: var(--line); font-size: 22rpx; line-height: 1.5; }
.preload-ready { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
.preload-failed { color: var(--danger); background: var(--danger-soft); }
.start-btn { margin-top: 28rpx; }
.center-card, .error-card, .success-card { margin-top: 80rpx; padding: 38rpx 30rpx; text-align: center; }
.loading-ring { width: 72rpx; height: 72rpx; margin: 8rpx auto 25rpx; border: 8rpx solid var(--accent-line); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
.small-ring { width: 52rpx; height: 52rpx; border-width: 6rpx; }
.state-title, .live-title { color: var(--accent); font-size: 32rpx; font-weight: 600; }
.state-copy, .live-copy, .remaining, .score-notice { margin-top: 12rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.6; }
.preload-track { height: 12rpx; margin: 24rpx 20rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; }
.preload-fill { height: 100%; background: var(--accent); }
.error-mark, .success-mark, .transition-mark { display: flex; width: 100rpx; height: 100rpx; margin: 8rpx auto 24rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--on-fill); background: var(--danger); font-size: 52rpx; font-weight: 600; }
.success-mark, .transition-mark { background: var(--accent); }
.error-btn { margin-top: 28rpx; }
.back-link { margin-top: 24rpx; color: var(--accent); font-size: 22rpx; font-weight: 600; }
.late-pill { display: inline-block; margin-top: 18rpx; padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--danger); background: var(--danger-soft); font-size: 22rpx; font-weight: 600; }
.score-notice { margin: 22rpx 4rpx 0; padding: 16rpx; border-radius: 12rpx; background: var(--line); }

.exam-status-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin: 8rpx 4rpx 14rpx; }
.stage-title { margin-top: 8rpx; color: var(--accent); font-size: 32rpx; font-weight: 600; }
.cue-count { flex-shrink: 0; padding: 8rpx 13rpx; border-radius: 999rpx; color: var(--accent); background: var(--accent-soft); font-size: 22rpx; font-weight: 600; }
.exam-progress { height: 10rpx; margin-bottom: 22rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; }
.exam-progress-fill { height: 100%; background: var(--accent); transition: width .25s ease; }
.visual-card { padding: 22rpx; border-color: var(--line-strong); background: var(--warn-soft); }
.visual-title { color: var(--ink); font-size: 28rpx; font-weight: 600; text-align: center; }
.visual-image { display: block; width: 100%; margin-top: 14rpx; border-radius: 12rpx; background: var(--line); }
.visual-question { margin-top: 14rpx; color: var(--ink-2); font-size: 22rpx; line-height: 1.5; text-align: center; }
.option-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: 13rpx; }
.option-row text { padding: 6rpx 10rpx; border-radius: 999rpx; color: var(--ink-2); background: var(--line); font-size: 22rpx; }
.live-card { min-height: 430rpx; padding: 38rpx 30rpx; text-align: center; }
.speaker-rings { display: flex; width: 124rpx; height: 124rpx; margin: 18rpx auto 28rpx; align-items: center; justify-content: center; border-radius: 50%; color: var(--ink); background: var(--accent-soft); animation: pulse 1.25s ease-out infinite; }
.speaker-core { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--accent); font-size: 32rpx; }
.microphone-rings .speaker-core { background: var(--danger); }
.recording-dot { width: 58rpx; height: 58rpx; margin: 12rpx auto 22rpx; border-radius: 50%; background: var(--danger);  animation: breathe 1s ease-in-out infinite; }
.recording-title { color: var(--danger); }
.timer { margin-top: 10rpx; color: var(--danger); font-size: 62rpx; font-weight: 600;  }
.finish-btn { display: flex; min-height: 82rpx; margin-top: 30rpx; align-items: center; justify-content: center; border-radius: 16rpx; color: var(--on-fill); background: var(--danger); font-size: 28rpx; font-weight: 600; }
.transition-mark { width: 88rpx; height: 88rpx; font-size: 40rpx; }
.response-count { color: var(--ink-2); font-size: 22rpx; font-weight: 600; text-align: center; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { 0% {  } 100% {  } }
@keyframes breathe { 0%,100% { transform: scale(.92); } 50% { transform: scale(1.08); } }
